using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {
    decimal debit;
    decimal credit;
    
    private void Data1_BeforePrint(object sender, EventArgs e)
    {
      if ((decimal)Report.GetColumnValue(&quot;GLRepSOMaturitySchedule.SODAmount&quot;) &gt; 0){
        debit = (decimal)Report.GetColumnValue(&quot;GLRepSOMaturitySchedule.SODAmount&quot;);
        credit = 0;
      }  
      else{
        credit = (decimal)Report.GetColumnValue(&quot;GLRepSOMaturitySchedule.SODAmount&quot;) * -1;
        debit = 0;
      }  
    }
  }
}
</ScriptText>
