    <Total Name="sumdisbamtgrp" Expression="[RptFTNewBooking.DisbAmt]" Evaluator="Data1" PrintOn="GroupFooter1"/>
    <Total Name="jmlKontrak" TotalType="Count" Evaluator="Data1" PrintOn="DataFooter1"/>
