@model Transaction.Employee.CashierH
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Cashier";
}
<style>

    html, body {
        margin: 0;
        padding: 0;
    }

    /* LAYOUT */
   .pos-container {
        display: grid;
        grid-template-columns: 3fr 1.4fr;
        height: 90vh;
        gap: 12px;
    }

   

    /* LEFT PANEL */
    .left-panel {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: #fcf3dc;
        border-radius: 10px;
        overflow: hidden; /* 🔥 penting */
    }


    /* HEADER */
    .header {
        background: linear-gradient( 135deg, var(--bs-primary), var(--bs-primary-dark, #0a58ca) );
        color: #fff;
        padding: 8px 16px;
        border-radius: 10px 10px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header small {
        opacity: 0.85;
        font-weight: normal;
    }

    /* TOOLBAR */
    .toolbar {
        display: flex;
        justify-content: space-between;
        margin: 12px 0;
        padding: 0 8px;
    }
    .header {
        flex: 0 0 auto;
    }

    .toolbar {
        flex: 0 0 auto;
        margin: 12px 0;
        padding: 0 8px;
    }


    /* PRODUCT GRID */
    .product-grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(2, 1fr); /* default: bawah md */
    gap: 12px;

    overflow-y: auto;
    padding: 8px;
    align-content: start;
    }

    /* md (≥768px) → 3 kolom */
    @@media (min-width: 768px) {
        .product-grid {
            grid-template-columns: repeat(3, 1fr);
        }
        .action-btn {
            padding: 4px 8px;
            font-size: 11px;
        }

        .action-btn .btn-text {
            display: none; /* sembunyikan text */
        }

        .action-btn i {
            font-size: 16px;
        }
    }

    /* lg (≥992px) → 4 kolom */
    @@media (min-width: 992px) {
        .product-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }


    /* PRODUCT CARD */
    .product {
        background: #fff;
        box-shadow: 0 1px 2px rgba(0,0,0,.06),
                    0 4px 12px rgba(0,0,0,.08);
        cursor: pointer;
        display: flex;
        flex-direction: column;
    }


    .product:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 18px rgba(0,0,0,0.12);
    }

    .product .img {
        position: relative;
        height: 120px;          /* 🔥 KUNCI */
        background: #f1f3f5;
        overflow: hidden;
    }

    .product .img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .product .img.no-image {
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #e9ecef, #f8f9fa);
    }

    .no-image-text {
        font-size: 14px;
        font-weight: 600;
        color: #adb5bd;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .product .price {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(0,0,0,0.75);
        color: #fff;
        font-weight: 600;
        text-align: center;
        padding: 6px 0;
        font-size: 13px;
    }

    .product .name {
        padding: 6px;
        text-align: center;
        font-size: 13px;
        font-weight: 600;
    }

    /* RIGHT PANEL */
    .right-panel {
        background: #ffffff;
        border-radius: 10px;
        border:1px solid grey;
        padding: 8px;
        display: flex ;
        flex-direction: column;
        height: 100%;
    }

    /* TRANSACTION HEADER */
    .trans-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 600;
        margin-bottom: 10px;
    }



     /* MOBILE */
    @@media (max-width: 767.98px) {
        .pos-container {
            grid-template-columns: 1fr;
        }
         .toolbar .col-sm-8,
        .toolbar .col-sm-4 {
            flex: 0 0 100%;
            max-width: 100%;
        }

        .toolbar label {
            display: none; /* opsional biar lebih clean */
        }

        .select2-container {
            width: 100% !important;
        }
        .payment-btn {
            position: absolute;
            bottom: 0;
            left: 0;

        }
        }

.type-option {
    position: relative;
    color:black;
    width: 130px;
    height: 50px;
    border: 2px solid #ccc;
    border-radius: 10px;
    font-weight: 500;
    cursor: pointer;
    background-color: #f8f9fa;
    transition: all 0.2s;
    user-select: none;
}

/* sembunyikan radio */
.type-option input {
    display: none;
}

/* span isi penuh */
.type-option span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 8px;
}

/* SAAT DIPILIH */
.type-option input:checked + span {
    background-color: #0d6efd;
    color: white;
}

/* hover */
.type-option:hover {
    border-color: #0d6efd;
}

/* ===== Qty ===== */
.qty-wrapper {
    display: flex;
    align-items: center;
    border: 2px solid #ccc;
    border-radius: 10px;
    overflow: hidden;
}

.qty-btn {
    width: 40px;
    height: 40px;
    border: none;
    background-color: #f8f9fa;
    font-size: 20px;
    font-weight: bold;
    cursor: pointer;
}

.qty-btn:hover {
    background-color: #e9ecef;
}

.qty-input {
    width: 60px;
    height: 40px;
    text-align: center;
    border: none;
    outline: none;
    font-weight: 500;
}

/* ===== Diskon ===== */
.discount-wrapper {
    display: flex;
    align-items: center;
    border: 2px solid #ccc;
    border-radius: 10px;
    height: 40px;
    padding: 0 10px;
}

.discount-prefix {
    font-weight: 500;
    margin-right: 5px;
}

.discount-input {
    width: 120px;
    border: none;
    outline: none;
}

/* hilangkan spinner number */
.qty-input::-webkit-inner-spin-button,
.qty-input::-webkit-outer-spin-button,
.discount-input::-webkit-inner-spin-button,
.discount-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
}

/* INI BAGIAN BILL*/
/* HEADER & ITEM PAKAI GRID YANG SAMA */
.bill-header,
.bill-item {
    display: grid;
    grid-template-columns: 40px 1fr 100px 20px;
    align-items: center;
}

/* HEADER */
.bill-header {
    font-weight: 600;
    color: #6b7280;
    border-bottom: 1px solid #e5e7eb;
    padding: 6px 0;
}

/* ITEM */
.bill-item {
    padding: 8px 0;
    border-bottom: 1px dashed #e5e7eb;
}

.qty {
    font-weight: 600;
}

.name {
    color: #374151;
    cursor: pointer;
}

/* PRICE SEJAJAR */
.billprice {
    text-align: right;
    font-weight: 500;
    white-space: nowrap;
}

/* DELETE BUTTON → X KECIL TANPA BACKGROUND */
.btn-delete {
    border: none;
    background: none;
    color: #ef4444;
    font-size: 16px;
    cursor: pointer;
    padding: 0;
}

.btn-delete:hover {
    color: #b91c1c;
}

/* VARIANT */
.bill-variant {
    font-size: 12px;
    color: #6b7280;
    margin-left: 40px;
    padding: 2px 0;
}

/* SUMMARY */
.summary {
    margin-top: 10px;
    border-top: 2px solid #e5e7eb;
    padding-top: 8px;
}

.total-row {
    display: flex;
    justify-content: space-between;
    padding: 4px 0;
}

.total-row.bold {
    font-size: 16px;
    font-weight: 700;
}

.branch-name {
    font-size: clamp(14px, 2vw, 22px);
    font-weight: bold;
}
.TransDate-LeftPanel{
    font-size: clamp(12px, 2vw, 18px);
}
/* default (md ke atas) */
.action-btn {
    padding: 6px 12px;
    font-size: 13px;
}


</style>

