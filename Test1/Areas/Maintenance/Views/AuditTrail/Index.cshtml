                                        </div>
                                    </div>
                                </div>
                            </div>
                            <label for="flatpickr-range">Date</label>
                        </div>
                   
                        <div class="form-floating form-floating-outline mb-3">
                            @Html.DropDownList("TableName", ViewData["TableList"] as SelectList, "Select Data", new { @class = "form-select select2DDList", @required = "required", @id = "cboTableList" })
                        </div>
                        <div class="form-floating form-floating-outline mb-3">
                            @Html.DropDownList("User", ViewData["UserList"] as SelectList, "Select User", new { @class = "form-select select2DDList", @required = "required", @id = "cboUserList" })
                        </div>
                        <div class="text-center mt-3">
                            <button id="btnFilter" class="btn btn-sm btn-outline-primary">Filter</button>
                        </div>
                    </div>

                </div>



                @* <div class="modal-footer">
                    <button type="button" class="btn btn-default" id="btnClose" data-dismiss="modal">Close</button>
                </div> *@
            </div>
        </div>
    </div>
</div>


<div id="PartialSection">
</div>

@section Scripts {
    <script src="~/assets/vendor/libs/flatpickr/flatpickr.js"></script>
    <script src="~/assets/vendor/libs/moment/moment.js"></script>
    <script src="~/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>

    <script type="text/javascript">
        $('.select2DDList').select2({
            dropdownParent: $('#CreateEditForms')
        });

        $(document).ready(function () {
            flatpickr("#date", {
                mode: "range",
                dateFormat: "Y-m-d",
                allowInput: true,
                appendTo: document.body,
                onClose: (s, d, i) => i.input.blur()
            });
            RefreshUserGroup();

            $(".open-modal-export").click(function () {
                 $("#modalTitle").html("Filter");
                 $('#date').val('');
                $("#CreateEditForms").modal('show');
            })
        });
        function RefreshUserGroup() {
             $('#tableData').DataTable({
                "bDestroy": true,
                "columnDefs": [
                    {
                        "targets": 'no-sort',
                        "orderable": false,
                    },

                    {
                        "width": "60px",
                        "orderable": true,
                        "targets": [0]
                    },
                    {
                        "width": "120px",
                        "orderable": true,
                        "targets": [1]
                    },
                    {
                        "width": "120px",
                        "orderable": true,
                        "targets": [2]
                    },
                    {
                        "width": "110px",
                        "orderable": true,
                        "targets": [3]
                    },
                    {
                        "width": "150px",
                        "orderable": true,
                        "targets": [4]
                    },
                    {
                         "width": "180px",
                         "orderable": false,
                         "targets":[5]
                    },
                     {
                         "width": "100px",
                         "orderable": false,
                         "targets":[6]
                    },
                  

                ],
                "select": {
                    "style": 'os'
                },
                "language":
                {
                    "search": "",
                    "searchPlaceholder": "Search...",
                    "emptyTable": "No record found.",
                    "processing": "<div class='overlay custom-loader-background' style='background: transparent !important;'><i class='fa fa-spinner fa-spin custom-loader-color' style='font-size:30px;color:#2196F3'></i></div>"
                },
                "processing": "true",
                "order": [[1, "asc"]],
                 layout: {
                   topStart: {
                    rowClass: 'row m-2 my-0 mt-0 justify-content-between',
                    features: [
                        {
                            buttons: [
                                {
                                    className: 'btn btn-outline-secondary dropdown-toggle waves-effect open-modal-export',
                                    text: '<span class="d-flex align-items-center gap-2"><i class="icon-base ri ri-upload-2-line icon-16px me-sm-1"></i> <span class="d-none d-sm-inline-block">Filter</span></span>',
                                }
                            ]
                        }
                    ]
                },
                    topEnd: {
                        features: [
                            {
                                search: {
                                    placeholder: 'Search...',
                                    text: '_INPUT_'
                                }
                            },
                           
                        ]
                    },
                    bottomStart: {
                        rowClass: 'row mx-3 justify-content-between',
                        features: ['info']
                    },
                    bottomEnd: 'paging'
                },
                language: {
                    paginate: {
                        next: '<i class="icon-base ri ri-arrow-right-s-line scaleX-n1-rtl icon-22px"></i>',
                        previous: '<i class="icon-base ri ri-arrow-left-s-line scaleX-n1-rtl icon-22px"></i>',
                        first: '<i class="icon-base ri ri-skip-back-mini-line scaleX-n1-rtl icon-22px"></i>',
                        last: '<i class="icon-base ri ri-skip-forward-mini-line scaleX-n1-rtl icon-22px"></i>'
                    }
                },
                "serverSide": "true",
                "lengthMenu": [[1, 10, 20, 50, 100, 1000, -1], [1, 10, 20, 50, 100, 1000, "All"]],
                "pageLength": 10,
                "ajax":
                {
                    "url": '@Url.Action("GetData", "AuditTrail", new { Area = "Maintenance" })',
                    "type": "POST",
                    "dataType": "JSON",
                        "dataSrc": function (json) {
            console.log(json); // Check what structure you're getting
            return json.data;
        }
                },
                "columns": [
                    { "data": "ID", "name": "ID" },
                    { "data": "UserId", "name": "UserId" },
                    { "data": "TableName", "name": "TableName" },
                   {
                        "data": "Status", "name": "Status",
                        "render": function (data, type, row, meta) {
                            switch (row.Status) {
                                case "INSERT":
                                    return "<span class=\"badge rounded-pill bg-label-success\">Create</span>";
                                    break;
                                case "UPDATE":
                                    return "<span class=\"badge rounded-pill bg-label-secondary\">Update</span>";
                                    break;

                                case "DELETE":
                                    return "<span class=\"badge rounded-pill bg-label-danger\">Delete</span>";
                                    break;

                                
                                default:
                                    return row.FactStatus;
                            }
                        }
                    },
                    { "data": "Key", "name": "Key" },
                 
                    {
                        "data": "UpdatedDate", "name": "UpdatedDate",
                        "render": function (data, type, row, meta) {
                            return moment(row.UpdatedDate).format('DD/MMM/YYYY HH:mm:ss');
                        }
                    },
                    {
                        "data": "ID", "name": "ID",
                        "render": function (data, type, row, meta) {
                            return `<div class="d-flex align-items-center">

                        <a href="javascript:ViewLog('${row.ID}');"  class="btn btn-icon btn-text-secondary rounded-pill">
                          <i class="icon-base ri ri-eye-line icon-md"></i>
                        </a>
                       
                      </div>`;
                        }
                    },

                ]
            });
        }
        $("#btnFilter").click(function() {
            const range = $("#date").val(); // contoh: "2025-10-01 to 2025-10-22"
            let from = "";
            let to = "";

            if (range.includes(" to ")) {
                const parts = range.split(" to ");
                from = parts[0].trim();
                to = parts[1].trim();
            }
            let data = "";
            let user = "";
            user = $('#cboUserList').val();
            data = $('#cboTableList').val();
            // Kirim via querystring atau AJAX ke controller
                 const url = '@Url.Action("Filter", "AuditTrail")'
            + `?from=${from}&to=${to}&data=${data}&user=${user}`;
                        window.open(url, "_blank");

        });

      
        function ViewLog(data) {

        if (data == "")
        {
            alert("Data did not have log!");
            return false;
        }
        else
        {

            $.ajax({
            type: "GET",
            url: '@Url.Action("LogDetail", "AuditTrail", new { Area = "Maintenance" })',
            data: {
                key: data,
            },
            dataType: 'html',
            success: function (result) {
                $('#PartialSection').empty();
                $("#PartialSection").html(result);
                $("#modalTitle").html("Audit View");
                $("#CreateEditForm").modal('show');

            },
            error: function (status) {
                alert('');
            }
        });
        }
    }

    </script>
}