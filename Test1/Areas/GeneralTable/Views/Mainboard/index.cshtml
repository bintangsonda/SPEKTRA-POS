@{
    ViewBag.Title = "Mainboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row g-6">
        <!-- Gamification Card -->
        <div class="col-md-12 col-xxl-8">
            <div class="card">
                <div class="d-flex align-items-end row">
                    <div class="col-md-6 order-2 order-md-1">
                        <div class="card-body">
                            <h4 class="card-title mb-4">Welcoming <span class="fw-bold"></span> 🎉</h4>
                            <p class="mb-0">Hope you’re having a great day. Let’s get things done!</p>
                            <br />
                            <button type="button" class="btn btn-primary" onclick="LoadShiftForm()">
                                Open / Close Shift
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6 text-center text-md-end order-1 order-md-2">
                        <div class="card-body pb-0 px-0 pt-2">
                        
                            <img src="~/assets/img/illustrations/illustration-john-light.png"
                                 height="186"
                                 class="scaleX-n1-rtl"
                                 alt="View Profile" 
                                 />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--/ Gamification Card -->
    </div>
</div>

                        <script>
                            function LoadShiftForm(){
                                document.location = '@Url.Action("Index", "Shift", new { Area = "Employee" })';
                            }
                        </script>