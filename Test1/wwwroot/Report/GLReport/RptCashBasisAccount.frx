    string GetIndentedName(int tl, string name)
    {
      int indentSpaces = 0;

      switch (tl)
      {
        case 1: indentSpaces = 16; break;
        case 2: indentSpaces = 14; break;
        case 3: indentSpaces = 12; break;
        case 4: indentSpaces = 10; break;
        case 5: indentSpaces = 8; break;
        case 6: indentSpaces = 6; break;
        case 7: indentSpaces = 4; break;
        case 8: indentSpaces = 2; break;
        case 9: indentSpaces = 0; break;
      }

      return new string(' ', indentSpaces) + name;
    }

    private void Text19_BeforePrint(object sender, EventArgs e)
    {
      var band = Report.GetColumnValue(&quot;ACCGLMH.TL&quot;);
      int tl = Convert.ToInt32(band);

      // TL &gt;= 2 = bold
      if (tl &gt;= 2)
        (sender as TextObject).Font = new Font((sender as TextObject).Font, FontStyle.Bold);
      else
        (sender as TextObject).Font = new Font((sender as TextObject).Font, FontStyle.Regular);
    }

