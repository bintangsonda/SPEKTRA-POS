                    $("#Harga").val(AddCommaDecimal(data.Harga));
                    $("#Description").val(data.Description);
                    $("#cboStatus").prop("checked", data.Status);

                    // 2. PREVIEW GAMBAR
                    if (data.Image) {
                        const imageUrl = `../..${data.Image}`;

                        $("#PreviewImage")
