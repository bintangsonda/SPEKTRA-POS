<Report ScriptLanguage="CSharp" ReportInfo.Created="10/20/2025 10:43:38" ReportInfo.Modified="11/01/2025 13:26:49" ReportInfo.CreatorVersion="2025.2.0.0">
  <ScriptText>using System;
using System.Collections;
using System.Collections.Generic;
using System.ComponentModel;
using System.Windows.Forms;
using System.Drawing;
using System.Data;
using FastReport;
using FastReport.Data;
using FastReport.Dialog;
using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {
    decimal C1CurrentAmt = 0;
    decimal C2CurrentAmt = 0;
    decimal C3CurrentAmt = 0;
    decimal C4CurrentAmt = 0;
    decimal C5CurrentAmt = 0;
    decimal C6CurrentAmt = 0;
    decimal C7CurrentAmt = 0;
    decimal mCurrentAmt = 0;
    
    decimal C1CurrentAmtBudget = 0;
    decimal C2CurrentAmtBudget = 0;
    decimal C3CurrentAmtBudget = 0;
    decimal C4CurrentAmtBudget = 0;
    decimal C5CurrentAmtBudget = 0;
    decimal C6CurrentAmtBudget = 0;
    decimal C7CurrentAmtBudget = 0;
    decimal mCurrentAmtBudget = 0;
    
    decimal C1CurrentAmtPrev = 0;
    decimal C2CurrentAmtPrev = 0;
    decimal C3CurrentAmtPrev = 0;
    decimal C4CurrentAmtPrev = 0;
    decimal C5CurrentAmtPrev = 0;
    decimal C6CurrentAmtPrev = 0;
    decimal C7CurrentAmtPrev = 0;
    decimal mCurrentAmtPrev = 0;
    
    decimal DeferenceAB = 0;
    decimal DeferenceAC = 0;
    
    private void Data1_BeforePrint(object sender, EventArgs e)
    {
      if(!Report.Engine.FinalPass){
        return;
      }
      
      decimal fromacc = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatActualVsBudget.fromAcc&quot;));
      decimal multiply = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatActualVsBudget.multiply&quot;));
      decimal divide = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatActualVsBudget.divide&quot;));
      int dbtcrd = Convert.ToInt32(Report.GetColumnValue(&quot;GLRepIncomeStatActualVsBudget.dbtcrd&quot;));
      
      decimal ActualThisYear = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatActualVsBudget.ActualThisYear&quot;));  
      decimal BudgetThisYear = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatActualVsBudget.BudgetThisYear&quot;)); 
      decimal ActualPrevYear = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatActualVsBudget.ActualPrevYear&quot;));
      
      decimal formula = 0;
      decimal formulaBudget = 0;
      decimal formulaPrev = 0;
      
      switch ((int)fromacc)
      {
        case 8:
          formula = ActualThisYear;
          if (dbtcrd == 1) formula *= -1;
          formula *= (multiply / divide);
          mCurrentAmt = formula;
          
          formulaBudget = BudgetThisYear;
          if (dbtcrd == 1) formulaBudget *= -1;
          formulaBudget *= (multiply / divide);
          mCurrentAmtBudget = formulaBudget;  
          
          formulaPrev = ActualPrevYear;
          if (dbtcrd == 1) formulaPrev *= -1;
          formulaPrev *= (multiply / divide);
          mCurrentAmtPrev = formulaPrev;
          
          break;
        case 7: mCurrentAmt = C7CurrentAmt; mCurrentAmtBudget = C7CurrentAmtBudget; mCurrentAmtPrev = C7CurrentAmtPrev; break;
        case 6: mCurrentAmt = C6CurrentAmt; mCurrentAmtBudget = C6CurrentAmtBudget; mCurrentAmtPrev = C6CurrentAmtPrev; break;
        case 5: mCurrentAmt = C5CurrentAmt; mCurrentAmtBudget = C5CurrentAmtBudget; mCurrentAmtPrev = C5CurrentAmtPrev; break;
        case 4: mCurrentAmt = C4CurrentAmt; mCurrentAmtBudget = C4CurrentAmtBudget; mCurrentAmtPrev = C4CurrentAmtPrev; break;
        case 3: mCurrentAmt = C3CurrentAmt; mCurrentAmtBudget = C3CurrentAmtBudget; mCurrentAmtPrev = C3CurrentAmtPrev; break;
        case 2: mCurrentAmt = C2CurrentAmt; mCurrentAmtBudget = C2CurrentAmtBudget; mCurrentAmtPrev = C2CurrentAmtPrev; break;
        case 1: mCurrentAmt = C1CurrentAmt; mCurrentAmtBudget = C1CurrentAmtBudget; mCurrentAmtPrev = C1CurrentAmtPrev; break;
      }
      
      UpdateAmount(&quot;C1&quot;, ref C1CurrentAmt);
      UpdateAmount(&quot;C2&quot;, ref C2CurrentAmt);
      UpdateAmount(&quot;C3&quot;, ref C3CurrentAmt);
      UpdateAmount(&quot;C4&quot;, ref C4CurrentAmt);
      UpdateAmount(&quot;C5&quot;, ref C5CurrentAmt);
      UpdateAmount(&quot;C6&quot;, ref C6CurrentAmt);
      UpdateAmount(&quot;C7&quot;, ref C7CurrentAmt);
      
      UpdateAmountBudget(&quot;C1&quot;, ref C1CurrentAmtBudget);
      UpdateAmountBudget(&quot;C2&quot;, ref C2CurrentAmtBudget);
      UpdateAmountBudget(&quot;C3&quot;, ref C3CurrentAmtBudget);
      UpdateAmountBudget(&quot;C4&quot;, ref C4CurrentAmtBudget);
      UpdateAmountBudget(&quot;C5&quot;, ref C5CurrentAmtBudget);
      UpdateAmountBudget(&quot;C6&quot;, ref C6CurrentAmtBudget);
      UpdateAmountBudget(&quot;C7&quot;, ref C7CurrentAmtBudget);
      
      UpdateAmountPrev(&quot;C1&quot;, ref C1CurrentAmtPrev);
      UpdateAmountPrev(&quot;C2&quot;, ref C2CurrentAmtPrev);
      UpdateAmountPrev(&quot;C3&quot;, ref C3CurrentAmtPrev);
      UpdateAmountPrev(&quot;C4&quot;, ref C4CurrentAmtPrev);
      UpdateAmountPrev(&quot;C5&quot;, ref C5CurrentAmtPrev);
      UpdateAmountPrev(&quot;C6&quot;, ref C6CurrentAmtPrev);
      UpdateAmountPrev(&quot;C7&quot;, ref C7CurrentAmtPrev);
      
      if(mCurrentAmtBudget==0){
        DeferenceAB = 0;
      }else{
        DeferenceAB = mCurrentAmt / mCurrentAmtBudget * 100;
      }
      
      if(mCurrentAmtPrev==0){
        DeferenceAC = 0;
      }else{
        DeferenceAC = mCurrentAmt / mCurrentAmtPrev * 100;
      }
      
      
    }
    
    
    private void UpdateAmount(string colName, ref decimal target)
    {
      var flag = Report.GetColumnValue(&quot;GLRepIncomeStatActualVsBudget.&quot; + colName);
      if (flag == null) return;

      string val = flag.ToString();
      if (val == &quot;+&quot;) target += mCurrentAmt;
      else if (val == &quot;-&quot;) target -= mCurrentAmt;
      else if (val == &quot;0&quot;) target = 0;
    }
    
    private void UpdateAmountBudget(string colName, ref decimal target)
    {
      var flag = Report.GetColumnValue(&quot;GLRepIncomeStatActualVsBudget.&quot; + colName);
      if (flag == null) return;

      string val = flag.ToString();
      if (val == &quot;+&quot;) target += mCurrentAmtBudget;
      else if (val == &quot;-&quot;) target -= mCurrentAmtBudget;
      else if (val == &quot;0&quot;) target = 0;
    }
    
    private void UpdateAmountPrev(string colName, ref decimal target)
    {
      var flag = Report.GetColumnValue(&quot;GLRepIncomeStatActualVsBudget.&quot; + colName);
      if (flag == null) return;

      string val = flag.ToString();
      if (val == &quot;+&quot;) target += mCurrentAmtPrev;
      else if (val == &quot;-&quot;) target -= mCurrentAmtPrev;
      else if (val == &quot;0&quot;) target = 0;
    }
    
    private void Text45_BeforePrint(object sender, EventArgs e) //Tambah border tergantung kondisi
    {
      
      decimal fromacc = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatActualVsBudget.fromAcc&quot;));
      string Descrip = Convert.ToString(Report.GetColumnValue(&quot;GLRepIncomeStatActualVsBudget.Descrip&quot;));
      string genAcc = Convert.ToString(Report.GetColumnValue(&quot;GLRepIncomeStatActualVsBudget.genAcc&quot;));
      
      var txt = sender as TextObject;
      if(fromacc==0 || Descrip==null || Descrip==&quot;&quot;){
        txt.TextColor = System.Drawing.Color.White;
      }else{
        txt.TextColor = System.Drawing.Color.Black;
      }
      
      if(genAcc==&quot;XX&quot;){
        txt.Border.Lines = BorderLines.Top;
        txt.Border.Color = System.Drawing.Color.Black;
        txt.Border.Width = 1;
        txt.Border.TopLine.Style = LineStyle.Solid;
      }
      else if(genAcc==&quot;YY&quot;){
        txt.Border.Lines = BorderLines.Bottom;
        txt.Border.Color = System.Drawing.Color.Black;
        txt.Border.Width = 1;
        txt.Border.BottomLine.Style = LineStyle.Double;
      }
      else{
        txt.Border.Lines = BorderLines.None;
        txt.Border.Width = 0;
      }
     
    }
    
  }
}
</ScriptText>
