@model General.Catalog.Product
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Product List";
}
<style>
     .nav-tabs .nav-link.active {
        background-color: #0d6efd !important; /* biru bootstrap */
        color: white !important;
        border-radius: 6px 6px 0 0;
    }

    .nav-tabs .nav-link {
        background-color: #e9ecef; /* warna default tab */
        color: #495057;
        border-radius: 6px 6px 0 0;
    }
</style>
@section Styles {
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/select2/select2.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/flatpickr/flatpickr.css" />
    <link rel="stylesheet" href="~/assets/css/custom.css" />

}
@Html.Hidden("PageEdit", Convert.ToInt32(ViewData["Page.Edit"]))
@Html.Hidden("PageDelete", Convert.ToInt32(ViewData["Page.Delete"]))
@Html.Hidden("PageInsert", Convert.ToInt32(ViewData["Page.Insert"]))
@Html.Hidden("FormAction", Convert.ToInt32(ViewData["FormAction"]))

<!--Table Data-->
<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center">
            <i class="ri ri-restaurant-2-line me-2 text-primary" style="font-size: 1.5rem;"></i>
            <h4 class="card-title mb-0 fw-semibold text-primary">
                @ViewBag.Title
            </h4>
        </div>
    </div>
    <div class="card">
          <div class="card-header border-bottom">
            <div class="row g-2 align-items-end">
                <!-- Baris 1 -->

                <div class="col-sm-3">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownList("BranchFilter", ViewData["BranchList"] as SelectList,"All", new { @class = "form-control form-control-sm select2" })
                        <label for="BranchFilter">Outlet</label>
                    </div>
                </div>
                <div class="col-sm-3">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownList("CategoriesFilter", ViewData["CategoriesList"] as SelectList,"All", new { @class = "form-control form-control-sm select2" })
                        <label for="CategoriesFilter">Category</label>
                    </div>
                </div>


                <div class="col-sm-2 d-flex justify-content-start align-items-center gap-2">
                    <button type="button" class="btn btn-primary d-flex align-items-center px-3 py-2" onclick="getData()">
                        <i class="ri ri-search-line icon-18px"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-datatable">
            <table id="tableData" class="datatables-custom table table-responsive table-sm w-100">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>Product Code</th>
                        <th>Product Name</th>
                        <th>Category Code</th>
                        <th>Outlet</th>
                        <th>Status</th>
                        <th>Harga</th>
                        <th>Description</th>
                        <th>Operator ID</th>
                        <th>Last Update</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<!--Table Data-->
<!--modal input-->
<div class="modal fade" id="ModalInsert" role="dialog" aria-labelledby="defferedAmmortizeLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg  modal-dialog-centered" role="document">
        <div class="modal-content">
            <!-- Header -->
            <div class="modal-header bg-primary py-2 px-3 d-flex justify-content-between align-items-center">
                <h4 class="modal-title mb-0 fw-semibold text-white" id="defferedAmmortizeLabel">
                    Add Product
                </h4>
                <button type="button"
                        class="btn shadow-none p-0"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                    <i class="icon-base ri ri-close-large-line icon-md text-white"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                 <!-- NAVIGATION TAB -->
                <ul class="nav nav-tabs " id="variantTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab-info"
                                data-bs-toggle="tab" data-bs-target="#pane-info"
                                type="button" role="tab">
                            Product Info
                        </button>
                    </li>

                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-list"
                                data-bs-toggle="tab" data-bs-target="#pane-list"
                                type="button" role="tab">
                           Product Variant
                        </button>
                    </li>
                </ul>
                <hr />
                 <div class="tab-content">
                     <div class="tab-pane fade show active" id="pane-info" role="tabpanel">
                         <div class="row gy-2">
                            <div class="col-6">
                                <div class="form-group">
                                    <div class="form-floating form-floating-outline mb-3">
                                        @Html.TextBoxFor(model => model.ProdCode, new { @class = "form-control", placeholder = "AUTO", @maxlength = 5 })
                                        <label>Product Code</label>
                                    </div>
                                    <div class="form-floating form-floating-outline mb-3">
                                        @Html.TextBoxFor(model => model.ProdName, new { @class = "form-control", placeholder = "AUTO", @maxlength = 50 })
                                        <label>Product Name</label>
                                    </div>
                                    <div class="form-floating form-floating-outline mb-3">
                                        @Html.DropDownListFor(model => model.Branch,ViewData["BranchList"] as SelectList, new { @class = "form-control form-control-sm select2" })
                                        <label>Outlet</label>
                                    </div>
                                    <div class="form-floating form-floating-outline mb-3">
                                        @Html.DropDownListFor(model => model.CategoriesCode, ViewData["CategoriesList"] as SelectList, new { @class = "form-control form-control-sm select2" })
                                        <label>Category</label>
                                    </div>
                                    <div class="row"> 
                                        <div class="col-sm-6">
                                             <div class="form-floating form-floating-outline mb-3">
                                                @Html.TextBoxFor(model => model.Harga, new { @class = "form-control", placeholder = "masukan harga...",onkeyup = "InputNumber(this)", @maxlength = 15 })
                                                <label>Harga Product</label>
                                            </div>
                                    
                                        </div>
                                        <div class="col-sm-6">
                                           <div class="status-switch-wrapper d-flex align-items-center gap-3 mb-3">
                                                <label class="status-title">Status Active</label>

                                                <div class="form-check form-switch d-flex align-items-center gap-2">
                                                        @Html.CheckBoxFor(model => model.Status,new { @id = "cboStatus", @class = "form-check-input status-toggle" })
                                                    <span id="cboStatus" class="status-badge"></span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                            
                                    <div class="form-floating form-floating-outline mb-3">
                                        @Html.TextAreaFor(model => model.Description, 
                                            new { 
                                                @class = "form-control fomr-control-sm", 
                                                placeholder = "Masukkan deskripsi...", 
                                                maxlength = "300",
                                                rows = "1"
                                            })
                                        <label>Description</label>
                                    </div>
                                </div>
                        
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold">Upload Gambar Product</label>
                                <input type="file" 
                                       id="ImageFile" 
                                       name="ImageFile" 
                                       accept="image/png, image/jpeg"
                                       class="form-control form-control-sm" />

                                <!-- Preview -->
                                <div class="mt-2 text-center">
                                    <img id="previewImageUpload" 
                                         src="" 
                                         class="img-thumbnail" 
                                         style="display:none; max-width: 100px; border-radius: 8px;" />
                                </div>


                                <label class="form-label fw-bold mt-5">Preview Product</label>
                                <div class="text-center">
                                    <div class="card shadow-sm"
                                         style="width: 180px; border-radius: 10px; margin: 0 auto;">
        
                                        <img id="PreviewImage" 
                                             src=""
                                             class="card-img-top"
                                             style="width: 100%; height: 180px; object-fit: cover; border-radius: 10px;"/>

                                        <div class="card-body p-2">
                                            <h6 id="PreviewName" class="fw-bold m-0">Nama Produk</h6>
                                            <small id="PreviewDesc" class="text-muted">Deskripsi produk</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                     </div>

                      <div class="tab-pane fade" id="pane-list" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="fw-bold mb-0"># Variant</h6>
                                <button type="button" class="btn btn-sm btn-primary" id="btnAddListVarian">
                                    + Tambah
                                </button>
                            </div>

                            <table class="table table-bordered" id="tableVarianList">
                                <thead>
                                    <tr>
                                        <th class="text-center" style="width:10px">#</th>
                                        <th style="width:180px">Variant</th>
                                        <th class="text-center" style="width:10px">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- otomatis terisi dari javascript nanti -->
                                </tbody>
                            </table>
                      </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer py-2 px-3 border-0 justify-content-center">
                <button type="button" class="btn btn-secondary btn-sm" id="btnAddNew">
                    <i class="ri ri-reset-left-fill me-1 icon-18px"></i> Add New
                </button>
                <button type="button" class="btn btn-success btn-sm SaveInsert" id="btnSave">
                    <i class="ri ri-check-fill me-1 icon-18px"></i> Save
                </button>
                <button type="button" class="btn btn-danger btn-sm" data-bs-dismiss="modal">
                    <i class="ri ri-close-line me-1 icon-18px"></i> Close
                </button>
            </div>
               
            
        </div>
    </div>
</div>
<!--modal input-->
<!--Modal duplikat-->
<div class="modal fade" id="ModalDuplicate" role="dialog" aria-labelledby="defferedAmmortizeLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm  modal-dialog-centered" role="document">
        <div class="modal-content">
            <!-- Header -->
            <div class="modal-header bg-primary py-2 px-3 d-flex justify-content-between align-items-center">
                <h4 class="modal-title mb-0 fw-semibold text-white" id="xxx">
                    Duplicate Product
                </h4>
                <button type="button"
                        class="btn shadow-none p-0"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                    <i class="icon-base ri ri-close-large-line icon-md text-white"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                 <div class="tab-content">
                     <div class="tab-pane fade show active" id="pane-info" role="tabpanel">
                         <div class="row gy-2">
                            <div class="col-12">
                                <div class="form-group">
                                    <div class="form-floating form-floating-outline mb-3">
                                        @Html.TextBox("productCode", null, new { @class = "form-control", placeholder = "AUTO",@disabled="disabled", maxlength = 5 })
                                        <label>Product Code</label>
                                    </div>
                                    <div class="form-floating form-floating-outline mb-3">
                                        @Html.DropDownList("OutletFrom",ViewData["BranchList"] as SelectList, new { @class = "form-control form-control-sm select2",@disabled="disabled", })
                                        <label>Outlet From</label>
                                    </div>
                                    <div class="form-floating form-floating-outline mb-3">
                                        @Html.DropDownList("OutletTo",ViewData["BranchList"] as SelectList, new { @class = "form-control form-control-sm select2" })
                                        <label>Outlet To</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                     </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer py-2 px-3 border-0 justify-content-center">
                <button type="button" class="btn btn-success btn-sm SaveInsert" onclick="DuplicateProdut()" id="btnDuplicate">
                    <i class="ri ri-check-fill me-1 icon-18px"></i> Save
                </button>
                <button type="button" class="btn btn-danger btn-sm" data-bs-dismiss="modal">
                    <i class="ri ri-close-line me-1 icon-18px"></i> Close
                </button>
            </div>
               
            
        </div>
    </div>
</div>

<!--Modal duplikat-->
<!-- Loading Page -->
<div id="loading" style="display:none; height:100%; width:100%">
    <div class="loading-wave" id="loading-content">
        <div class="loading-bar"></div>
        <div class="loading-bar"></div>
        <div class="loading-bar"></div>
        <div class="loading-bar"></div>
    </div>
    <div class="loading loading07">
        <span data-text="S">S</span>
        <span data-text="P">P</span>
        <span data-text="E">E</span>
