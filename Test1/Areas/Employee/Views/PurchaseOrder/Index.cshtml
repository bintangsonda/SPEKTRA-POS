@model Transaction.Employee.PurchaseOrderH
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Purchase Order";
}
<style>
    .select2-dropdown {
        z-index: 999999 !important;
    }

    .nav-tabs .nav-link.active {
        background-color: #0d6efd !important; /* biru bootstrap */
        color: white !important;
        border-radius: 6px 6px 0 0;
    }

    .nav-tabs .nav-link {
        background-color: #e9ecef; /* warna default tab */
        color: #495057;
        border-radius: 6px 6px 0 0;
    }

    .btn-danger {
        background-color: var(--bs-danger) !important;
        border-color: var(--bs-danger) !important;
        color: #fff !important;
    }

        .btn-danger:hover {
            background-color: #bb2d3b !important;
            border-color: #b02a37 !important;
        }
</style>
@section Styles {
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/select2/select2.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/flatpickr/flatpickr.css" />
    <link rel="stylesheet" href="~/assets/css/custom.css" />

}
@Html.Hidden("PageEdit", Convert.ToInt32(ViewData["Page.Edit"]))
@Html.Hidden("PageDelete", Convert.ToInt32(ViewData["Page.Delete"]))
@Html.Hidden("PageInsert", Convert.ToInt32(ViewData["Page.Insert"]))
@Html.Hidden("FormAction", Convert.ToInt32(ViewData["FormAction"]))

<!--Table Data-->
<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center">
            <i class="ri ri-shopping-cart-2-line me-2 text-primary" style="font-size: 1.5rem;"></i>
            <h4 class="card-title mb-0 fw-semibold text-primary">
                @ViewBag.Title
            </h4>
        </div>
    </div>
    <div class="card">
        <div class="card-header border-bottom">
            <div class="row g-2 align-items-end">
                <!-- Cabang -->
                <div class="col-sm-4">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownList(
                            "Cabang",
                            ViewData["BranchList"] as SelectList,
                            "All",
                            new { @class = "form-control form-control-sm select2" }
                        )
                        <label for="Cabang">Cabang</label>
                    </div>
                </div>

                <!-- Search -->
                <div class="col-sm-1 d-flex justify-content-start align-items-center">
                    <button type="button"
                            class="btn btn-primary d-flex align-items-center px-3 py-2"
                            onclick="getData()">
                        <i class="ri ri-search-line icon-18px"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="card-datatable">
            <table id="tableData" class="datatables-custom table table-responsive table-sm w-100">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>PO No</th>
                        <th>PO Date</th>
                        <th>Branch</th>
                        <th>Supplier</th>
                        <th>Total Amount</th>
                        <th>Created By</th>
                        <th>Last Update</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<!--Table Data-->

<!--modal input-->
<div class="modal fade" id="ModalInsert" role="dialog" aria-labelledby="defferedAmmortizeLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <!-- Header -->
            <div class="modal-header bg-primary py-2 px-3 d-flex justify-content-between align-items-center">
                <h4 class="modal-title mb-0 fw-semibold text-white" id="defferedAmmortizeLabel">
                    Add Purchase Order
                </h4>
                <button type="button"
                        class="btn shadow-none p-0"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                    <i class="icon-base ri ri-close-large-line icon-md text-white"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                <!-- NAVIGATION TAB -->
                <ul class="nav nav-tabs " id="poTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab-info"
                                data-bs-toggle="tab" data-bs-target="#pane-info"
                                type="button" role="tab">
                            PO Info
                        </button>
                    </li>

                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-list"
                                data-bs-toggle="tab" data-bs-target="#pane-list"
                                type="button" role="tab">
                            Item Detail
                        </button>
                    </li>
                </ul>
                <hr />

                <!-- TAB CONTENT -->
                <div class="tab-content">

                    <!-- ======================= -->
                    <!--   TAB 1 : PO INFO       -->
                    <!-- ======================= -->
                    <div class="tab-pane fade show active" id="pane-info" role="tabpanel">

                        <div class="row gy-2">
                            <div class="col-12">
                                <div class="form-group">
                                    <div class="row g-3">
                                        <!-- PO No -->
                                        <div class="col-12 col-md-3">
                                            <div class="form-floating form-floating-outline mb-3">
                                                @Html.TextBoxFor(model => model.POHNo, new
                                                {
                                                    @class = "form-control",
                                                    placeholder = "AUTO",
                                                    maxlength = 20,
                                                    @readonly = "readonly"
                                                })
                                                <label for="POHNo">PO No</label>
                                            </div>
                                        </div>

                                        <!-- PO Date -->
                                        <div class="col-12 col-md-3">
                                            <div class="form-floating form-floating-outline mb-3">
                                                @Html.TextBoxFor(model => model.POHDate, "{0:yyyy-MM-dd}", new
                                                {
                                                    @class = "form-control",
                                                    placeholder = "PO Date",
                                                    @readonly = "readonly"
                                                })
                                                <label for="POHDate">PO Date</label>
                                            </div>
                                        </div>

                                        <!-- Branch -->
                                        <div class="col-12 col-md-3">
                                            <div class="form-floating form-floating-outline mb-3">
                                                @Html.DropDownListFor(model => model.BranchCode,
                                                    ViewData["BranchList"] as SelectList,
                                                    "-- Select Branch --",
                                                    new { @class = "form-control form-control-sm select2" })
                                                <label for="BranchCode">Branch</label>
                                            </div>
                                        </div>

                                        <!-- Status -->
                                        <div class="col-12 col-md-3">
                                            <div class="form-floating form-floating-outline mb-3">
                                                @Html.TextBoxFor(model => model.Status, new
                                                {
                                                    @class = "form-control",
                                                    @readonly = "readonly"
                                                })
                                                <label for="Status">Status (0=Open)</label>
                                            </div>
                                        </div>

                                        <!-- Supplier -->
                                        <div class="col-12 col-md-6">
                                            <div class="form-floating form-floating-outline mb-3">
                                                @Html.TextBoxFor(model => model.Supplier, new
                                                {
                                                    @class = "form-control",
                                                    placeholder = "Supplier Name",
                                                    maxlength = 100
                                                })
                                                <label for="Supplier">Supplier</label>
                                            </div>
                                        </div>

                                        <!-- Remark -->
                                        <div class="col-12 col-md-6">
                                            <div class="form-floating form-floating-outline mb-3">
                                                @Html.TextBoxFor(model => model.Remark, new
                                                {
                                                    @class = "form-control",
                                                    placeholder = "Remark",
                                                    maxlength = 200
                                                })
                                                <label for="Remark">Remark</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================== -->
                    <!--   TAB 2 : ITEM DETAIL      -->
                    <!-- ========================== -->
                    <div class="tab-pane fade" id="pane-list" role="tabpanel">

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0">Item Detail</h6>
                            <button type="button" class="btn btn-sm btn-primary" id="btnAddListPO">
                                + Tambah
                            </button>
                        </div>

                        <table class="table table-bordered text-center align-middle" id="tablePOList">
                            <thead>
                                <tr>
                                    <th style="width:20px">#</th>
                                    <th style="width:280px">Product</th>
                                    <th style="width:90px">UOM</th>
                                    <th style="width:110px">Qty</th>
                                    <th style="width:130px">Price</th>
                                    <th style="width:130px">Subtotal</th>
                                    <th style="width:30px">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- otomatis terisi dari javascript nanti -->
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="5" class="text-end fw-bold">Total Amount</td>
                                    <td class="text-center fw-bold" id="totalAmt">0</td>
                                    <td></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div> <!-- end tab content -->
            </div>

            <!-- Footer -->
            <div class="modal-footer py-2 px-3 border-0 justify-content-end">
                <button type="button" class="btn btn-secondary btn-sm" id="btnAddNew">
                    <i class="ri ri-reset-left-fill me-1 icon-18px"></i> Add New
                </button>
                <button type="button" class="btn btn-success btn-sm SaveInsert" id="btnSave">
                    <i class="ri ri-check-fill me-1 icon-18px"></i> Save
                </button>
                <button type="button" class="btn btn-danger btn-sm" data-bs-dismiss="modal">
                    <i class="ri ri-close-line me-1 icon-18px"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>
<!--modal input-->

<!-- Loading Page -->
<div id="loading" style="display:none; height:100%; width:100%">
    <div class="loading-wave" id="loading-content">
        <div class="loading-bar"></div>
        <div class="loading-bar"></div>
        <div class="loading-bar"></div>
        <div class="loading-bar"></div>
    </div>
    <div class="loading loading07">
        <span data-text="S">S</span>
        <span data-text="P">P</span>
        <span data-text="E">E</span>
        <span data-text="K">K</span>
        <span data-text="T">T</span>
        <span data-text="R">R</span>
        <span data-text="A">A</span>
    </div>
</div>
<!-- Loading Page -->

<div id="PartialSection">
</div>


@section Scripts {
    <script src="~/assets/vendor/libs/moment/moment.js"></script>
    <script src="~/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/assets/vendor/libs/select2/select2.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/popular.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/bootstrap5.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/auto-focus.js"></script>
    <script src="~/assets/vendor/libs/cleave-zen/cleave-zen.js"></script>
    <script src="~/assets/js/forms-selects.js"></script>
    <script src="~/assets/vendor/libs/tagify/tagify.js"></script>
    <script src="~/assets/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
    <script src="~/assets/vendor/libs/typeahead-js/typeahead.js"></script>
    <script src="~/assets/vendor/libs/bloodhound/bloodhound.js"></script>
    <script src="~/assets/vendor/libs/flatpickr/flatpickr.js"></script>
    <script type="text/javascript">
        const token = $('input[name="__RequestVerificationToken"]').val();
        const getDataUrl = '@Url.Action("GetData", "PurchaseOrder", new { area = "Employee" })';

        var table = null;
        var nilaiTampung = "";
        var productOptionsHtml = '<option value="">-- Pilih Product --</option>';
        var suppressBranchChange = false;
        var defaultBranch = "";

        $('.select2').select2();

        $(document).ready(function () {
            flatpickr("#POHDate", {
                dateFormat: "Y-m-d",
                disableMobile: true
            });

            table = getData();

            $('#Cabang').select2({
                placeholder: 'All',
                allowClear: true,
                width: '100%'
            });

            $("#BranchCode").select2({
                width: "100%",
                placeholder: "-- Select Branch --",
                allowClear: true,
                dropdownParent: $("#ModalInsert")
            });

            if ($('#PageInsert').val() == 0) {
                $('.AddNew').prop('disabled', true);
            }

            // Simpan branch default dari session & muat opsi product-nya
            defaultBranch = $("#BranchCode").val();
            refreshProductOptions(defaultBranch);
        });

        function getData() {
            return $('#tableData').DataTable({
                bDestroy: true,
                processing: true,
                serverSide: true,
                "bAutoWidth": true,
                scrollX: true,
                ajax: {
                    url: getDataUrl,
                    type: 'POST',
                    dataType: "JSON",
                    data: function (d) {
                        d.Branch = $('#Cabang').val();
                    }
                },
                columns: [
                    { data: 'action', name: 'action', orderable: false },
                    { data: "POHNo", name: "POHNo" },
                    {
                        "data": "POHDate", "name": "POHDate",
                        "render": function (data, type, row, meta) {
                            return moment(row.POHDate).format('DD/MMM/YYYY');
                        }
                    },
                    { "data": "BranchCode", "name": "BranchCode" },
                    { "data": "Supplier", "name": "Supplier" },
                    {
                        "data": "TotalAmt", "name": "TotalAmt",
                        "render": function (data, type, row, meta) {
                            return Number(row.TotalAmt).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                        }
                    },
                    { "data": "CreatedBy", "name": "CreatedBy" },
                    {
                        "data": "LastUpdate", "name": "LastUpdate",
                        "render": function (data, type, row, meta) {
                            return moment(row.LastUpdate).format('DD/MMM/YYYY');
                        }
                    },
                ],
                columnDefs: [
                    {
                        targets: [0],
                        title: 'Actions',
                        searchable: false,
                        orderable: false,
                        render: (data, type, full, meta) => {
                            return `
                        <div class="d-flex align-items-center">
                            <a href="javascript:;"
                                class="btn btn-icon btn-text-danger rounded-pill delete-record"
                                data-code="${full.POHNo}">
                                <i class="icon-base ri ri-delete-bin-7-line icon-md text-danger"></i>
                            </a>
                            <a href="javascript:;"
                               class="btn btn-icon btn-text-warning rounded-pill edit-record"
                               data-code="${full.POHNo}">
                                <i class="icon-base ri ri-pencil-line icon-md text-warning"></i>
                            </a>


                        </div>
                    `;
                        }
                    },

                    {
                        "targets": [1]
                    },
                    {
                        "targets": [2]
                    },
                    {
                        "targets": [3]
                    },
                    {
                        "targets": [4]
                    },
                    {
                        "targets": [5]
                    },
                    {
                        "targets": [6]
                    },
                    {
                        "targets": [7]
                    },
                ],
                select: {
                    style: 'os',
                },
                order: [[1, 'desc']],
                layout: {
                    topStart: {
                        rowClass: 'row m-2 my-0 mt-0 justify-content-between',
                        features: [
                            {
                                pageLength: {
                                    menu: [[1, 10, 25, 50, 100, 1000, -1], [1, 10, 25, 50, 100, 1000, "All"]],
                                    text: 'Show _MENU_ entries'
                                }
                            },
                        ]
                    },
                    topEnd: {
                        features: [
                            {
                                buttons: [
                                    {
                                        text: `
                                            <i class="icon-base ri ri-add-line icon-sm me-0 d-inline-block"></i>
                                            <span class="d-none d-sm-inline-block">Add</span>
                                        `,
                                        className: 'btn add-new me-2 d-flex align-items-center',
                                        action: function (e, dt, node, config) {
                                            $("#POHNo").prop("disabled", false)
                                            $("#defferedAmmortizeLabel").text("Add Purchase Order")
                                            ClearModal();
                                            let modal = new bootstrap.Modal(document.getElementById('ModalInsert'));
                                            modal.show();
                                            $("#FormAction").val(1)
                                        }
                                    }
                                ]
                            },


                            {
                                search: {
                                    placeholder: 'Search Purchase Order',
                                    text: '_INPUT_'
                                }
                            },

                        ]
                    },
                    bottomStart: {
                        rowClass: 'row mx-3 justify-content-between',
                        features: ['info']
                    },
                    bottomEnd: 'paging'
                },
                language: {
                    paginate: {
                        next: '<i class="icon-base ri ri-arrow-right-s-line scaleX-n1-rtl icon-22px"></i>',
                        previous: '<i class="icon-base ri ri-arrow-left-s-line scaleX-n1-rtl icon-22px"></i>',
                        first: '<i class="icon-base ri ri-skip-back-mini-line scaleX-n1-rtl icon-22px"></i>',
                        last: '<i class="icon-base ri ri-skip-forward-mini-line scaleX-n1-rtl icon-22px"></i>'
                    }
                },


            });


        }

        // ============ DETAIL ROW ============

        function refreshProductOptions(branch) {
            if (!branch) {
                productOptionsHtml = '<option value="">-- Pilih Product --</option>';
                return;
            }

            $.ajax({
                url: '@Url.Action("GetProductListForPO", "PurchaseOrder", new { Area = "Employee" })',
                type: 'GET',
                data: { Branch: branch },
                success: function (response) {
                    productOptionsHtml = '<option value="">-- Pilih Product --</option>';
                    $.each(response, function (index, item) {
                        productOptionsHtml += `<option value="${item.Value}">${item.Text}</option>`;
                    });
                },
                error: function (xhr) {
                    SweetAlertError('Failed!', "Gagal mengambil data product!");
                    console.error(xhr.responseText);
                }
            });
        }

        function buildDetailRowHtml() {
            return `
                <tr>
                    <td class="text-center align-middle row-no"></td>

                    <td class="text-center align-middle">
                        <select class="form-select form-select-sm text-center select2 prod-select">
                            ${productOptionsHtml}
                        </select>
                    </td>

                    <td class="text-center align-middle">
                        <input type="text"
                               class="form-control form-control-sm text-center uom-input"
                               style="max-width: 90px; margin: auto;"
                               readonly
                               placeholder="UOM" />
                    </td>

                    <td class="text-center align-middle">
                        <input type="text"
                               class="form-control form-control-sm text-center qty-input"
                               style="max-width: 90px; margin: auto;"
                               onkeyup="AddCommaDecimal(this)"
                               oninput="recalcRow(this)"
                               placeholder="Qty" />
                    </td>

                    <td class="text-center align-middle">
                        <input type="text"
                               class="form-control form-control-sm text-center price-input"
                               style="max-width: 110px; margin: auto;"
                               onkeyup="AddCommaDecimal(this)"
                               oninput="recalcRow(this)"
                               placeholder="Price" />
                    </td>

                    <td class="text-center align-middle subtotal-cell">0</td>

                    <td class="text-center align-middle">
                        <button type="button" class="btn btn-sm btn-danger btnDelRow p-1 px-2">
                            <i class="ri ri-delete-bin-line icon-18px"></i>
                        </button>
                    </td>
                </tr>
            `;
        }

        function renumberRows() {
            $("#tablePOList tbody tr").each(function (index) {
                $(this).find("td.row-no").text(index + 1);
            });
        }

        function parseNumber(value) {
            return parseFloat((value || "").replace(/,/g, "")) || 0;
        }

        function recalcRow(input) {
            let row = $(input).closest("tr");
            let qty = parseNumber(row.find(".qty-input").val());
            let price = parseNumber(row.find(".price-input").val());
            let subtotal = qty * price;

            row.find(".subtotal-cell").text(subtotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

            recalcTotal();
        }

        function recalcTotal() {
            let total = 0;
            $("#tablePOList tbody tr").each(function () {
                let row = $(this);
                let qty = parseNumber(row.find(".qty-input").val());
                let price = parseNumber(row.find(".price-input").val());
                total += qty * price;
            });

            $("#totalAmt").text(total.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        }

        $("#btnAddListPO").on("click", function () {

            let rowCount = $("#tablePOList tbody tr").length;

            if (rowCount > 0) {
                let lastRow = $("#tablePOList tbody tr").last();

                const ProdCode = lastRow.find(".prod-select").val();
                const Qty = lastRow.find(".qty-input").val()?.trim();
                const Price = lastRow.find(".price-input").val()?.trim();

                if (!ProdCode || !Qty || !Price) {
                    SweetAlertError(
                        'Failed!',
                        "Product, Qty dan Price harus diisi dulu!"
                    );
                    return;
                }
            }

            const branch = $("#BranchCode").val();

            if (!branch) {
                SweetAlertError('Failed!', "Branch harus dipilih!");
                return;
            }

            if (!productOptionsHtml || productOptionsHtml.indexOf('option') < 0) {
                refreshProductOptions(branch);
            }

            $("#tablePOList tbody").append(buildDetailRowHtml());

            const newDropdown = $("#tablePOList tbody tr:last .select2");

            newDropdown.select2({
                width: "100%",
                placeholder: "-- Pilih Product --",
                allowClear: true,
                minimumResultsForSearch: 0,
                dropdownParent: $("#ModalInsert")
            });

            renumberRows();
        });

        // Saat product dipilih di baris detail, isi UOM dari teks option ("ProdName - UOM")
        $(document).on("change", ".prod-select", function () {
            let row = $(this).closest("tr");
            let selectedText = $(this).find("option:selected").text() || "";
            let uom = "";

            if ($(this).val() && selectedText.includes(" - ")) {
                uom = selectedText.substring(selectedText.lastIndexOf(" - ") + 3);
            }

            row.find(".uom-input").val(uom);
        });

        $(document).on("click", ".btnDelRow", function () {
            $(this).closest("tr").remove();
            renumberRows();
            recalcTotal();
        });

        // Branch berubah -> refresh opsi product & kosongkan detail
        $("#BranchCode").on("change", function () {
            if (suppressBranchChange) return;

            var branchCode = $(this).val();
            $("#tablePOList tbody").empty();
            recalcTotal();
            refreshProductOptions(branchCode);
        });

        // ============ EDIT ============

        $('.datatables-custom').on('click', '.edit-record', function () {
            const code = $(this).data('code');
            $("#tab-list").closest("li").show();

            $.ajax({
                type: 'GET',
                url: '@Url.Action("Edit", "PurchaseOrder", new { Area = "Employee" })',
                data: { POHNo: code },
                success: function (data) {
                    SweetAlertClose();
                    if (data) {
                        suppressBranchChange = true;
                        $("#POHNo").prop("disabled", true)
                        $("#POHNo").val(code)
                        $("#POHDate").val(moment(data.POHDate).format('YYYY-MM-DD'));
                        $("#BranchCode").val(data.BranchCode).trigger('change');
                        suppressBranchChange = false;
                        $("#Supplier").val(data.Supplier)
                        $("#Remark").val(data.Remark)
                        $("#Status").val(data.Status)

                        $("#tablePOList tbody").empty();

                        if (data.PODetail && data.PODetail.length > 0) {
                            data.PODetail.forEach((item, index) => {

                                $("#tablePOList tbody").append(buildDetailRowHtml());

                                let row = $("#tablePOList tbody tr:last");

                                // Pilih product sesuai data detail
                                row.find(".prod-select").val(item.ProdCode);

                                let selectedText = row.find(".prod-select").find("option:selected").text() || "";
                                let uom = "";
                                if (item.UOM) {
                                    uom = item.UOM;
                                } else if (item.ProdCode && selectedText.includes(" - ")) {
                                    uom = selectedText.substring(selectedText.lastIndexOf(" - ") + 3);
                                }

                                row.find(".uom-input").val(uom);
                                row.find(".qty-input").val(item.Qty);
                                row.find(".price-input").val(item.Price.toLocaleString('en-US', { maximumFractionDigits: 2 }));
                                row.find(".subtotal-cell").text((item.Qty * item.Price).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

                                row.find(".select2").select2({
                                    width: "100%",
                                    placeholder: "-- Pilih Product --",
                                    allowClear: true,
                                    minimumResultsForSearch: 0,
                                    dropdownParent: $("#ModalInsert")
                                });
                            });

                            renumberRows();
                        }

                        recalcTotal();

                        $("#defferedAmmortizeLabel").text("Edit Purchase Order")
                        let modal = new bootstrap.Modal(document.getElementById('ModalInsert'));
                        modal.show();
                        $("#FormAction").val(2)
                    } else {
                        SweetAlertError('Not Found', 'Purchase Order data could not be found.');
                    }
                },
                error: function () {
                    SweetAlertError('Error', 'Failed to load Purchase Order data. Please try again.');
                }
            });

        });

        // ============ DELETE ============

        $('.datatables-custom').on('click', '.delete-record', function () {
            if ($('#PageDelete').val() == 1) {
                const code = $(this).data('code');
                SweetAlertConfirm(
                    'Delete Confirmation',
                    'Are you sure you want to delete this data, Purchase Order No:' + code,
                    function () {
                        var a = document.getElementById('loading');
                        a.style.display = "block";
                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("Delete", "PurchaseOrder", new { Area = "Employee" })',
                            data: {
                                "DataModal":{
                                    "POHNo":code,
                                }
                            },
                            dataType: 'JSON',
                            success: function (respond) {
                                a.style.display = "none";
                                if(respond.success==1){
                                    table=getData();
                                    SweetAlertSuccess('Success!', respond.msg);
                                }
                                else if(respond.success==0){
                                    SweetAlertError('Failed!', respond.msg);
                                }
                                else{
                                    table=getData();
                                    SweetAlertSuccess('Success!', respond.msg);
                                }
                            },
                            error: function (respond, xhr, msg) {
                                a.style.display = "none";
                                SweetAlertError('Failed!', respond);
                            }
                        })
                    }
                );
            }
        });

        // ============ SAVE ============

        $("#btnAddNew").on('click', function () {
            ClearModal();
            $("#defferedAmmortizeLabel").text("Add Purchase Order");
            $("#POHNo").prop("disabled", false);
            $("#FormAction").val(1);
        });

        function GetPODetail() {
            let result = [];

            $("#tablePOList tbody tr").each(function (index) {
                let row = $(this);

                let prodCode = row.find(".prod-select").val();
                let uom = row.find(".uom-input").val()?.trim();
                let qty = row.find(".qty-input").val()?.trim();
                let price = row.find(".price-input").val()?.trim();

                if (!prodCode || !qty) return;

                result.push({
                    SeqNo: index + 1,
                    ProdCode: prodCode,
                    UOM: uom,
                    Qty: parseNumber(qty),
                    Price: parseNumber(price)
                });
            });


            return result;
        }

        $('#btnSave').on('click', function () {
            if ($('#PageInsert').val() == 1) {

                const code = $("#POHNo").val();
                const podate = $("#POHDate").val();
                const branch = $("#BranchCode").val();
                const supplier = $("#Supplier").val();
                var resDetail = GetPODetail();
                if (
                    podate == null || podate === "" ||
                    branch == null || branch === "" ||
                    supplier == null || supplier === "" ||
                    resDetail.length === 0
                ) {
                    SweetAlertError('Failed!', "PO Date, Branch, Supplier and at least 1 Item Detail are Mandatory!");
                    return false;
                }

                SweetAlertConfirm(
                    'Confirmation',
                    'Are you sure you want to Save this data, PO No: ' + code,
                    function () {

                        var a = document.getElementById('loading');
                        a.style.display = "block";

                        // Data utama
                        var ajaxData = {
                            "dataModal.POHNo": code,
                            "dataModal.POHDate": podate,
                            "dataModal.BranchCode": branch,
                            "dataModal.Supplier": supplier,
                            "dataModal.Remark": $("#Remark").val(),
                            "dataModal.Status": 0,
                            "FormAction": $("#FormAction").val()
                        };

                        // Data detail untuk model binder ASP.NET MVC
                        resDetail.forEach(function (item, index) {
                            ajaxData[`dataModal.PODetail[${index}].SeqNo`] = item.SeqNo;
                            ajaxData[`dataModal.PODetail[${index}].ProdCode`] = item.ProdCode;
                            ajaxData[`dataModal.PODetail[${index}].UOM`] = item.UOM;
                            ajaxData[`dataModal.PODetail[${index}].Qty`] = item.Qty;
                            ajaxData[`dataModal.PODetail[${index}].Price`] = item.Price;
                        });


                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("Create", "PurchaseOrder", new { Area = "Employee" })',
                            data: ajaxData,
                            dataType: "json",

                            success: function (respond) {
                                a.style.display = "none";
                                if (respond.success == 1) {
                                    table = getData();

                                    SweetAlertSuccess('Success!', respond.msg);

                                    $("#FormAction").val('2');
                                    $("#POHNo").prop("disabled", true);
                                    $("#BranchCode").prop("disabled", true);
                                    $("#POHNo").val(respond.sno)
                                    $("#defferedAmmortizeLabel").text("Edit Purchase Order");
                                }
                                else if (respond.success == 0) {
                                    SweetAlertError('Failed!', respond.msg);
                                }
                                else {
                                    table = getData();

                                    SweetAlertSuccess('Success!', respond.msg);

                                    $("#FormAction").val('2');
                                    $("#POHNo").prop("disabled", true);
                                    $("#BranchCode").prop("disabled", true);
                                    $("#POHNo").val(respond.sno)
                                    $("#defferedAmmortizeLabel").text("Edit Purchase Order");
                                }
                            },

                            error: function (xhr, status, error) {
                                a.style.display = "none";

                                console.error("AJAX Error:", error);
                                console.error("Response:", xhr.responseText);

                                SweetAlertError('Failed!', "Failed to save data.");
                            }
                        });
                    }
                );
            }
        });

        function ClearModal() {
            $("#ModalInsert")
                .find("input[type='text'], textarea")
                .val("");
            $("#POHNo").val("")
            $("#Supplier").val("");
            $("#Remark").val("");
            $("#Status").val("0");
            $("#BranchCode").val(defaultBranch).trigger('change');
            $("#BranchCode").prop("disabled", false);
            $("#tablePOList tbody").empty();
            recalcTotal();

        }

        function AddCommaDecimal(numb) {

            if (numb === null || numb === undefined || numb === "") {
                return "-";
            }

            let num = parseFloat(numb.toString().replace(/,/g, ""));

            if (isNaN(num)) return "-";

            // Jika bilangan bulat → tanpa decimal
            if (Number.isInteger(num)) {
                return num.toLocaleString("en-US");
            }

            // Jika ada pecahan → max 2 decimal, tanpa .00
            return num.toLocaleString("en-US", {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            });
        }

    </script>
}
