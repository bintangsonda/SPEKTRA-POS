  public class ReportScript
  {
    decimal debit;
    decimal credit;
    
    private void Data1_BeforePrint(object sender, EventArgs e)
    {
      if ((decimal)Report.GetColumnValue(&quot;GLRepTransByAccCashBasis.AMT&quot;) &gt; 0){
        credit = (decimal)Report.GetColumnValue(&quot;GLRepTransByAccCashBasis.AMT&quot;);
        debit = 0;
      }  
      else{
        debit = (decimal)Report.GetColumnValue(&quot;GLRepTransByAccCashBasis.AMT&quot;) * -1;
        credit = 0;
      }  
    }
  }
}
