using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {
    decimal endingBalance;

    private void Data1_BeforePrint(object sender, EventArgs e)
    {
      decimal begbalVar = (decimal)Report.GetColumnValue(&quot;GLRepSummTrialBal.begbal&quot;);
      decimal debitVar = (decimal)Report.GetColumnValue(&quot;GLRepSummTrialBal.debit&quot;);
      decimal creditVar = (decimal)Report.GetColumnValue(&quot;GLRepSummTrialBal.Credit1&quot;);
      endingBalance = begbalVar + debitVar - creditVar;
    }
  }
}
