namespace FastReport
{
  public class ReportScript
  {
    decimal debit;
    decimal credit;
    
    private void Data1_BeforePrint(object sender, EventArgs e)
    {
      if ((decimal)Report.GetColumnValue(&quot;GLRepTransByAcc.AMT&quot;) &gt; 0){
        debit = (decimal)Report.GetColumnValue(&quot;GLRepTransByAcc.AMT&quot;);
        credit = 0;
      }  
      else{
        credit = (decimal)Report.GetColumnValue(&quot;GLRepTransByAcc.AMT&quot;) * -1;
        debit = 0;
      }  
    }
  }
}
</ScriptText>
