<Report ScriptLanguage="CSharp" ReportInfo.Created="10/20/2025 10:43:38" ReportInfo.Modified="10/28/2025 08:35:32" ReportInfo.CreatorVersion="2025.2.0.0">
  <ScriptText>using System;
using System.Collections;
using System.Collections.Generic;
using System.ComponentModel;
using System.Windows.Forms;
using System.Drawing;
using System.Data;
using FastReport;
using FastReport.Data;
using FastReport.Dialog;
using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {
    int currentPage=1;
    int totalPage=1;
    
    decimal C1CurrentAmt = 0;
    decimal C2CurrentAmt = 0;
    decimal C3CurrentAmt = 0;
    decimal C4CurrentAmt = 0;
    decimal C5CurrentAmt = 0;
    decimal C6CurrentAmt = 0;
    decimal C7CurrentAmt = 0;
    decimal mCurrentAmt = 0;
    
    decimal C1CurrentAmtPrev = 0;
    decimal C2CurrentAmtPrev = 0;
    decimal C3CurrentAmtPrev = 0;
    decimal C4CurrentAmtPrev = 0;
    decimal C5CurrentAmtPrev = 0;
    decimal C6CurrentAmtPrev = 0;
    decimal C7CurrentAmtPrev = 0;
    decimal mCurrentAmtPrev = 0;
    
    private void Data1_BeforePrint(object sender, EventArgs e) //Hitungan Income Statement
    {
      if(!Report.Engine.FinalPass){
        return;
      }
      
      decimal fromacc = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStat.fromacc&quot;));
      
      decimal CBegBal = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStat.CBegBal&quot;));
      decimal CDebit = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStat.CDebit&quot;));
      decimal CCredit = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStat.CCredit&quot;));
      
      decimal pBegbal = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStat.pBegbal&quot;));
      decimal pDebit = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStat.pDebit&quot;));
      decimal pCredit = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStat.pCredit&quot;));
      
      decimal multiply = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStat.multiply&quot;));
      decimal divide = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStat.divide&quot;));
      int dbtcrd = Convert.ToInt32(Report.GetColumnValue(&quot;GLRepIncomeStat.dbtcrd&quot;));
      
      decimal formula = 0;
      decimal formulaPrev = 0;
      
      switch ((int)fromacc)
      {
        case 8:
          formula = CDebit + CCredit;
          if (dbtcrd == 1) formula *= -1;
          formula *= (multiply / divide);
          mCurrentAmt = formula;
          
          formulaPrev = CBegBal + CDebit + CCredit;
          if (dbtcrd == 1) formulaPrev *= -1;
          formulaPrev *= (multiply / divide);
          mCurrentAmtPrev = formulaPrev;
         
          break;
        case 7: mCurrentAmt = C7CurrentAmt; mCurrentAmtPrev = C7CurrentAmtPrev; break;
        case 6: mCurrentAmt = C6CurrentAmt; mCurrentAmtPrev = C6CurrentAmtPrev; break;
        case 5: mCurrentAmt = C5CurrentAmt; mCurrentAmtPrev = C5CurrentAmtPrev; break;
        case 4: mCurrentAmt = C4CurrentAmt; mCurrentAmtPrev = C4CurrentAmtPrev; break;
        case 3: mCurrentAmt = C3CurrentAmt; mCurrentAmtPrev = C3CurrentAmtPrev; break;
        case 2: mCurrentAmt = C2CurrentAmt; mCurrentAmtPrev = C2CurrentAmtPrev; break;
        case 1: mCurrentAmt = C1CurrentAmt; mCurrentAmtPrev = C1CurrentAmtPrev; break;
      }
      
      UpdateAmount(&quot;C1&quot;, ref C1CurrentAmt);
      UpdateAmount(&quot;C2&quot;, ref C2CurrentAmt);
      UpdateAmount(&quot;C3&quot;, ref C3CurrentAmt);
      UpdateAmount(&quot;C4&quot;, ref C4CurrentAmt);
      UpdateAmount(&quot;C5&quot;, ref C5CurrentAmt);
      UpdateAmount(&quot;C6&quot;, ref C6CurrentAmt);
      UpdateAmount(&quot;C7&quot;, ref C7CurrentAmt);
      
      UpdateAmountPrev(&quot;C1&quot;, ref C1CurrentAmtPrev);
      UpdateAmountPrev(&quot;C2&quot;, ref C2CurrentAmtPrev);
      UpdateAmountPrev(&quot;C3&quot;, ref C3CurrentAmtPrev);
      UpdateAmountPrev(&quot;C4&quot;, ref C4CurrentAmtPrev);
      UpdateAmountPrev(&quot;C5&quot;, ref C5CurrentAmtPrev);
      UpdateAmountPrev(&quot;C6&quot;, ref C6CurrentAmtPrev);
      UpdateAmountPrev(&quot;C7&quot;, ref C7CurrentAmtPrev);
    }
    
    private void UpdateAmount(string colName, ref decimal target)
    {
      var flag = Report.GetColumnValue(&quot;GLRepIncomeStat.&quot; + colName);
      if (flag == null) return;

      string val = flag.ToString();
      if (val == &quot;+&quot;) target += mCurrentAmt;
      else if (val == &quot;-&quot;) target -= mCurrentAmt;
      else if (val == &quot;0&quot;) target = 0;
    }
    
    private void UpdateAmountPrev(string colName, ref decimal target)
    {
      var flag = Report.GetColumnValue(&quot;GLRepIncomeStat.&quot; + colName);
      if (flag == null) return;

      string val = flag.ToString();
      if (val == &quot;+&quot;) target += mCurrentAmtPrev;
      else if (val == &quot;-&quot;) target -= mCurrentAmtPrev;
      else if (val == &quot;0&quot;) target = 0;
    }
    
    private void Text45_BeforePrint(object sender, EventArgs e) //Tambah border tergantung kondisi
    {
      
      decimal fromacc = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStat.fromacc&quot;));
      string Descrip = Convert.ToString(Report.GetColumnValue(&quot;GLRepIncomeStat.Descrip&quot;));
      string genAcc = Convert.ToString(Report.GetColumnValue(&quot;GLRepIncomeStat.genAcc&quot;));
      
      var txt = sender as TextObject;
      if(fromacc==0 || Descrip==null || Descrip==&quot;&quot;){
        txt.TextColor = System.Drawing.Color.White;
      }else{
        txt.TextColor = System.Drawing.Color.Black;
      }
      
      if(genAcc==&quot;XX&quot;){
        txt.Border.Lines = BorderLines.Top;
        txt.Border.Color = System.Drawing.Color.Black;
        txt.Border.Width = 1;
        txt.Border.TopLine.Style = LineStyle.Solid;
      }
      else if(genAcc==&quot;YY&quot;){
        txt.Border.Lines = BorderLines.Bottom;
        txt.Border.Color = System.Drawing.Color.Black;
        txt.Border.Width = 1;
        txt.Border.BottomLine.Style = LineStyle.Double;
      }
      else{
        txt.Border.Lines = BorderLines.None;
        txt.Border.Width = 0;
      }
     
    }
    
  }
}
</ScriptText>
