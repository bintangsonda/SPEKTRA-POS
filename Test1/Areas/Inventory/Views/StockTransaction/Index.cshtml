@model SPOS.Inventory.Stock.StockTransactionH  
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Stock Transaction";
}
@section Styles {
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/select2/select2.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/flatpickr/flatpickr.css" />
    <link rel="stylesheet" href="~/assets/css/custom.css" />

}

@Html.Hidden("PageEdit", Convert.ToInt32(ViewData["Page.Edit"]))
@Html.Hidden("PageDelete", Convert.ToInt32(ViewData["Page.Delete"]))
@Html.Hidden("PageInsert", Convert.ToInt32(ViewData["Page.Insert"]))
@Html.Hidden("FormAction", Convert.ToInt32(ViewData["FormAction"]))

<!--Table Data-->
<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center">
            <i class="ri ri-restaurant-2-line me-2 text-primary" style="font-size: 1.5rem;"></i>
            <h4 class="card-title mb-0 fw-semibold text-primary">
                @ViewBag.Title
            </h4>
        </div>
    </div>
    <div class="card">
        <div class="card-header border-bottom">
            <div class="row g-2 align-items-end">

                <!-- Date From -->
                <div class="col-sm-2">
                     <div class="form-floating form-floating-outline">
                    @Html.TextBox(
                        "FromDate",
                        new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1)
                                .ToString("dd/MMM/yyyy", System.Globalization.CultureInfo.InvariantCulture),
                            new {
                                id = "DateFrom",
                                @class = "form-control form-control-sm",
                                type = "text",
                                placeholder = "dd/mmm/yyyy"
                        }
                    )
                    <label for="DateFrom">From</label>
                </div>
                </div>

                <!-- Date To -->
                <div class="col-sm-2">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBox(
                        "ToDate",
                        DateTime.Now.ToString("dd/MMM/yyyy", System.Globalization.CultureInfo.InvariantCulture),
                        new {
                            id = "DateTo",
                            @class = "form-control form-control-sm",
                            type = "text",
                            placeholder = "dd/mmm/yyyy"
                        }
                    )
                    <label for="DateTo">To</label>

                    </div>
                </div>

                <!-- Cabang -->
                <div class="col-sm-4">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownList(
                            "Cabang",
                            ViewData["SelectListBranchCode"] as SelectList,
                            "All",
                            new { @class = "form-control form-control-sm select2" }
                        )
                        <label for="Cabang">Cabang</label>
                    </div>
                </div>

                <!-- Search -->
                <div class="col-sm-1 d-flex justify-content-start align-items-center">
                    <button type="button"
                            class="btn btn-primary d-flex align-items-center px-3 py-2"
                            onclick="getData()">
                        <i class="ri ri-search-line icon-18px"></i>
                    </button>
                </div>
                </div>
                </div>
        <div class="card-datatable">
            <table id="tableData" class="datatables-custom table table-responsive table-sm w-100">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>Trans No</th>
                        <th>Trans Code</th>
                        <th>Trans Date</th>
                        <th>Outlet</th>
                        <th>Status</th>
                        <th>Status Date</th>
                        <th>Operator ID</th>
                        <th>Last Update</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<!--Table Data-->







<!-- Loading Page -->
<div id="loading" style="display:none; height:100%; width:100%">
    <div class="loading-wave" id="loading-content">
        <div class="loading-bar"></div>
        <div class="loading-bar"></div>
        <div class="loading-bar"></div>
        <div class="loading-bar"></div>
    </div>
    <div class="loading loading07">
        <span data-text="S">S</span>
        <span data-text="P">P</span>
        <span data-text="E">E</span>
        <span data-text="K">K</span>
        <span data-text="T">T</span>
        <span data-text="R">R</span>
        <span data-text="A">A</span>
    </div>
</div>
<!-- Loading Page -->

<div id="PartialSection">
</div>


@section Scripts {
    <script src="~/assets/vendor/libs/moment/moment.js"></script>
    <script src="~/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/assets/vendor/libs/select2/select2.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/popular.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/bootstrap5.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/auto-focus.js"></script>
    <script src="~/assets/vendor/libs/cleave-zen/cleave-zen.js"></script>
    <script src="~/assets/js/forms-selects.js"></script>
    <script src="~/assets/vendor/libs/tagify/tagify.js"></script>
    <script src="~/assets/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
    <script src="~/assets/vendor/libs/typeahead-js/typeahead.js"></script>
    <script src="~/assets/vendor/libs/bloodhound/bloodhound.js"></script>
    <script src="~/assets/vendor/libs/flatpickr/flatpickr.js"></script>
    <script type="text/javascript">
        const token = $('input[name="__RequestVerificationToken"]').val();
        const getDataUrl = '@Url.Action("GetData", "StockTransaction", new { area = "Inventory" })';

        var table = null;
        var nilaiTampung = "";
        $('.select2').select2();

        $(document).ready(function () {
            flatpickr("#DateFrom,#DateTo", {
                   dateFormat: "d/M/Y",
                    disableMobile: true,
                    static: true,
            });
            flatpickr("#TransDate", {
                   dateFormat: "d/M/Y",
                    disableMobile: true,
                    static: true,
            });

            table=getData();
            if ($('#PageInsert').val() == 0) {
                $('.AddNew').prop('disabled', true);
            }
        });

        function getData() {
            return $('#tableData').DataTable({
                bDestroy: true,
                processing: true,
                serverSide: true,
                "bAutoWidth": true,
                scrollX: true,
                ajax: {
                    url: getDataUrl,
                    type: 'POST',
                    dataType: "JSON",
                    data:{
                        DateFromSelected: $('#DateFrom').val(),
                        DateToSelected: $('#DateTo').val(),
                        Branch: $('#Cabang').val(),
                    },
                },
                columns: [
                    { "data": 'action', "name": 'action', orderable: false },
                    { "data": "TransNo", "name": "TransNo" },
                    { "data": "TransCode", "name": "TransCode" },
                    {
                        "data": "TransDate", "name": "TransDate",
                        "render": function (data, type, row, meta) {
                            return moment(row.TransDate).format('DD/MMM/YYYY');
                            }
                    },
                    { "data": "BranchCode", "name": "BranchCode" },
                    { "data": "Process", "name": "Process"},
                    {
                        "data": "ProcessDate", "name": "ProcessDate",
                        "render": function (data, type, row, meta) {
                            return moment(row.ProcessDate).format('DD/MMM/YYYY');
                        }
                    },
                    { "data": "OperatorID", "name": "OperatorID" },
                    {
                        "data": "LastUpdate", "name": "LastUpdate",
                        "render": function (data, type, row, meta) {
                            return moment(row.LastUpdate).format('DD/MMM/YYYY');
                        }
                    },
                ],
                columnDefs: [
                    {
                        targets: [0],
                        title: 'Actions',
                        searchable: false,
                        orderable: false,
                        render: (data, type, full, meta) => {
                            return `
                        <div class="d-flex align-items-center">
                            <a href="javascript:;"
                                class="btn btn-icon btn-text-danger rounded-pill delete-record"
                                data-code="${full.TransNo}">
                                <i class="icon-base ri ri-delete-bin-7-line icon-md text-danger"></i>
                            </a>
                            <a href="javascript:;"
                               class="btn btn-icon btn-text-warning rounded-pill edit-record"
                               data-code="${full.TransNo}">
                                <i class="icon-base ri ri-pencil-line icon-md text-warning"></i>
                            </a>

                          
                        </div>
                    `;
                        }
                    },
                    {
                        "targets": [1]
                    },
                    {
                        "targets": [2]
                    },
                    {
                        "targets": [3]
                    },
                    {
                        "targets": [4]
                    },
                    {
                        "targets": [5]
                    },
                    {
                        "targets": [6]
                    },
                    {
                        "targets": [7]
                    },
                    {
                        "targets": [8]
                    },
                ],
                select: {
                    style: 'os',
                },
                order: [[2, 'desc']],
                layout: {
                    topStart: {
                        rowClass: 'row m-2 my-0 mt-0 justify-content-between',
                        features: [
                            {
                                pageLength: {
                                    menu: [[1, 10, 25, 50, 100, 1000, -1], [1, 10, 25, 50, 100, 1000, "All"]],
                                    text: 'Show _MENU_ entries'
                                }
                            },
                        ]
                    },
                    topEnd: {
                        features: [
                            {
                                buttons: [
                                    {
                                        text: `
                                            <i class="icon-base ri ri-add-line icon-sm me-0 d-inline-block"></i>
                                            <span class="d-none d-sm-inline-block">Add</span>
                                        `,
                                        className: 'btn add-new me-2 d-flex align-items-center',  // 🔥 warna + jarak kanan + center
                                        action: function (e, dt, node, config) {
                                                      window.location.href = '@Url.Action("Create", "StockTransaction", new { area = "Inventory" })';

                                        }
                                    }
                                ]
                            },

                       
                            {
                                search: {
                                    placeholder: 'Search User',
                                    text: '_INPUT_'
                                }
                            },

                        ]
                    },
                    bottomStart: {
                        rowClass: 'row mx-3 justify-content-between',
                        features: ['info']
                    },
                    bottomEnd: 'paging'
                },
                language: {
                    paginate: {
                        next: '<i class="icon-base ri ri-arrow-right-s-line scaleX-n1-rtl icon-22px"></i>',
                        previous: '<i class="icon-base ri ri-arrow-left-s-line scaleX-n1-rtl icon-22px"></i>',
                        first: '<i class="icon-base ri ri-skip-back-mini-line scaleX-n1-rtl icon-22px"></i>',
                        last: '<i class="icon-base ri ri-skip-forward-mini-line scaleX-n1-rtl icon-22px"></i>'
                    }
                },


            });


        }

        $('.datatables-custom').on('click', '.edit-record', function () {
            const code = $(this).data('code');
             $.ajax({
                type: 'GET',
                url: '@Url.Action("Edit", "StockTransaction", new { Area = "Inventory" })',
                data: { CategoryCode: code },
                success: function (data) {
                    SweetAlertClose(); 
                    if (data) {
                        $("#CategoriesName").val(data.CategoriesName)
                        $("#CategoriesCode").prop("disabled",true)
                        $("#CategoriesCode").val(code)
                        $("#defferedAmmortizeLabel").text("Edit Stock Transaction")
                        let modal = new bootstrap.Modal(document.getElementById('ModalInsert'));
                        modal.show();
                        $("#FormAction").val(2)
                    } else {
                        SweetAlertError('Not Found', 'Category data could not be found.');
                    }
                },
                error: function () {
                    SweetAlertError('Error', 'Failed to load Category data. Please try again.');
                }
            });
            
        });

        $('.datatables-custom').on('click', '.delete-record', function () {
            if ($('#PageDelete').val() == 1) {
                const code = $(this).data('code');
                SweetAlertConfirm(
                    'Delete Confirmation',
                    'Are you sure you want to delete this data, Trans No:' + code,
                    function () {
                        var a = document.getElementById('loading');
                        a.style.display = "block";
                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("Delete", "Stock Transaction", new { Area = "Inventory" })',
                            data: {
                                "DataModal":{
                                    "CategoriesCode":code,
                                }
                            },
                            dataType: 'JSON',
                            success: function (respond) {
                                a.style.display = "none";
                                console.log(respond.success)
                                if(respond.success==1){
                                    table=getData();
                                    SweetAlertSuccess('Success!', respond.msg);
                                }
                                else if(respond.success==0){
                                    SweetAlertError('Failed!', respond.msg);
                                }
                                else{
                                    table=getData();
                                    SweetAlertSuccess('Success!', respond.msg);
                                }
                            },
                            error: function (respond, xhr, msg) {
                                a.style.display = "none";
                                SweetAlertError('Failed!', respond);
                            }
                        })
                    }
                );
            }
        });

        $("#btnAddNew").on('click',function(){
            ClearModal();
            $("#defferedAmmortizeLabel").text("Add Stock Transaction")
            $("#CategoriesCode").prop("disabled",false)
            $("#FormAction").val(1)
        })

        $('#btnSave_Deffered').on('click',function(){
            if ($('#PageInsert').val() == 1) {
                const code = $("#CategoriesCode").val();
                const name = $("#CategoriesName").val();
                const branch=$("#BranchCode").val();
                if(code==null||name==null){
                    SweetAlertError('Failed!', "Category Name & Category Code is Mandatory!");
                    return false;
                }
                SweetAlertConfirm(
                    'Confirmation',
                    'Are you sure you want to Save this data, Transaction No:' + code,
                    function () {
                        var a = document.getElementById('loading');
                        a.style.display = "block";
                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("Create", "StockTransaction", new { Area = "Inventory" })',
                            data: {
                                "dataModal": {
                                    CategoriesCode: code,
                                    CategoriesName:name,
                                },
                                FormAction:$("#FormAction").val(),
                            },
                            dataType: 'JSON',
                            success: function (respond) {
                                a.style.display = "none";
                                if(respond.success==1){
                                    table=getData();
                                    SweetAlertSuccess('Success!', respond.msg);
                                    $("#FormAction").val('2');
                                    $("#CategoriesCode").prop("disabled",true)
                                    $("#defferedAmmortizeLabel").text("Edit Stock Transaction")
                                }
                                else if(respond.success==0){
                                    SweetAlertError('Failed!', respond.msg);
                                }
                                else{
                                    table=getData();
                                    SweetAlertSuccess('Success!', respond.msg);
                                     $("#FormAction").val('2');
                                    $("#CategoriesCode").prop("disabled",true)
                                    $("#defferedAmmortizeLabel").text("Edit Stock Transaction")
                                }
                            },
                            error: function (respond, xhr, msg) {
                                a.style.display = "none";
                                SweetAlertError('Failed!', respond.msg);
                            }
                        })
                    }
                );
            }
        });

        function ClearModal() {
            $("#ModalInsert")
                .find("input[type='text'], textarea, select")
                .val("");
        }



    </script>
}
