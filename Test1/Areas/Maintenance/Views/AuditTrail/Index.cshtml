@model IEnumerable<IDS.Maintenance.AuditTrail>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Audit Trail";
}
@{
    var fromDate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, 1).ToString("dd MMM yyyy");
    var toDate = DateTime.Now.ToString("dd MMM yyyy");
}


@section Styles {
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/flatpickr/flatpickr.css" />
    @* <link rel="stylesheet" type="text/css" href="~/Content/loader.css" /> *@
    <style>
        .daterangepicker,
        .flatpickr-calendar {
            z-index: 999999 !important;
        }

        .select2-container {
            z-index: 999999 !important;
        }
        .modal-body p {
            font-size: 11px;
        }

        .h6 {
            font-size: 12px;
        }

        table.table.dataTable > tbody > tr {
            background-color: transparent;
            font-size: 11px;
        }

        .datatables-users thead th {
            font-weight: bold;
            font-size: 11px;
        }

        .datatables-users th,
        .datatables-users td {
            padding-top: 3px;
            padding-bottom: 3px;
            padding-left: 12px;
            padding-right: 12px;
            font-size: 12px;
            vertical-align: middle; /* supaya teks tidak nempel atas */
        }

        div.dt-search input {
            margin-right: 1rem !important;
        }
    </style>
}
<div id="loading" style="display:none; height:100%; width:100%">
    <div class="loading-wave " id="loading-content">
        <div class="loading-bar"></div>
        <div class="loading-bar"></div>
        <div class="loading-bar"></div>
        <div class="loading-bar"></div>
    </div>
    <div class="loading loading07">
        <span data-text="I">I</span>
        <span data-text="N">N</span>
        <span data-text="T">T</span>
        <span data-text="I">I</span>
        <span data-text="D">D</span>
        <span data-text="A">A</span>
        <span data-text="T">T</span>
        <span data-text="A">A</span>
    </div>
</div>



<div class="container-xxl flex-grow-1 container-p-y">
    <!-- Users List Table -->
    <div class="card">
        <div class="card-header border-bottom">
            <h5 class="card-title mb-0">Audit Trail</h5>
            <p class="mt-1">Data from @fromDate until @toDate. Click Filter above to filter data.</p>
        </div>
        <div class="card-datatable">
            <table id="tableData" class="datatables-users table table-sm">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Updated By</th>
                        <th>Affected Data</th>
                        <th>Operation</th>
                        <th>Key</th>
                        <th>Timestamp</th>
                        <th>Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
       
    </div>
</div>
