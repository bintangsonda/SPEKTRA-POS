                                    </td>
                                    <td>
                                        <input type="text"
                                               class="form-control form-control-sm ${satuanClass}"
                                               disabled>
                                    </td>
                                    <td class="text-center">
                                        <button type="button"
                                                class="btn btn-sm btn-danger ${deleteClass} p-1 px-2">
                                            <i class="ri ri-delete-bin-line icon-18px"></i>
                                        </button>
                                    </td>
                                </tr>
                            `);

                            tbody.append(row);
                        });

                        if (!products.length) return;

                        // Ambil produk berdasarkan Branch
                        $.ajax({
                            url: '@Url.Action("GetDataProduct", "Product")',
                            type: "GET",
                            data: {
                                Branch: data.Branch || outlet
                            },
                            success: function (response) {
                                tbody.find("tr").each(function (index) {
                                    const row = $(this);
                                    const item = products[index];
                                    const select = row.find("." + selectClass);

                                    select.empty();
                                    select.append(
                                        new Option("-- Pilih ProdCode --", "")
                                    );

                                    $.each(response, function (i, product) {
                                        const fullText =
                                            product.text ?? product.Text ?? "";

                                        const parts = fullText.split(" - ");

                                        const prodName = parts[0];

                                        const uom = parts.length > 1
                                            ? parts.slice(1).join(" - ")
                                            : "";

                                        const option = new Option(
                                            prodName,
                                            product.value ?? product.Value
                                        );

                                        option.setAttribute("data-uom", uom);
                                        select.append(option);
                                    });

                                    select.select2({
                                        placeholder: "-- Pilih ProdCode --",
                                        allowClear: true,
                                        width: "100%",
                                        dropdownParent: $("#ModalInsert")
                                    });

                                    // Pilih produk yang tersimpan
                                    select.val(item.ProdCode).trigger("change");
                                });
                            },
                            error: function (xhr) {
                                console.error(xhr.responseText);
                                SweetAlertError(
                                    "Failed!",
                                    "Gagal mengambil data product."
                                );
                            }
                        });
                    }

                    // 5. ISI PRODUK ONLINE
                    loadProductRows(data.ProdukOnline || [], "online");

                    // 6. ISI PRODUK OFFLINE
                    loadProductRows(data.ProdukOffline || [], "offline");

                    // 7. TAMPILKAN MODAL EDIT
                    $("#defferedAmmortizeLabel").text("Edit Product");
                    $("#FormAction").val(2);

                    const modalElement = document.getElementById("ModalInsert");
                    bootstrap.Modal.getOrCreateInstance(modalElement).show();
