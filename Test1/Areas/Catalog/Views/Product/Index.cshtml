                                    $("#FormAction").val('2');
                                    
                                    $("#ProdCode").prop("disabled",true)
                                    $("#Branch").prop("disabled",true)
                                    $("#defferedAmmortizeLabel").text("Edit Product")
                                     //buat munculin gambar
                                    let foldername =code+'-'+outlet;
                                    let fileName = $("#ImageFile")[0].files[0].name;
                                    let ext = fileName.substring(fileName.lastIndexOf('.'));
                                    let fileNameDoubleExt = fileName + ext;

                                    if (fileName) {

                                        let imageUrl = `../..../../Uploads/ProductIMG/${foldername}/${fileNameDoubleExt}`;

                                        // preview card product
                                        $("#PreviewImage")
                                            .attr("src", imageUrl)
                                            .show();
                                    } else {
                                        // kalau ga ada gambar
                                        $("#PreviewImage").attr("src", "");
                                    }
                                    //buat munculin gambar
                                }
                                else if(respond.success==0){
                                    SweetAlertError('Failed!', respond.msg);
                                }
                                else{
                                    table=getData();
                                    SweetAlertSuccess('Success!', respond.msg);
                                     $("#FormAction").val('2');
                                    
                                    $("#ProdCode").prop("disabled",true)
                                    $("#Branch").prop("disabled",true)
                                    $("#defferedAmmortizeLabel").text("Edit Product")
                                }
                            },
                            error: function (respond, xhr, msg) {
                                a.style.display = "none";
                                SweetAlertError('Failed!', respond.msg);
                            }
                        })
                    }
                );
            }
        });

        function ClearModal() {
            $("#ModalInsert")
                .find("input[type='text'], textarea")
                .val("");
            $("#PreviewName").text("Nama Produk");
            $("#PreviewDesc").text("Description Produk");
            $("#productCode").val("")
            $("#OutletFrom").val("").select2()
            $("#OutletTo").val("").select2()
            $("#ImageFile").val("");
            $("#previewImageUpload").attr("src", "").hide();  
            $("#PreviewImage").attr("src", "");
             $("#tableVarianList tbody").empty();
             $("#tableOnlineList tbody").empty();
             $("#tableOfflineList tbody").empty();
             hargaIndex=1;
        }

        function GetVarianProduct() {
            let result = [];

            $("#tableVarianList tbody tr").each(function () {
               let nama = $(this).find("td:nth-child(2) select").val()?.trim();

                // skip baris yang kosong
                if (!nama) return;

          
                result.push({
                    VarianCode: nama,
                });

            });

            return result;
        }

        function GetOnlineProduct() {
            let result = [];

            $("#tableOnlineList tbody tr").each(function () {
                let productcode = $(this).find(".prodcode-online").val();
                let productqty = $(this).find(".qty-online").val();

                // Skip baris jika ProdCode atau Qty kosong
                if (!productcode || !productqty) return;

                result.push({
                    ProdCode: productcode,
                    Qty: parseFloat(productqty),
                    On_Off: "ON"
                });
            });

            return result;
        }
         function GetOfflineProduct() {
            let result = [];

            $("#tableOfflineList tbody tr").each(function () {
                let productcode = $(this).find(".prodcode-offline").val();
                let productqty = $(this).find(".qty-offline").val();

                // Skip baris jika ProdCode atau Qty kosong
                if (!productcode || !productqty) return;

                result.push({
                    ProdCode: productcode,
                    Qty: parseFloat(productqty),
                    On_Off: "OFF"
                });
            });

            return result;
        }

    </script>
}
