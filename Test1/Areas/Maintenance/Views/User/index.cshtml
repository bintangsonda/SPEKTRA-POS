    <div class="row align-items-center mb-4">
        <div class="col d-flex align-items-center">
            <i class="ri ri-user-3-line me-2 text-primary" style="font-size: 1.5rem;"></i>
            <h4 class="card-title mb-0 fw-semibold text-primary">
                @ViewBag.Title
            </h4>
        </div>
        <div class="col-auto ms-auto">
            <button id="btnAddNewUser" class="btn btn-primary">
                <i class="ri ri-add-line me-1"></i>
                <span class="d-none d-sm-inline-block">Add New User</span>
            </button>
        </div>
    </div>
  
    

    <!-- Users List Table -->
    <div class="card">
        <div class="card-header border-bottom d-flex align-items-center gap-12 flex-wrap">
            <h5 class="card-title mb-0 d-flex align-items-center">
                <i class="ri ri-filter-line me-2"></i>
                Filter
            </h5>

            <div class="form-floating form-floating-outline" style="width: 220px;">
                @Html.DropDownList(
                         "BranchList",
                         (SelectList)ViewData["listBranch"],
                         new { @id = "cboBranchss", @class = "form-select form-select-sm select2" }
                         )
                <label for="cboBranchss">User Branch</label>
            </div>
        </div>

        <div class="card-datatable">
            <table id="tableData" class="datatables-users table table-responsive table-sm w-100">
                <thead>
                    <tr>
@*                         <th></th>
 *@                        <th>User ID</th>
@*                         <th>User Name</th>
 *@                        <th>Email</th>
                        <th>Role</th>
                        <th>Branch</th>
                        <th>Accum</th>
                        <th>Status</th>
                        <th>Entry Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
        <div class="offcanvas offcanvas-end"
             tabindex="-1"
             id="offcanvasAddUser"
             aria-labelledby="offcanvasAddUserLabel">
            <div class="offcanvas-header border-bottom">
                <h5 id="offcanvasAddUserLabel" class="offcanvas-title">Add User</h5>
                <button type="button"
                        class="btn-close text-reset"
                        data-bs-dismiss="offcanvas"
                        aria-label="Close"></button>
            </div>
            <div class="offcanvas-body mx-0 flex-grow-0 h-100">
                @using (Html.BeginForm(null, null, FormMethod.Get, new { @id = "formCreateEdit" }))
                {
                    @Html.Hidden("FormAction", Convert.ToInt32(ViewData["FormAction"]))
                    @Html.Hidden("FormSave", "0")
                    
                    @Html.AntiForgeryToken()
                    <script type="text/javascript">
                        $('form#formCreateEdit').removeData("validator");
                        $('form#formCreateEdit').removeData("unobtrusiveValidation");
                        $.validator.unobtrusive.parse($('form#formCreateEdit'));
                    </script>
                    <div class="form-floating form-floating-outline mb-3">
                        @Html.EditorFor(model => model.UserID, new
                            {
                                htmlAttributes = new
                                {
                                    @class = "form-control form-control-sm",
                                    @id = "txtUserID",
                                    @placeholder = "User ID",
                                    @maxlength = "20",
                                    @aria_label = "User ID"
                                }
                            })
                        @Html.ValidationMessageFor(model => model.UserID, "", new { @class = "text-danger small" })
                        <label for="txtUserID">User ID</label>
                    </div>
                    <div class="form-floating form-floating-outline mb-3">
                        @Html.EditorFor(model => model.UserName, new
                            {
                                htmlAttributes = new
                                {
                                    @class = "form-control form-control-sm",
                                    @id = "txtUserName",
                                    @placeholder = "User Name",
                                    @maxlength = "20",
                                    @aria_label = "User Name"
                                }
                            })
                        @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger small" })
                        <label for="txtUserName">User Name</label>
                    </div>
                    <div class="form-floating form-floating-outline mb-3">
                        @Html.EditorFor(model => model.Password, new
                            {
                                htmlAttributes = new
                                {
                                    @class = "form-control form-control-sm",
                                    @id = "txtPassword",
                                    @placeholder = "Password",
                                    @maxlength = "20",
                                    @aria_label = "Password"
                                }
                            })
                        @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger small" })
                        <label for="txtUserName">Password</label>
                    </div>
                    <div class="form-floating form-floating-outline mb-3">
                        @Html.EditorFor(model => model.ConfirmPassword, new
                            {
                                htmlAttributes = new
                                {
                                    @class = "form-control form-control-sm",
                                    @id = "txtConfirmPassword",
                                    @placeholder = "Confirm Password",
                                    @maxlength = "20",
                                    @aria_label = "Confirm Password"
                                }
                            })
                        @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger small" })
                        <label for="txtUserName">Confirm Password</label>
                    </div>

                    <div class="form-floating form-floating-outline mb-3">
                        @Html.DropDownListFor(model => model.Branch.BranchCode,
                                 (SelectList)ViewData["SelectListBranch"],
                                 "", // untuk opsi kosong di atas
                                 new
                                 {
                                     @id = "cboBranch",
                                     @class = "form-select select2",
                                 })
                        <label for="cboBranch">User Branch</label>
                        @Html.ValidationMessageFor(model => model.Branch.BranchCode, "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-floating form-floating-outline mb-3">
                        @Html.DropDownListFor(model => model.UserGroup.GroupCode,
                                 (SelectList)ViewData["SelectListGroup"],
                                 "", // untuk opsi kosong di atas
                                 new
                                 {
                                     @id = "cboUserGroup",
                                     @class = "form-select select2",
                                 })
                        <label for="cboUserGroup">User Group</label>
                        @Html.ValidationMessageFor(model => model.UserGroup.GroupCode, "", new { @class = "text-danger small" })
                    </div>

                    <div class="form-floating form-floating-outline mb-3">
                        @Html.EditorFor(model => model.EmailAddress, new
                            {
                                htmlAttributes = new
                                {
                                    @class = "form-control form-control-sm",
                                    @id = "txtEmailAddress",
                                    @placeholder = "Email Address",
                                    @maxlength = "120",
                                    @aria_label = "Email Address"
                                }
                            })
                        @Html.ValidationMessageFor(model => model.EmailAddress, "", new { @class = "text-danger small" })
                        <label for="txtEmailAddress">Email</label>
                    </div>
                    <div class="form-floating form-floating-outline mb-5">
                        @Html.DropDownListFor(model => model.Status,
                                 (SelectList)ViewData["SelectListStatus"],
                                 "", // untuk opsi kosong di atas
                                 new
                                 {
                                     @id = "cboStatus",
                                     @class = "form-select select2",
                                 })
                        <label for="cboBranch">Status</label>
                        @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger small" })
                    </div>
                }
                <button type="submit" class="btn btn-primary me-sm-3 me-1 data-submit" id="btnSave">Submit</button>
                <button type="reset" class="btn btn-outline-danger" data-bs-dismiss="offcanvas">Cancel</button>
            </div>
        </div>
    </div>
</div>

<div id="PartialSection">
</div>

