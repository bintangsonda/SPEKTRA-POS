    </div>
</div>
<!-- Loading Page -->

<div id="PartialSection">
</div>


@section Scripts {
    <script src="~/assets/vendor/libs/moment/moment.js"></script>
    <script src="~/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/assets/vendor/libs/select2/select2.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/popular.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/bootstrap5.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/auto-focus.js"></script>
    <script src="~/assets/vendor/libs/cleave-zen/cleave-zen.js"></script>
    <script src="~/assets/js/forms-selects.js"></script>
    <script src="~/assets/vendor/libs/tagify/tagify.js"></script>
    <script src="~/assets/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
    <script src="~/assets/vendor/libs/typeahead-js/typeahead.js"></script>
    <script src="~/assets/vendor/libs/bloodhound/bloodhound.js"></script>
    <script src="~/assets/vendor/libs/flatpickr/flatpickr.js"></script>
    <script src="~/assets/js/GeneralScript.js"></script>
    <script type="text/javascript">
        const token = $('input[name="__RequestVerificationToken"]').val();
        const getDataUrl = '@Url.Action("GetData", "Product", new { area = "Catalog" })';
        var table = null;
        var nilaiTampung = "";
        $('.select2').select2();
        let hargaIndex = 1;
        $(document).ready(function () {
            table=getData();
            $('#CategoriesFilter').select2({
                placeholder: 'All',
                allowClear: true,
                width: '100%'
            });
        });

        $("#ProdName").on("keyup", function () {
            $("#PreviewName").text($(this).val() || "Nama Produk");
        });

        // Update deskripsi
        $("#Description").on("keyup", function () {
            $("#PreviewDesc").text($(this).val() || "Deskripsi produk");
        });

        $("#ImageFile").on("change", function () {
            const file = this.files[0];

            // Validasi extension
            const allowed = ["image/jpeg", "image/png"];
            if (file && !allowed.includes(file.type)) {
                SweetAlertError('Failed!',"Hanya file JPG dan PNG yang diperbolehkan.");
                this.value = ""; // reset
                $("#previewImageUpload").hide();
                return;
            }

            // Preview
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    $("#previewImageUpload").attr("src", e.target.result).show();
                };
                reader.readAsDataURL(file);
            }
        });

        function getData() {
            return $('#tableData').DataTable({
                bDestroy: true,
                processing: true,
                serverSide: true,
                "bAutoWidth": true,
                scrollX: true,
                ajax: {
                    url: getDataUrl,
                    type: 'POST',
                    dataType: "JSON",
                    data:{
                        __RequestVerificationToken: token,
                        BranchFilter: $('#BranchFilter').val(),
                        CategoriesFilter: $('#CategoriesFilter').val(),
                    },
                },
                columns: [ 
                    { data: 'action', name: 'action', orderable: false },
                    { data: "ProdCode", name: "ProdCode" },
                    { data: "ProdName", name: "ProdCode" },
                    { data: "CategoriesCode", name: "CategoriesCode" },
                    { data: "Branch", name: "Branch" },
                    {
                        data: "Status",
                        name: "Status",
                        render: function (data) {
                            if (data === true || data === "true" || data == 1) {
                                return `<span class="badge bg-success">Aktif</span>`;
                            }
                            return `<span class="badge bg-danger">Inactive</span>`;
                        }
                    },
                    { data: "Harga", name: "Harga",
                        "render":function(data){
                            return AddCommaDecimal(data);
                        }
                    },
                    { data: "Description", name: "Description" },
                    { data: "OperatorID", name: "OperatorID" },
                    {
                        data: "LastUpdate", name: "LastUpdate",
                        "render": function (data, type, row, meta) {
                            return moment(row.LastUpdate).format('DD/MMM/YYYY');
                        }
                    },
                ],
                columnDefs: [
                    {
                        targets: [0],
                        title: 'Actions',
                        searchable: false,
                        orderable: false,
                        render: (data, type, full, meta) => {
                            return `
                        <div class="d-flex align-items-center">
                            <a href="javascript:;"
                                class="btn btn-icon btn-text-danger rounded-pill delete-record"
                                data-code="${full.ProdCode}"
                                data-outlet="${full.Branch}"
                                data-categories="${full.CategoriesCode}">

                                <i class="icon-base ri ri-delete-bin-7-line icon-md text-danger"></i>
                            </a>
                            <a href="javascript:;"
                               class="btn btn-icon btn-text-warning rounded-pill edit-record"
                                data-code="${full.ProdCode}"
                                data-name="${full.ProdName}"
                                data-descrip="${full.Description}"
                                data-outlet="${full.Branch}"
                                data-categories="${full.CategoriesCode}">
                                <i class="icon-base ri ri-pencil-line icon-md text-warning"></i>
                            </a>
                            <a href="javascript:;"
                               class="btn btn-icon btn-text-secondary rounded-pill duplicate-record"
                                data-code="${full.ProdCode}"
                                data-name="${full.ProdName}"
                                data-descrip="${full.Description}"
                                data-outlet="${full.Branch}"
                                data-categories="${full.CategoriesCode}">
                                <i class="icon-base ri ri-file-copy-line icon-md text-secondary"></i>
                            </a>


                        </div>
                    `;
                        }
                    },


                    {
                        "targets": [1]
                    },
                    {
                        "width":"250px",
                        "targets": [2]
                    },
                    {
                        "class": "StatusLoan",
                        "targets": [3]
                    },
                    {

                        "targets": [4]
                    },
                    {
                        "targets": [5]
                    },
                    {
                        className:"text-end",
                        "targets": [6]
                    },
                    {
                        "width":"300px",
                        "targets": [7]
                    },
                    {
                        "targets": [8]
                    },
                    {
                        "width":"100px",
                        "targets": [9]
                    },
                ],
                select: {
                    style: 'os',
                },
                order: [[2, 'desc']],
                layout: {
                    topStart: {
                        rowClass: 'row m-2 my-0 mt-0 justify-content-between',
                        features: [
                            {
                                pageLength: {
                                    menu: [[1, 10, 25, 50, 100, 1000, -1], [1, 10, 25, 50, 100, 1000, "All"]],
                                    text: 'Show _MENU_ entries'
                                }
                            },
                        ]
                    },
                    topEnd: {
                        features: [
                            {
                                buttons: [
                                    {
                                        text: `
                                            <i class="icon-base ri ri-add-line icon-sm me-0 d-inline-block"></i>
                                            <span class="d-none d-sm-inline-block">Add</span>
                                        `,
                                        className: 'btn add-new me-2 d-flex align-items-center',  
                                        action: function (e, dt, node, config) {
                                            $("#ProdCode").prop("disabled",false)
                                            $("#Branch").prop("disabled",false)
                                            $("#defferedAmmortizeLabel").text("Add Product")
                                            ClearModal();
                                            
                                            let modal = new bootstrap.Modal(document.getElementById('ModalInsert'));
                                            modal.show();
                                             $("#FormAction").val(1)
                                        }
                                    }
                                ]
                            },


                            {
                                search: {
                                    placeholder: 'Search User',
                                    text: '_INPUT_'
                                }
                            },

                        ]
                    },
                    bottomStart: {
                        rowClass: 'row mx-3 justify-content-between',
                        features: ['info']
                    },
                    bottomEnd: 'paging'
                },
                language: {
                    paginate: {
                        next: '<i class="icon-base ri ri-arrow-right-s-line scaleX-n1-rtl icon-22px"></i>',
                        previous: '<i class="icon-base ri ri-arrow-left-s-line scaleX-n1-rtl icon-22px"></i>',
                        first: '<i class="icon-base ri ri-skip-back-mini-line scaleX-n1-rtl icon-22px"></i>',
                        last: '<i class="icon-base ri ri-skip-forward-mini-line scaleX-n1-rtl icon-22px"></i>'
                    }
                },
            });


        }

        $("#btnAddListVarian").on("click", function () {
            let isValid = true;

            // Validasi semua row sebelumnya harus terpilih
            $("#tableVarianList tbody tr").each(function () {
                let value = $(this).find("td:nth-child(2) select").val()?.trim();
                if (!value) {
                    isValid = false;
                    return false;
                }
            });

            if (!isValid) {
                SweetAlertError('Failed!', "Semua varian harus dipilih dulu!");
                return;
            }

            // Buat row baru
            let row = $(`
                <tr>
                    <td class="text-center">${hargaIndex}</td>
                    <td>
                        <select class="form-control form-control-sm variant-select">
                        </select>
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-danger btnDelRow p-1 px-2">
                            <i class="ri ri-delete-bin-line icon-18px"></i>
                        </button>
                    </td>
                </tr>
            `);

            // Append row
            $("#tableVarianList tbody").append(row);

            // Ambil select-nya
            let select = row.find(".variant-select");

            // Load data varian ke select tersebut
            LoadVariant(select, "");

            hargaIndex++;
        });

        $(document).on("click", ".btnDelRow", function () {
            $(this).closest("tr").remove();
        });

        function LoadVariant(selectEl, selectedValue) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetDataVarianProduct", "Product", new { Area = "Catalog" })',
                dataType: 'json',
                success: function (respond) {

                    // ❗❗ CLEAR hanya selector yang sedang digunakan
                    $(selectEl).empty();

                    // ❗❗ Append ke selector yang sedang digunakan, BUKAN SEMUA!
                    $.each(respond, function (i, item) {
                        $(selectEl).append('<option value="' + item.Value + '">' + item.Text + '</option>');
                    });

                    // set selected value
                    if (selectedValue) {
                        $(selectEl).val(selectedValue).trigger("change");
                    }
                    console.log("Selected row:", selectEl);
                }
            });
        }

        $('.datatables-custom').on('click', '.edit-record', function () {
            const code = $(this).data('code');
            const descrip = $(this).data('descrip');
            const name = $(this).data('name');

            const outlet = $(this).data('outlet');
            const category = $(this).data('categories');
            $("#PreviewName").text(name)
            $("#PreviewDesc").text(descrip)
            $("#ImageFile").val("");
            $("#previewImageUpload").attr("src", "").hide();  
             $.ajax({
                type: 'GET',
                url: '@Url.Action("Edit", "Product", new { Area = "Catalog" })',
                data: { ProdCode: code,Branch:outlet },
                success: function (data) {
                    SweetAlertClose();
                    let hargaIndex = 1;
                    if (data) {
                        $("#ProdCode").val(code)
