                            </div>
                        </div>
                    </div>
                    @*<div class="col-sm-3">
                            <div class="form-group row mb-0">
                                @Html.Label("Request", "Request Status", new { @class = "control-label col-form-label col-sm-4" })
                                <div class="col-sm-7">
                                    @Html.DropDownList("RequestList", (SelectList)ViewData["SelectListRequest"], new { @id = "cboRequest", @class = "form-control select2DDList" })
                                </div>
                            </div>
                        </div>*@
                    <div class="col-sm-1">
                        <button type="button" onclick="getData()" class="btn btn-primary Find float-left"><i class="fa fa-search"></i></button>
                    </div>
                    <div class="col-sm-4" style="justify-content:right">
                        <button type="button" onclick="Approve()" class="btn btn-success approve float-left"><i class="fa fa-check"></i> Approve</button>
                        <button type="button" onclick="Reject()" class="btn btn-danger reject float-left"><i class="fa fa-close"></i> Reject</button>
                        <button type="button" onclick="ViewDatas()" class="btn btn-warning views float-left"><i class="fa fa-book"></i> View Data</button>
                        @*<button type="button" onclick="ViewChanges()" class="btn btn-dark viewchanges float-left"><i class="fa fa-eye"></i> View Changes</button>*@
