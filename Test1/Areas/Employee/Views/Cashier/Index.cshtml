                    Bill Order
                </h4>
                <button type="button"
                        class="btn shadow-none p-0"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                    <i class="icon-base ri ri-close-large-line icon-md text-white"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body bg-white">
                @Html.Partial("Create")
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/vendor/libs/moment/moment.js"></script>
    <script src="~/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/assets/vendor/libs/select2/select2.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/popular.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/bootstrap5.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/auto-focus.js"></script>
    <script src="~/assets/vendor/libs/cleave-zen/cleave-zen.js"></script>
    <script src="~/assets/js/forms-selects.js"></script>
    <script src="~/assets/vendor/libs/tagify/tagify.js"></script>
    <script src="~/assets/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
    <script src="~/assets/vendor/libs/typeahead-js/typeahead.js"></script>
    <script src="~/assets/vendor/libs/bloodhound/bloodhound.js"></script>
    <script src="~/assets/vendor/libs/flatpickr/flatpickr.js"></script>
    <script src="~/assets/js/generalscript.js"></script>
    <script type="text/javascript">
        const token = $('input[name="__RequestVerificationToken"]').val();
        const getDataUrl = '@Url.Action("GetData", "Categories", new { area = "Catalog" })';
        var seqCounter = 1;
        var DataMenu = [];
        var table = null;
        var nilaiTampung = "";
       $('.select2').select2();
        $(document).ready(function () {
            renderBill();
            getDataProduct();
            getNewTransNo();
        });

        function getDataProduct() {
             CloseModalMobile()
            var dataBranch='@Model.BranchCode';
            $.ajax({
                type: 'POST',
                url: '@Url.Action("GetDataProduct", "Cashier", new { Area = "Employee" })',
                data : {"BranchCode":dataBranch,"Categories":$("#CategoriesFilter").val(),"SearchMenu":$("#searchMenu").val()},
                success: function (data) {

                    let html = '';

                    $.each(data, function (i, item) {

                        let hasImage = item.Image && item.Image !== "";
                        $(".ProdCode").val(item.ProdCode)
                        $(".ProdHarga").val(item.Harga)
                        
                        html += `
                            <div class="product" onclick="ShowModalOrder('${item.ProdCode}','${AddCommaDecimal(item.Harga)}','${item.ProdName}')" data-code="${item.ProdCode}">
                                <div class="img ${hasImage ? '' : 'no-image'}">
                                    ${hasImage
                                        ? `<img src="../..${item.Image}" alt="${item.ProdName}">`
                                        : `<div class="no-image-text">NO IMAGE</div>`
                                    }
                                    <div class="price">Rp ${AddCommaDecimal(item.Harga)}</div>
                                </div>
                                <div class="name">${item.ProdName}</div>
                            </div>
                        `;
                    });

                    $('#productGrid').html(html);
                },
                error: function () {
                    SweetAlertError('Error', 'Failed to load Product data. Please try again.');
                }
            });
        }

        $("#CategoriesFilter").on('change',function(){
            getDataProduct()
        })

        $("#searchMenu").on('change',function(){
             getDataProduct();
        })
        
        function AddCommaDecimal(numb) {
            if (numb === null || numb === undefined || numb === "") {
                return "-";
            }

            let num = parseFloat(numb.toString().replace(/,/g, ""));

            if (isNaN(num)) return "-";

            // Jika bilangan bulat → tanpa decimal
            if (Number.isInteger(num)) {
                return num.toLocaleString("en-US");
            }

            // Jika ada pecahan → max 2 decimal, tanpa .00
            return num.toLocaleString("en-US", {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            });
        }

        function renderBill() {
            let html = "";

            DataMenu.forEach(item => {
                html += `
                    <div class="bill-item">
                        <span class="qty">${item.qty}x</span>
                        <span class="name ShowItemModalByName" data-seq="${item.seqNo}">
                            ${item.name}
                        </span>
                        <span class="billprice">
                            ${AddCommaDecimal(item.price)}
                        </span>
                        <button class="btn-delete" data-seq="${item.seqNo}">
                            ✕
                        </button>
                    </div>
                `;

                if (item.variants?.length) {
                    item.variants.forEach(v => {
                        html += `
                            <div class="bill-variant">
                                └ ${v.type}: ${v.value}
                            </div>
                        `;
                    });
                }
            });

            document.querySelectorAll(".bill-list")
                .forEach(el => el.innerHTML = html);
        }

        

        function ModalBillEdit(){
             CloseModalMobile()
            let modal = new bootstrap.Modal(document.getElementById('ModalOrder'));
            modal.show();
        }

        function ShowModalMobile(){
            let modal = new bootstrap.Modal(document.getElementById('ModalMobile'));
            modal.show();
            renderBill()
            
        }

        function CloseModalMobile(){
            const modalEl = document.getElementById('ModalMobile');
            const modal = bootstrap.Modal.getInstance(modalEl);

            if (modal) {
                modal.hide();
            }
        }
        function ShowModalOrder(dataCode, Harga, ProductName) {
             CloseModalMobile()
            resetOrderModal();
            let modal = new bootstrap.Modal(document.getElementById('ModalOrder'));
            modal.show();
            $('#ModalOrder').removeData('edit-seq');

            $(".ProdName").text(ProductName + " - Rp. " + Harga.toLocaleString());
            $(".ProdHarga").val(Harga)
            $(".ProdCode").val(dataCode)
            $.ajax({
                type: 'POST',
                url: '@Url.Action("GetProductDetail", "Cashier", new { Area = "Employee" })',
                data: { productCode: dataCode }, // ⚠️ samakan dengan controller
                success: function (data) {
                    const section = document.getElementById('variantSection');
                    const container = document.getElementById('variantContainer');

                    // reset dulu
                    container.innerHTML = '';
                    section.classList.add('d-none');

                    // kalau tidak ada variant
                    if (!data || data.length === 0) {
                        return;
                    }

                    // tampilkan section
                    section.classList.remove('d-none');

                    // loop header
                    data.forEach(header => {

                        const inputType = header.VarianType === false ? 'radio' : 'checkbox';
                        let minMaxLabel = '';

                       if (header.VarianType === true) {
                            minMaxLabel = `
                                <small class="text-muted">
                                    (min ${header.Minimal}, max ${header.Maximal})
                                </small>
                            `;
                        }

                        let html = `
                        <div class="w-100 variant-group"
                                data-code="${header.VarianCode}"
                                data-name="${header.VarianName}"
                                data-min="${header.Minimal}"
                                data-max="${header.Maximal}"
                                data-mode="${header.VarianMode}"
                                data-type="${header.VarianType}">
     
                            <div class="fw-bold mb-2 varianLabel">
                                ${header.VarianName}
                                ${minMaxLabel}
                            </div>
                            <div class="fw-bold mb-2 varianCode" hidden>
                                ${header.VarianCode}
                                
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                        `;

                    // loop detail
                    header.Variants.forEach(v => {
                        html += `
                            <label class="type-option">
                                <input type="${inputType}"
                                        name="variant_${header.VarianCode}"
                                        value="${v.Name}"
                                        data-price="${v.Value}">
                                <span>
                                    ${v.Name}
                                    ${v.Value > 0 ? `( +Rp ${Number(v.Value).toLocaleString()} )` : ''}
                                </span>
                            </label>
                        `;
                    });

                    html += `
                            </div>
                        </div>
                    `;


                        container.insertAdjacentHTML('beforeend', html);
                    });
                },
                error: function () {
                    SweetAlertError('Error', 'Failed to load Product data. Please try again.');
                }
            });
        }

        function resetOrderModal() {

            // header / hidden
            $('.ProdName').text('');
            $('.ProdCode').val('');
            $('.ProdHarga').val('');

            // qty & discount
            $('#qtyInput').val(1);
            $('.discount-input').val(0);

            // remark
            $('#RemarkOrder').val('');

            // order type
            $('input[name="orderType"]').prop('checked', false);

            // variant
            $('#variantContainer').empty();
            $('#variantSection').addClass('d-none');

            // hapus edit mode
            $('#ModalOrder').removeData('edit-seq');
        }

        $(document).on('change', 'input[name^="variant_"]', function () {

            const $input = $(this);
            const $group = $input.closest('.variant-group');

            const min  = parseInt($group.data('min'));
            const max  = parseInt($group.data('max'));
            const type = parseInt($group.data('type'));

            const $inputs  = $group.find('input[name^="variant_"]');
            const checkedCount = $inputs.filter(':checked').length;

            // === MAXIMAL (checkbox) ===
            if (type === 1 && checkedCount > max) {
                $input.prop('checked', false);
                alert(`Maksimal pilih ${max} item`);
                return;
            }

            // === RADIO TYPE ===
            if (type === 0 && checkedCount > 1) {
                $inputs.not($input).prop('checked', false);
            }
        });
         
        function increaseQty() {
            const input = document.getElementById('qtyInput');
            input.value = parseInt(input.value) + 1;
        }

        function decreaseQty() {
            const input = document.getElementById('qtyInput');
            if (parseInt(input.value) > 1) {
                input.value = parseInt(input.value) - 1;
            }
        }

        function SaveOrder() {
            if (!validateOrder()) return;

            // ===== BASIC DATA =====
            const qty = parseInt($('#qtyInput').val()) || 1;
            const discount = parseFloat($('.discount-input').val()) || 0;
            const remark = $('#RemarkOrder').val() || "";

            const productName = $('.ProdName').text().split("-")[0]
                .replace('Product :', '')
                .trim();

            const productCode = $(".ProdCode").val();
            const basePrice = RemoveAllComma($(".ProdHarga").val());

            const orderType = $("input[name='orderType']:checked").val() || "";

            // ===== VARIANTS =====
            let variants = [];
            let valid = true;

            $('.variant-group').each(function () {
                const group = $(this);

                const typeName = group.data('name');       // ambil nama dari data-name
                const variancode = group.data('code');     // ambil code dari data-code

                const min = parseInt(group.data('min')) || 0;
                const type = parseInt(group.data('type')) || 0;

                const checked = group.find('input:checked');

                if (type === 1 && checked.length < min) {
                    alert(`Minimal pilih ${min} untuk ${typeName}`);
                    valid = false;
                    return false;
                }

                checked.each(function () {
                    variants.push({
                        type: typeName,
                        code: variancode,
                        value: $(this).val(),
                        price: parseFloat($(this).data('price')) || 0
                    });
                });
            });

            if (!valid) return;

            // ===== EDIT / INSERT =====
            const editSeq = $('#ModalOrder').data('edit-seq');

            if (editSeq) {
                // === EDIT MODE ===
                const item = DataMenu.find(x => x.seqNo === editSeq);
                if (!item) return;

                item.qty = qty;
                item.discount = discount;
                item.remark = remark;
                item.orderType = orderType;
                item.variants = variants;

                // ⚠️ data inti tetap dijaga
                item.price = basePrice;
                item.code = productCode;
                item.name = productName;

                $('#ModalOrder').removeData('edit-seq');

            } else {
                // === INSERT MODE ===
                DataMenu.push({
                    seqNo: seqCounter++,
                    code: productCode,
                    name: productName,
                    price: basePrice,
                    qty: qty,
                    discount: discount,
                    remark: remark,
                    orderType: orderType,
                    variants: variants
                });
            }

            // ===== CLOSE & REFRESH =====
            bootstrap.Modal.getInstance(
                document.getElementById('ModalOrder')
            ).hide();

            renderBill();
            CalculateTotal();
        }

        function validateOrder() {

            // === TYPE ===
            const orderType = $('input[name="orderType"]:checked').val();
            if (!orderType) {
                alert('Type wajib diisi');
                return false;
            }

            // === QTY ===
            const qty = parseInt($('#qtyInput').val());
            if (!qty || qty <= 0) {
                alert('Qty wajib diisi dan harus lebih dari 0');
                return false;
            }

            // === PRODUCT CODE ===
            if ($(".ProdCode").val()==null ||$(".ProdCode").val()=="") {
                alert('Product tidak ditemukan');
                return false;
            }

            // === PRODUCT PRICE ===
            if ($(".ProdHarga").val()==null ||$(".ProdHarga").val()=="") {
                alert('Product tidak ditemukan harganya');
                return false;
            }

            // === VARIANT VALIDATION ===
            let isValid = true;
            let errorMsg = '';

            $('.variant-group').each(function () {

                const group = $(this);

                const variantName = group.data('name');

                // normalize value
                const mode = group.data('mode');      // contoh: "1" / 1 / true
                const isRequired = mode == 1 || mode === true || mode === "true";


                const min = parseInt(group.data('min')) || 0;
                const max = parseInt(group.data('max')) || 0;

                const checked = group.find('input:checked');
                const checkedCount = checked.length;

                // === WAJIB PILIH JIKA MODE TRUE ===
                if (isRequired && checkedCount === 0) {
                    errorMsg = `Varian "${variantName}" wajib dipilih`;
                    isValid = false;
                    return false; // break loop
                }

                // === MIN ===
                if (isRequired && min > 0 && checkedCount < min) {
                    errorMsg = `Varian "${variantName}" minimal pilih ${min}`;
                    isValid = false;
                    return false;
                }

                // === MAX ===
                if (max > 0 && checkedCount > max) {
                    errorMsg = `Varian "${variantName}" maksimal pilih ${max}`;
                    isValid = false;
                    return false;
                }
            });

            if (!isValid) {
                alert(errorMsg);
                return false;
            }


            return true;
        }

        //ini buat pencet order list nya 
        function CalculateTotal(){
            let total = 0;

            $.each(DataMenu, function (i, item) {
                total += (item.qty * item.price);
            });
            $(".SubTotal").text(AddCommaDecimal(total));
            $(".Total").text(AddCommaDecimal(total));
        }

        function DeleteBill(){
            DataMenu.length = 0;   // kosongkan array
            renderBill();          // refresh tampilan
            CalculateTotal();         // reset total (kalau ada)
        }

        $(document).on("click", ".btn-delete", function () {
            let seqNo = $(this).data("seq");

            // hapus item dari array
            DataMenu = DataMenu.filter(item => item.seqNo !== seqNo);

            renderBill();
            CalculateTotal();
        });

        $(document).on("click", ".ShowItemModalByName", function () {
             CloseModalMobile()
            let seqNo = $(this).data("seq");

            // cari data di array
            let item = DataMenu.find(x => x.seqNo === seqNo);
            if (!item) return;

            fillOrderModal(item);

            // simpan seqNo yg sedang diedit
            $("#ModalOrder").data("edit-seq", seqNo);

            // buka modal
            let modal = new bootstrap.Modal(document.getElementById("ModalOrder"));
            modal.show();
        });

        function fillOrderModal(item) {
            // Nama & hidden value
            $(".ProdName").text(item.name);
            $(".ProdCode").val(item.code);
            $(".ProdHarga").val(item.price);

            // Qty & discount
            $("#qtyInput").val(item.qty);
            $(".discount-input").val(item.discount || 0);
            $("#RemarkOrder").val(item.remark || "");

            // Order Type
            $("input[name='orderType']").prop("checked", false);
            if (item.orderType) {
                $(`input[name='orderType'][value="${item.orderType}"]`).prop("checked", true);
            }

            // Variant: ambil dari server
            $.ajax({
                type: "POST",
                url: '@Url.Action("GetProductDetail", "Cashier", new { Area = "Employee" })',
                data: { productCode: item.code },
                success: function(data) {
                    renderVariantFromServer(data, item.variants || []);
                },
                error: function() {
                    SweetAlertError("Error", "Failed to load product variant data");
                }
            });
        }

        function renderVariantFromServer(headers, selectedVariants) {
            const container = $("#variantContainer");
            if (!headers || headers.length === 0) {
                $("#variantSection").addClass("d-none");
                container.html("");
                return;
            }

            $("#variantSection").removeClass("d-none");
            let html = "";

            headers.forEach(header => {
                const inputType = header.VarianType === false ? 'radio' : 'checkbox';
                let minMaxLabel = '';
                if (header.VarianType === true) {
                    minMaxLabel = `<small class="text-muted">(min ${header.Minimal}, max ${header.Maximal})</small>`;
                }

                html += `<div class="variant-group"   data-name="${header.VarianName}" data-code="${header.VarianCode}">
                            <div class="fw-bold mb-2">${header.VarianName} ${minMaxLabel}</div>
                            <div class="d-flex flex-wrap gap-2">`;

                header.Variants.forEach(v => {
                    const isChecked = selectedVariants.some(sv => sv.code === header.VarianCode && sv.value === v.Name) ? 'checked' : '';
                    html += `<label class="type-option">
                                <input type="${inputType}" name="variant_${header.VarianCode}" value="${v.Name}" data-price="${v.Value}" ${isChecked}>
                                <span>${v.Name} ${v.Value > 0 ? `( +Rp ${Number(v.Value).toLocaleString()} )` : ''}</span>
                            </label>`;
                });

                html += `</div></div>`;
            });

            container.html(html);
        }

        function SaveBillPayment(StatusUpdate){
           
            if (DataMenu.length === 0) {
                alert("Order masih kosong");
                return;
            
            }
            CloseModalMobile()
            const details = DataMenu.map(item => {
                return {
                    ProductCode: item.code,
                    ProductName: item.name,
                    SeqNo:item.seqNo,
                    Qty: item.qty,
                    Price: item.price,
                    Discount: item.discount,
                    Remark: item.remark,
                    OrderType: item.orderType,
                    VariantCode: item.variants.map(v => v.code).join(","),
                    VariantName: item.variants.map(v => v.type).join(","),
                    VariantValue: item.variants.map(v => v.value).join(","),
                    VariantHarga: item.variants.map(v => v.price).join(",")
                };
            });
            $.ajax({
                type: 'POST',
                url: '@Url.Action("SaveBillPayment", "Cashier", new { Area = "Employee" })',
                data : {"TransCode":$(".TransactionCode").first().text().trim(),
                "TransTotalAmt":RemoveAllComma($(".Total").first().text().trim()),
                "TransSubTotalAmt":RemoveAllComma($(".SubTotal").first().text().trim()),
                "Status":StatusUpdate,
                "TransTotalPaid":RemoveAllComma($(".GrandTotalPayment").val()),
                "TransPayMtd":$('input[name="PayMethod"]:checked').val(),
                "TransPayType":$("#OtherMethodSelect").val(),
                "Details":details,
                },
                success: function (data) {
                    if(data.success==1){
                        SweetAlertSuccess("Success",data.msg)
                    }
                    else{
                        SweetAlertError("Failed",data.msg)
                    }
                    getNewTransNo()
                    DeleteBill()
                     bootstrap.Modal.getInstance(
                        document.getElementById('ModalPayment')
                    ).hide();
                },
                error: function () {
                    SweetAlertError('Error', 'Failed to Save. Please try again.');
                }
            });
        }

        function getNewTransNo(){
            $.ajax({
                type: 'POST',
                url: '@Url.Action("GetNewTransNo", "Cashier", new { Area = "Employee" })',
                success: function (data) {
                    console.log("ini jalan:"+data)
                    $(".TransactionCode").text(data)
                },
                error: function () {
                    SweetAlertError('Error', 'Failed to load new TransNo.');
                }
            });
        }

        function renderTransaction() {
            let html = '';
             $.ajax({
                type: 'POST',
                url: '@Url.Action("GetBillList", "Cashier", new { Area = "Employee" })',
                dataType: 'json',
                success: function (data) {
                    $.each(data, function (index, item) {
                        html += `
                            <tr>
                                <td>${item.TransCode}</td>
                                <td class="text-end">
                                    ${AddCommaDecimal(item.TransTotalAmt)}
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-primary btn-edit" OnClick='GetDataBillForTransaction("${item.TransCode}")'
                                            data-code="${item.TransCode}">
                                        Select
                                    </button>
                                </td>
                            </tr>
                        `;
                    });

                    // 🔥 PINDAH KE SINI
                    $('#TransList').html(html);
                },
                error: function () {
                    SweetAlertError('Error', 'Failed to load new TransNo.');
                }
            });
            
        }

        function ListBill(){//open modal list bill
             CloseModalMobile()
            let modal = new bootstrap.Modal(document.getElementById('ModalViewBill'));
            modal.show();
            renderTransaction();
        }

        function GetDataBillForTransaction(TransCode) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("Edit", "Cashier", new { Area = "Employee" })',
                data: { TransCode },
                dataType: 'json',
                success: function (res) {

                    // RESET
                    DataMenu = [];
                    seqCounter = 1;

                    $(".TransactionCode").text(res.TransCode);
                    $(".SubTotal").text(AddCommaDecimal(res.TransSubTotalAmt));
                    $(".Total").text(AddCommaDecimal(res.TransTotalAmt));

                    res.Details.forEach(d => {

                        // === SPLIT VARIANT ===
                        const codes  = d.VariantCode?.split(',') || [];
                        const names  = d.VariantName?.split(',') || [];
                        const values = d.VariantValue?.split(',') || [];
                        const prices = d.VariantHarga?.split(',') || [];
                        const ordertypes = d.OrderType?.split(',') || [];

                        let variants = [];

                        for (let i = 0; i < codes.length; i++) {
                            if (!codes[i]) continue;

                            variants.push({
                                code: codes[i],
                                type: names[i] || "",
                                value: values[i] || "",
                                price: parseFloat(prices[i]) || 0
                            });
                        }

                        // === PUSH KE DATAMENU ===
                        DataMenu.push({
                            seqNo: d.SeqNo,
                            code: d.ProductCode,
                            name: d.ProductName,
                            price: d.Price,
                            qty: d.Qty,
                            discount: 0,
                            remark: d.Remark || "",
                            orderType: ordertypes,
                            variants: variants
                        });

                        seqCounter = Math.max(seqCounter, d.SeqNo + 1);
                    });

                    renderBill();
                    CalculateTotal();

                    const modalEl = document.getElementById('ModalViewBill');
                    const modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    if (window.matchMedia("(max-width: 767.98px)").matches) {
                        const modalMobileEl = document.getElementById('ModalMobile');
                        const modalMobile = bootstrap.Modal.getOrCreateInstance(modalMobileEl);
                        modalMobile.show();
                    }
                },
                error: function () {
                    SweetAlertError("Error", "Failed to load transaction");
                }
            });
        }

        function ShowModalPayment(){//open modal list bill
            if(parseInt(RemoveAllComma($(".Total").first().text().trim()))==0){
                SweetAlertError('Failed','Please Fill the bill first');
            }
            else{
                CloseModalMobile()
                let modal = new bootstrap.Modal(document.getElementById('ModalPayment'));
                modal.show();
                $(".TotalPayment").text("Rp. "+ $(".Total").first().text().trim())
                $(".GrandTotalPayment").val($(".Total").first().text().trim())
                
            }
           
        }

        $(document).on('change', 'input[name="PayMethod"]', function () {
            let payMethod = $(this).val();

            if (payMethod === 'Cash') {
                $('#OtherMethod').stop(true, true).slideUp();
                $('#CashMethod').stop(true, true).slideDown();
                $('input[name="PayType"][value="UangPas"]')
                    .prop('checked', true)
                    .trigger('change');

            } else {
                $('#CashMethod').stop(true, true).slideUp();
                $('#OtherMethod').stop(true, true).slideDown();
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("GetPayType", "Cashier", new { Area = "Employee" })',
                    data: {
                        PayMethod: payMethod
                    },
                    success: function (data) {
                        let $ddl = $('#OtherMethodSelect');
                        $ddl.empty(); // kosongkan dulu

                        $ddl.append('<option value="">-- Pilih Method --</option>');

                        $.each(data, function (i, item) {
                            $ddl.append(
                                $('<option>', {
                                    value: item.Value,
                                    text: item.Text
                                })
                            );
                        });
                        if (data.length > 0) {
                            $ddl.val(data[0].Value).trigger('change');
                        }

                    },
                    error: function () {
                        SweetAlertError('Error', 'Failed to load Product data. Please try again.');
                    }
                });

            }
            let total = $('.TotalPayment').text().split("Rp.")[1].trim();
                $('.GrandTotalPayment').val(total);
                $('.GrandTotalPayment').attr('readonly',true);
        });

        $(document).on('change', 'input[name="PayType"]', function () {
            let payType = $(this).val();

            if (payType === 'UangPas') {
                // ambil nilai dari TotalPayment
                let total = $('.TotalPayment').text().split("Rp.")[1].trim();
                $('.GrandTotalPayment').val(total);
                $('.GrandTotalPayment').attr('readonly',true);


            } else if (!isNaN(payType)) {
                
                let nominal = parseInt(payType);
                $('.GrandTotalPayment').val(AddCommaDecimal(nominal));
                 $('.GrandTotalPayment').attr('readonly',true);

            } else {
                // Other / Lainnya
                $('.GrandTotalPayment').removeAttr('readonly');
            }
        });

        function ProcessPayment(){
            if(parseInt($(".TotalPayment").text().split("Rp.")[1].trim())==0){
                SweetAlertError("Failed","Total Amount can't be zero!")
            }
            else if(parseInt(RemoveAllComma($(".GrandTotalPayment").val()))==0||$(".GrandTotalPayment").val()==undefined||$(".GrandTotalPayment").val()==""){
                SweetAlertError("Failed","Total Payment can't be zero! or Empty")
            }
            else if(
            parseInt(
                        RemoveAllComma($(".TotalPayment").text().split("Rp.")[1].trim())
                    ) > parseInt(
                        RemoveAllComma($(".GrandTotalPayment").val())
                    )
            ){
                SweetAlertError("Failed","Total Payment can't be smaller than Total Amount!");
            }
            else{
                SaveBillPayment(1)
            }
        }
       


    </script>
}
