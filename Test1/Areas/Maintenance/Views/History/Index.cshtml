
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "History";
}


@section Styles {
    <link rel="stylesheet" href="~/Content/DataTables/datatables.css" />
    <link rel="stylesheet" href="~/Content/DataTables/DataTables-1.10.25/css/dataTables.bootstrap5.min.css" />
    @*<link rel="stylesheet" href="~/Content/DataTables/Select-1.3.3/css/select.bootstrap5.min.css" />*@
    <link rel="stylesheet" href="~/Content/flatpickr/flatpickr.min.css" />
    <link rel="stylesheet" href="~/Content/flatpickr/plugins/monthSelect/style.css" />
    <link href="~/Content/Select2/css/select2.min.css" rel="stylesheet" type="text/css" />
}

<div class="col-sm-6 col-md-6 col-6">
    <h4>@ViewBag.Title</h4>
</div>
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Filter</h3>
        <div class="card-tools">
            <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-minus"></i></button>
        </div>
    </div>
    <div class="card-body">
        <div class="row">


            <div class="col-sm-5 mb-0">
                <div class="form-group row mb-0">
                    @Html.Label("Period", "Period", new { @class = "control-label col-sm-3 col-form-label" })
                    <div class="col-xs-12 col-sm-8">
                        @Html.TextBox("PeriodIndex", "", htmlAttributes: new { @class = "form-control form-control-sm bg-white col-sm-6", @id = "PeriodIndex" })
                    </div>
                </div>
                <div class="form-group row mb-0">
                    @Html.Label("", "", new { @class = "control-label col-sm-3 col-form-label" })
                    <div class="col-sm-9 mb-2">

                    </div>
                </div>
            </div>
        </div>
        <div class="row">


            <div class="col-sm-5 mb-0">
                <div class="form-group row mb-0">
                    @Html.Label("Status", "Status", new { @class = "control-label col-sm-3 col-form-label" })
                    <div class="col-xs-12 col-sm-8">
                        @Html.DropDownList("Status", (SelectList)ViewData["Status"], new { @id = "cboStatus", @class = "form-control col-sm-6 select2DDList" })
                    </div>
                </div>
                <div class="form-group row mb-0">
                    @Html.Label("", "", new { @class = "control-label col-sm-3 col-form-label" })
                    <div class="col-sm-9 mb-2">
                    </div>
                </div>
            </div>
        </div>
        <!-- Selesai -->
    </div>
</div>
<div class="row mb-1 justify-content-between col-sm-12">
    <div class="col-sm-12 col-md-12 col-12 text-right">
        <div class="text-right">

            <p>

                <a class="btn btn-sm btn-default" onclick="LoadHistory()" title="View History">
                    <i class="fas fa-eye"></i>
                </a>
            </p>
        </div>
    </div>
</div>

<div class="table-responsive table-responsive-sm p-2 bg-white border">
    <table id="tableData" class="table table-bordered table-hover w-100">
        <thead>
            <tr>
                <th class="align-middle">Id</th>
                <th class="align-middle">Computer Name</th>
                <th class="align-middle">Ip Address</th>
                <th class="align-middle">User Name</th>
                <th class="align-middle">Status</th>
                <th class="align-middle">Table</th>
                <th class="align-middle">Key Field1</th>
                <th class="align-middle">Key Field2</th>
                <th class="align-middle">Key Field3</th>
                <th class="align-middle">Key Field4</th>
                <th class="align-middle">Key Field5</th>
                <th class="align-middle">Key Field6</th>
                <th class="align-middle">Date Updated</th>
            </tr>
        </thead>
    </table>
</div>

<div id="PartialSectionSecond">

</div>

