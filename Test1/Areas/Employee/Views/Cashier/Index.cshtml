            Process
        </button>
    </div>

</div>




        <div class="product-grid" id="productGrid">
        </div>
    </div>


    <div class="right-panel d-none d-md-block">
        @Html.Partial("Create")
    </div>
</div>

<div class="modal fade" id="ModalOrder" role="dialog" aria-labelledby="defferedAmmortizeLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <!-- Header -->
            <div class="modal-header bg-primary py-2 px-3 d-flex justify-content-between align-items-center">
                <h4 class="modal-title mb-0 fw-semibold text-white" id="defferedAmmortizeLabel">
                    Set Order
                </h4>
                <button type="button"
                        class="btn shadow-none p-0"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                    <i class="icon-base ri ri-close-large-line icon-md text-white"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body bg-white">
                <div class="row gy-2">
                    <div class="col-12">
                        <div class="form-group">
                            <label class="ProdName fw-bold fs-5 text-black mb-2">
                                Product :
                            </label>             
                            <input class="ProdCode fw-bold fs-5 text-black mb-2 d-none">
                            <input class="ProdHarga fw-bold fs-5 text-black mb-2 d-none">
                        </div>
                        <div class="row gy-2 align-items-start mt-4">
                            <div class="col-12 col-md-2">
                                <label class="fw-bold fs-6 text-black">Type :</label>
                            </div>

                            <div class="col-12 col-md-10">
                                <div class="d-flex flex-wrap gap-2">
                                    <label class="type-option">
                                        <input type="radio" name="orderType" value="Take away">
                                        <span>Take away</span>
                                    </label>

                                    <label class="type-option">
                                        <input type="radio" name="orderType" value="Dine in">
                                        <span>Dine in</span>
                                    </label>

                                    <label class="type-option">
                                        <input type="radio" name="orderType" value="GoFood">
                                        <span>GoFood</span>
                                    </label>

                                    <label class="type-option">
                                        <input type="radio" name="orderType" value="GrabFood">
                                        <span>GrabFood</span>
                                    </label>

                                    <label class="type-option">
                                        <input type="radio" name="orderType" value="ShopeeFood">
                                        <span>ShopeeFood</span>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="row gy-2 align-items-center mt-4">
                            <div class="col-12 col-md-2">
                                <label class="fw-bold fs-6 text-black">Qty :</label>
                            </div>

                            <div class="col-12 col-md-2">
                                <div class="qty-wrapper">
                                    <button type="button" class="qty-btn" onclick="decreaseQty()">−</button>
                                    <input type="number" id="qtyInput" class="qty-input" value="1" min="1">
                                    <button type="button" class="qty-btn" onclick="increaseQty()">+</button>
                                </div>
                            </div>

                            <div class="col-12 col-md-2">
                                <label class="fw-bold fs-6 text-black">Disc :</label>
                            </div>

                            <div class="col-12 col-md-2">
                                <div class="discount-wrapper">
                                    <span class="discount-prefix">Rp</span>
                                    <input type="number" class="discount-input" placeholder="Discount" value="0">
                                </div>
                            </div>
                        </div>

                        <div class="row gy-2 align-items-start mt-4">
                            <div class="col-12 col-md-2">
                                <label class="fw-bold fs-6 text-black">Remark :</label>
                            </div>

                            <div class="col-12 col-md-10">
                                @Html.TextArea(
                                    "RemarkOrder",
                                    null,
                                    new {
                                        @class = "form-control form-control-sm auto-resize",
                                        placeholder = "Masukkan deskripsi...",
                                        maxlength = "300",
                                        rows = "1"
                                    }
                                )
                            </div>
                        </div>
                        <div class="row gy-2 align-items-start mt-4 d-none" id="variantSection">
                            <div class="col-12 col-md-2">
                                <label class="fw-bold fs-6 text-black">Variant :</label>
                            </div>

                            <div class="col-12 col-md-10">
                                <div class="d-flex flex-wrap gap-2" id="variantContainer"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
           <div class="modal-footer py-2 px-3 border-0 bg-white">
            <div class="d-flex gap-2 w-100 justify-content-center">

                <button type="button"
                        class="btn btn-danger btn-sm flex-fill flex-md-grow-0 px-md-4"
                        data-bs-dismiss="modal">
                    <i class="ri ri-close-line me-1 fs-6 fs-md-5"></i>
                    Close
                </button>

                <button type="button"
                        class="btn btn-success btn-sm flex-fill flex-md-grow-0 px-md-4 SaveInsert"
                        onclick="SaveOrder()"
                        id="btnSaveOrder">
                    <i class="ri ri-check-fill me-1 fs-6 fs-md-5"></i>
                    Save
                </button>

            </div>
        </div>


        </div>
    </div>
</div>

