using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {
    decimal debit;
    decimal credit;
    decimal begbalDebit;
    decimal begbalCredit;
    
    private void Data1_BeforePrint(object sender, EventArgs e)
    {
      if ((decimal)Report.GetColumnValue(&quot;GLRepKasBank.amount&quot;) &gt; 0){
        debit = (decimal)Report.GetColumnValue(&quot;GLRepKasBank.amount&quot;);
        credit = 0;
      }  
      else{
        credit = (decimal)Report.GetColumnValue(&quot;GLRepKasBank.amount&quot;) * -1;
        debit = 0;
      }
    }
    
    private void Data2_BeforePrint(object sender, EventArgs e)
    {      
      if ((decimal)Report.GetColumnValue(&quot;GLRepKasBank.begbal&quot;) &gt; 0){
        begbalDebit = (decimal)Report.GetColumnValue(&quot;GLRepKasBank.begbal&quot;);
        begbalCredit = 0;
      }  
      else{
        begbalDebit = (decimal)Report.GetColumnValue(&quot;GLRepKasBank.begbal&quot;) * -1;
        begbalCredit = 0;
      } 
    }
  }
}
</ScriptText>
