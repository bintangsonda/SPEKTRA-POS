        function DuplicateProdut()
        {
            $("#OutletFrom").prop("Disabled",false)
            const code = $("#productCode").val()
            const outlet = $("#OutletFrom").val()
            const DupeBranch=$("#OutletTo").val()
            if(outlet==DupeBranch){
                SweetAlertError("failed!","Outlet From can't be same as Outlet To")
                return false;
            }
            if(DupeBranch==""||DupeBranch==null){
                SweetAlertError("failed!","Outlet To can't be empty!")
                return false;
            }
            else if(outlet==""||outlet==null){
                SweetAlertError("failed!","Outlet From can't be empty!")
                return false;
            }
             $.ajax({
                type: 'GET',
                url: '@Url.Action("Duplicate", "Product", new { Area = "Catalog" })',
                data: { ProdCode: code,Outlet:outlet,OutletTo: DupeBranch},
                success: function (data) {
                    SweetAlertClose();
                    if (data) { 
                        
                        if(data.success){
                            var myModal = bootstrap.Modal.getInstance(document.getElementById('ModalDuplicate'));
                            myModal.hide();
                             SweetAlertSuccess("Success!",data.msg)
                              
                        }
                        else{
                            SweetAlertError('Error', 'Failed to duplicate data!, please call your administrator');
                        }
                    }
                },
                error: function () {
                    SweetAlertError('Error', 'Failed to load Product data. Please try again.');
                }
            });
        }

