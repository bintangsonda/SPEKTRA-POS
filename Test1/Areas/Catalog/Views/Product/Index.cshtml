            ClearModal();
            $("#defferedAmmortizeLabel").text("Add Product")
            $("#ProdCode").prop("disabled",false)
            $("#Branch").prop("disabled",false)
            $("#FormAction").val(1)
        })

        $('#btnSave').on('click',function(){
            if ($('#PageInsert').val() == 1) {
                const code = $("#ProdCode").val();
                const name = $("#ProdName").val();
                const outlet = $("#Branch").val();
                const category = $("#CategoriesCode").val();
                const status = $("#cboStatus").prop('checked');
                const description = $("#Description").val();
                const harga = RemoveAllComma($("#Harga").val());


                if(code==null||name==null||outlet==null||category==null||description==null||harga==null
                ||code==""||name==""||outlet==""||category==""||description==""||harga==""){
                    SweetAlertError('Failed!', "All Field is Mandatory!");
                    return false;
                }
                var VarianProduct=GetVarianProduct();

                SweetAlertConfirm(
                    'Confirmation',
                    'Are you sure you want to Save this data, Product Code: ' + code+', Outlet: '+outlet+', Category: '+category,
                    function () {
                        var a = document.getElementById('loading');
                        a.style.display = "block";
                        var formData = new FormData();

                        formData.append("ImageFile", $("#ImageFile")[0].files[0]); // <-- file
                        formData.append("ProdCode", code);
                        formData.append("Branch", outlet);
                        formData.append("CategoriesCode", category);
                        formData.append("ProdName", name);
                        formData.append("Description", description);
                        formData.append("Status", status);
                        formData.append("Harga", harga);
                        formData.append("VarianProduct", JSON.stringify(VarianProduct)),                     
                        formData.append("FormAction", $("#FormAction").val());
                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("Create", "Product", new { Area = "Catalog" })',
                            data: formData,
                            processData: false,      // penting → FormData tidak diproses jadi string
                            contentType: false,      // penting → biar multipart/form-data otomatis
                            success: function (respond) {
                                a.style.display = "none";
                                if(respond.success==1){
                                    table=getData();
                                    SweetAlertSuccess('Success!', respond.msg);
                                    $("#FormAction").val('2');
                                    
                                    $("#ProdCode").prop("disabled",true)
                                    $("#Branch").prop("disabled",true)
                                    $("#defferedAmmortizeLabel").text("Edit Product")
                                     //buat munculin gambar
                                    let foldername =code+'-'+outlet;
                                    let fileName = $("#ImageFile")[0].files[0].name;
                                    let ext = fileName.substring(fileName.lastIndexOf('.'));
                                    let fileNameDoubleExt = fileName + ext;

                                    if (fileName) {

                                        let imageUrl = `../..../../Uploads/ProductIMG/${foldername}/${fileNameDoubleExt}`;

                                        // preview card product
                                        $("#PreviewImage")
                                            .attr("src", imageUrl)
                                            .show();
                                    } else {
                                        // kalau ga ada gambar
                                        $("#PreviewImage").attr("src", "");
                                    }
                                    //buat munculin gambar
                                }
                                else if(respond.success==0){
                                    SweetAlertError('Failed!', respond.msg);
                                }
                                else{
                                    table=getData();
                                    SweetAlertSuccess('Success!', respond.msg);
                                     $("#FormAction").val('2');
                                    
                                    $("#ProdCode").prop("disabled",true)
                                    $("#Branch").prop("disabled",true)
                                    $("#defferedAmmortizeLabel").text("Edit Product")
                                }
                            },
                            error: function (respond, xhr, msg) {
                                a.style.display = "none";
                                SweetAlertError('Failed!', respond.msg);
                            }
                        })
                    }
                );
            }
        });

        function ClearModal() {
            $("#ModalInsert")
                .find("input[type='text'], textarea")
                .val("");
            $("#PreviewName").text("Nama Produk");
            $("#PreviewDesc").text("Description Produk");
            $("#productCode").val("")
            $("#OutletFrom").val("").select2()
            $("#OutletTo").val("").select2()
            $("#ImageFile").val("");
            $("#previewImageUpload").attr("src", "").hide();  
            $("#PreviewImage").attr("src", "");
             $("#tableVarianList tbody").empty();
             hargaIndex=1;
        }

        function GetVarianProduct() {
            let result = [];

            $("#tableVarianList tbody tr").each(function () {
               let nama = $(this).find("td:nth-child(2) select").val()?.trim();

                // skip baris yang kosong
                if (!nama) return;

          
                result.push({
                    VarianCode: nama,
                });

            });

            return result;
        }

    </script>
