                        render: function (data, type, full, meta) {
                            if (!data) return ''; // handle null atau undefined

                            const date = new Date(data); // konversi data ke objek Date

                            const day = String(date.getDate()).padStart(2, '0'); // dd
                            const monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                            const month = monthNames[date.getMonth()]; // MMM
                            const year = date.getFullYear(); // yyyy

                            const hours = String(date.getHours()).padStart(2, '0');   // HH
                            const minutes = String(date.getMinutes()).padStart(2, '0'); // mm
                            const seconds = String(date.getSeconds()).padStart(2, '0'); // ss

                            return `${day}-${month}-${year} ${hours}:${minutes}:${seconds}`;
                             
                        }
                    },
                                                       
                    {
                        targets: -1,
                        title: 'Actions',
                        searchable: false,
                        orderable: false,
                        render: (data, type, full, meta) => {
                            return `
