<Report ScriptLanguage="CSharp" ReportInfo.Created="10/20/2025 10:43:38" ReportInfo.Modified="10/31/2025 16:20:38" ReportInfo.CreatorVersion="2025.2.0.0">
  <ScriptText>using System;
using System.Collections;
using System.Collections.Generic;
using System.ComponentModel;
using System.Windows.Forms;
using System.Drawing;
using System.Data;
using FastReport;
using FastReport.Data;
using FastReport.Dialog;
using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {
    decimal hasil = 0;
    string formulaHasil = &quot;&quot;;

    private void Data1_BeforePrint(object sender, EventArgs e)
    {
      decimal res1 = (decimal)Report.GetColumnValue(&quot;tempRatio.Res1&quot;);
      decimal res2 = (decimal)Report.GetColumnValue(&quot;tempRatio.Res2&quot;);
      bool inPercent = (bool)Report.GetColumnValue(&quot;tempRatio.InPercent&quot;);
      
      if (res2 == 0)
      {
        hasil = 0;
        formulaHasil = &quot;0&quot; + (inPercent ? &quot;%&quot; : &quot;&quot;);
      }
      else
      {
        hasil = res1 / Math.Abs(res2);
        if (inPercent)
          hasil *= 100;

        formulaHasil = hasil.ToString(&quot;N2&quot;) + (inPercent ? &quot;%&quot; : &quot;&quot;);
      }
    }
  }
}
</ScriptText>
