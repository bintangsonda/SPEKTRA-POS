@model IDS.Maintenance.UserGroup
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "User Group";
}
@section Styles {
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/select2/select2.css" />

    <style>
        table.table.dataTable > tbody > tr {
            background-color: transparent;
            font-size: 11px;
        }

        .datatables-users thead th {
            font-weight: bold;
            font-size: 11px;
        }

        .datatables-users th,
        .datatables-users td {
            padding-top: 3px;
            padding-bottom: 3px;
            padding-left: 12px;
            padding-right: 12px;
            font-size: 12px;
            vertical-align: middle; /* supaya teks tidak nempel atas */
        }



      
    </style>
}



<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row align-items-center mb-4">
        <div class="col d-flex align-items-center">
            <i class="ri ri-user-3-line me-2 text-primary" style="font-size: 1.5rem;"></i>
            <h4 class="card-title mb-0 fw-semibold text-primary">
                @ViewBag.Title
            </h4>
        </div>
        <div class="col-auto ms-auto">
            <button id="btnAddNew" class="btn btn-primary">
                <i class="ri ri-add-line me-1"></i>
                <span class="d-none d-sm-inline-block">Add New</span>
            </button>
             <button id="btnDeleteBulk" class="btn btn-danger">
                <i class="ri ri-delete-bin-line me-1"></i>
                <span class="d-none d-sm-inline-block">Delete</span>
            </button>
        </div>
    </div>
  
    

    <!-- Users List Table -->
    <div class="card">
        <div class="card-datatable">
            <table id="tableData" class="datatables-users table table-responsive table-sm w-100">
                <thead>
                    <tr>
                        <th>Group Code</th>
                        <th>Group Name</th>
                        <th>Group Parent</th>
                        <th>Operator ID</th>
                        <th>Last Upd</th>
                        <th></th>
                    </tr>
                </thead>
            </table>
        </div>
        <div class="offcanvas offcanvas-end"
             tabindex="-1"
             id="offcanvasAddUser"
             aria-labelledby="offcanvasAddUserLabel">
            <div class="offcanvas-header border-bottom">
                <h5 id="offcanvasAddUserLabel" class="offcanvas-title">Add User</h5>
                <button type="button"
                        class="btn-close text-reset"
                        data-bs-dismiss="offcanvas"
                        aria-label="Close"></button>
            </div>
            <div class="offcanvas-body mx-0 flex-grow-0 h-100">
                @using (Html.BeginForm(null, null, FormMethod.Get, new { @id = "formCreateEdit" }))
                {
                    @Html.Hidden("FormAction", Convert.ToInt32(ViewData["FormAction"]))
                    @Html.Hidden("FormSave", "0")
                    
                    @Html.AntiForgeryToken()
                    <script type="text/javascript">
                        $('form#formCreateEdit').removeData("validator");
                        $('form#formCreateEdit').removeData("unobtrusiveValidation");
                        $.validator.unobtrusive.parse($('form#formCreateEdit'));
                    </script>
                    <div class="form-floating form-floating-outline mb-3">
                        @Html.EditorFor(model => model.GroupCode, new
                            {
                                htmlAttributes = new
                                {
                                    @class = "form-control form-control-sm",
                                    @id = "txtGrpCode",
                                    @placeholder = "User ID",
                                    @maxlength = "20",
                                    @aria_label = "User ID"
                                }
                            })
                        @Html.ValidationMessageFor(model => model.GroupCode, "", new { @class = "text-danger small" })
                        <label for="txtGrpCode">Group Code</label>
                    </div>
                    <div class="form-floating form-floating-outline mb-3">
                        @Html.EditorFor(model => model.GroupName, new
                            {
                                htmlAttributes = new
                                {
                                    @class = "form-control form-control-sm",
                                    @id = "txtGrpName",
                                    @placeholder = "User Name",
                                    @maxlength = "20",
                                    @aria_label = "User Name"
                                }
                            })
                        @Html.ValidationMessageFor(model => model.GroupName, "", new { @class = "text-danger small" })
                        <label for="txtGrpName">Group Name</label>
                    </div>
                  

                    <div class="form-floating form-floating-outline mb-3">
                        @Html.DropDownListFor(model => model.GroupParent,
                                 (SelectList)ViewData["SelectListGroup"],
                                 "", // untuk opsi kosong di atas
                                 new
                                 {
                                     @id = "cboGrpParent",
                                     @class = "form-select select2",
                                 })
                        <label for="cboGrpParent">Group Parent</label>
                        @Html.ValidationMessageFor(model => model.GroupParent, "", new { @class = "text-danger small" })
                    </div>
                }
                <button type="submit" class="btn btn-primary me-sm-3 me-1 data-submit" id="btnSave">Submit</button>
                <button type="reset" class="btn btn-outline-danger" data-bs-dismiss="offcanvas">Cancel</button>
            </div>
        </div>
    </div>
</div>


