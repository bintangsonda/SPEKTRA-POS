<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="10/20/2025 10:43:38" ReportInfo.Modified="11/17/2025 10:28:39" ReportInfo.CreatorVersion="2025.2.0.0">
  <ScriptText>using System;
using System.Collections;
using System.Collections.Generic;
using System.ComponentModel;
using System.Windows.Forms;
using System.Drawing;
using System.Data;
using FastReport;
using FastReport.Data;
using FastReport.Dialog;
using FastReport.Barcode;
using FastReport.Table;
using FastReport.Utils;

namespace FastReport
{
  public class ReportScript
  {
    int columnRow=0;
    decimal sumdisbamtTemp=0;
    decimal percent=0;
    
    private void GroupFooter1_BeforePrint(object sender, EventArgs e)
    {
      if(!Report.Engine.FinalPass){
        return;
      }
      ++columnRow;
      
      if(sumdisbamtTemp==0){
        percent=0;
      }
      else{
        percent=Report.GetTotalValue(&quot;sumdisbamtgrp&quot;)/sumdisbamtTemp*100;
      }
      
    }

    private void DataFooter1_AfterPrint(object sender, EventArgs e)
    {
      sumdisbamtTemp=Report.GetTotalValue(&quot;sumdisbamt&quot;);
    }
  }
}
</ScriptText>
