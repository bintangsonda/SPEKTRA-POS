    decimal C6CurrentAmt6 = 0;
    decimal C7CurrentAmt6 = 0;
    decimal mCurrentAmt6 = 0;
    
    private void Data1_BeforePrint(object sender, EventArgs e) //Hitungan Income Statement
    {
      if(!Report.Engine.FinalPass){
        return;
      }
      
      decimal fromacc = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.fromacc&quot;));
      
      decimal CBegBal1 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Begbal1&quot;));
      decimal CDebit1 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Debit1&quot;));
      decimal CCredit1 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Credit1&quot;));
      
      decimal CBegBal2 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Begbal2&quot;));
      decimal CDebit2 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Debit2&quot;));
      decimal CCredit2 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Credit2&quot;));
      
      decimal CBegBal3 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Begbal3&quot;));
      decimal CDebit3 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Debit3&quot;));
      decimal CCredit3 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Credit3&quot;));
      
      decimal CBegBal4 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Begbal4&quot;));
      decimal CDebit4 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Debit4&quot;));
      decimal CCredit4 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Credit4&quot;));
      
      decimal CBegBal5 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Begbal5&quot;));
      decimal CDebit5 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Debit5&quot;));
      decimal CCredit5 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Credit5&quot;));
      
      decimal CBegBal6 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Begbal6&quot;));
      decimal CDebit6 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Debit6&quot;));
      decimal CCredit6 = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.Credit6&quot;));
      
      decimal multiply = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.multiply&quot;));
      decimal divide = Convert.ToDecimal(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.divide&quot;));
      int dbtcrd = Convert.ToInt32(Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.dbtcrd&quot;));
      
      decimal formula1 = 0;
      decimal formula2 = 0;
      decimal formula3 = 0;
      decimal formula4 = 0;
      decimal formula5 = 0;
      decimal formula6 = 0;
      
      switch ((int)fromacc)
      {
        case 8:
          formula1 = CDebit1 + CCredit1;
          if (dbtcrd == 1) formula1 *= -1;
          formula1 *= (multiply / divide);
          mCurrentAmt1 = formula1;
          
          formula2 = CDebit2 + CCredit2;
          if (dbtcrd == 1) formula2 *= -1;
          formula2 *= (multiply / divide);
          mCurrentAmt2 = formula2;
          
          formula3 = CDebit3 + CCredit3;
          if (dbtcrd == 1) formula3 *= -1;
          formula3 *= (multiply / divide);
          mCurrentAmt3 = formula3;
          
          formula4 = CDebit4 + CCredit4;
          if (dbtcrd == 1) formula4 *= -1;
          formula4 *= (multiply / divide);
          mCurrentAmt4 = formula4;
          
          formula5 = CDebit5 + CCredit5;
          if (dbtcrd == 1) formula5 *= -1;
          formula5 *= (multiply / divide);
          mCurrentAmt5 = formula5;
          
          formula6 = CDebit6 + CCredit6;
          if (dbtcrd == 1) formula6 *= -1;
          formula6 *= (multiply / divide);
          mCurrentAmt6 = formula6;
          
          break;
        case 7: mCurrentAmt1 = C7CurrentAmt1; mCurrentAmt2 = C7CurrentAmt2; mCurrentAmt3 = C7CurrentAmt3; mCurrentAmt4 = C7CurrentAmt4; mCurrentAmt5 = C7CurrentAmt5; mCurrentAmt6 = C7CurrentAmt6; break;
        case 6: mCurrentAmt1 = C6CurrentAmt1; mCurrentAmt2 = C6CurrentAmt2; mCurrentAmt3 = C6CurrentAmt3; mCurrentAmt4 = C6CurrentAmt4; mCurrentAmt5 = C6CurrentAmt5; mCurrentAmt6 = C6CurrentAmt6; break;
        case 5: mCurrentAmt1 = C5CurrentAmt1; mCurrentAmt2 = C5CurrentAmt2; mCurrentAmt3 = C5CurrentAmt3; mCurrentAmt4 = C5CurrentAmt4; mCurrentAmt5 = C5CurrentAmt5; mCurrentAmt6 = C5CurrentAmt6; break;
        case 4: mCurrentAmt1 = C4CurrentAmt1; mCurrentAmt2 = C4CurrentAmt2; mCurrentAmt3 = C4CurrentAmt3; mCurrentAmt4 = C4CurrentAmt4; mCurrentAmt5 = C4CurrentAmt5; mCurrentAmt6 = C4CurrentAmt6; break;
        case 3: mCurrentAmt1 = C3CurrentAmt1; mCurrentAmt2 = C3CurrentAmt2; mCurrentAmt3 = C3CurrentAmt3; mCurrentAmt4 = C3CurrentAmt4; mCurrentAmt5 = C3CurrentAmt5; mCurrentAmt6 = C3CurrentAmt6; break;
        case 2: mCurrentAmt1 = C2CurrentAmt1; mCurrentAmt2 = C2CurrentAmt2; mCurrentAmt3 = C2CurrentAmt3; mCurrentAmt4 = C2CurrentAmt4; mCurrentAmt5 = C2CurrentAmt5; mCurrentAmt6 = C2CurrentAmt6; break;
        case 1: mCurrentAmt1 = C1CurrentAmt1; mCurrentAmt2 = C1CurrentAmt2; mCurrentAmt3 = C1CurrentAmt3; mCurrentAmt4 = C1CurrentAmt4; mCurrentAmt5 = C1CurrentAmt5; mCurrentAmt6 = C1CurrentAmt6; break;
      }
      
      UpdateAmount1(&quot;C1&quot;, ref C1CurrentAmt1);
      UpdateAmount1(&quot;C2&quot;, ref C2CurrentAmt1);
      UpdateAmount1(&quot;C3&quot;, ref C3CurrentAmt1);
      UpdateAmount1(&quot;C4&quot;, ref C4CurrentAmt1);
      UpdateAmount1(&quot;C5&quot;, ref C5CurrentAmt1);
      UpdateAmount1(&quot;C6&quot;, ref C6CurrentAmt1);
      UpdateAmount1(&quot;C7&quot;, ref C7CurrentAmt1);
      
      UpdateAmount2(&quot;C1&quot;, ref C1CurrentAmt2);
      UpdateAmount2(&quot;C2&quot;, ref C2CurrentAmt2);
      UpdateAmount2(&quot;C3&quot;, ref C3CurrentAmt2);
      UpdateAmount2(&quot;C4&quot;, ref C4CurrentAmt2);
      UpdateAmount2(&quot;C5&quot;, ref C5CurrentAmt2);
      UpdateAmount2(&quot;C6&quot;, ref C6CurrentAmt2);
      UpdateAmount2(&quot;C7&quot;, ref C7CurrentAmt2);
      
      UpdateAmount3(&quot;C1&quot;, ref C1CurrentAmt3);
      UpdateAmount3(&quot;C2&quot;, ref C2CurrentAmt3);
      UpdateAmount3(&quot;C3&quot;, ref C3CurrentAmt3);
      UpdateAmount3(&quot;C4&quot;, ref C4CurrentAmt3);
      UpdateAmount3(&quot;C5&quot;, ref C5CurrentAmt3);
      UpdateAmount3(&quot;C6&quot;, ref C6CurrentAmt3);
      UpdateAmount3(&quot;C7&quot;, ref C7CurrentAmt3);
      
      UpdateAmount4(&quot;C1&quot;, ref C1CurrentAmt4);
      UpdateAmount4(&quot;C2&quot;, ref C2CurrentAmt4);
      UpdateAmount4(&quot;C3&quot;, ref C3CurrentAmt4);
      UpdateAmount4(&quot;C4&quot;, ref C4CurrentAmt4);
      UpdateAmount4(&quot;C5&quot;, ref C5CurrentAmt4);
      UpdateAmount4(&quot;C6&quot;, ref C6CurrentAmt4);
      UpdateAmount4(&quot;C7&quot;, ref C7CurrentAmt4);
      
      UpdateAmount5(&quot;C1&quot;, ref C1CurrentAmt5);
      UpdateAmount5(&quot;C2&quot;, ref C2CurrentAmt5);
      UpdateAmount5(&quot;C3&quot;, ref C3CurrentAmt5);
      UpdateAmount5(&quot;C4&quot;, ref C4CurrentAmt5);
      UpdateAmount5(&quot;C5&quot;, ref C5CurrentAmt5);
      UpdateAmount5(&quot;C6&quot;, ref C6CurrentAmt5);
      UpdateAmount5(&quot;C7&quot;, ref C7CurrentAmt5);
      
      UpdateAmount6(&quot;C1&quot;, ref C1CurrentAmt6);
      UpdateAmount6(&quot;C2&quot;, ref C2CurrentAmt6);
      UpdateAmount6(&quot;C3&quot;, ref C3CurrentAmt6);
      UpdateAmount6(&quot;C4&quot;, ref C4CurrentAmt6);
      UpdateAmount6(&quot;C5&quot;, ref C5CurrentAmt6);
      UpdateAmount6(&quot;C6&quot;, ref C6CurrentAmt6);
      UpdateAmount6(&quot;C7&quot;, ref C7CurrentAmt6);
      
    }
    
    private void UpdateAmount1(string colName, ref decimal target)
    {
      var flag = Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.&quot; + colName);
      if (flag == null) return;

      string val = flag.ToString();
      if (val == &quot;+&quot;) target += mCurrentAmt1;
      else if (val == &quot;-&quot;) target -= mCurrentAmt1;
      else if (val == &quot;0&quot;) target = 0;
    }
    
    private void UpdateAmount2(string colName, ref decimal target)
    {
      var flag = Report.GetColumnValue(&quot;GLRepIncomeStatAllBranch.&quot; + colName);
      if (flag == null) return;

      string val = flag.ToString();
      if (val == &quot;+&quot;) target += mCurrentAmt2;
      else if (val == &quot;-&quot;) target -= mCurrentAmt2;
      else if (val == &quot;0&quot;) target = 0;
    }
    
