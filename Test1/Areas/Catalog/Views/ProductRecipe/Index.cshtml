@model General.Catalog.ProductRecipeH
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Product Recipe";
}
<style>


    .status-switch-wrapper {
        margin-bottom: 10px;
    }

    .status-title {
        font-weight: 600;
    }

    .status-badge {
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 12px;
        transition: all 0.3s;
        font-weight: 600;
    }

    /* Active state */
    .status-badge.active {
        background-color: #4caf50;
        color: white;
    }

    /* Inactive state */
    .status-badge.inactive {
        background-color: red;
        color: white;
    }



    .select2-dropdown {
        z-index: 999999 !important;
    }

    .nav-tabs .nav-link.active {
        background-color: #0d6efd !important; /* biru bootstrap */
        color: white !important;
        border-radius: 6px 6px 0 0;
    }

    .nav-tabs .nav-link {
        background-color: #e9ecef; /* warna default tab */
        color: #495057;
        border-radius: 6px 6px 0 0;
    }

    .btn-danger {
        background-color: var(--bs-danger) !important;
        border-color: var(--bs-danger) !important;
        color: #fff !important;
    }

        .btn-danger:hover {
            background-color: #bb2d3b !important;
            border-color: #b02a37 !important;
        }

</style>
@section Styles {
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/select2/select2.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/flatpickr/flatpickr.css" />
    <link rel="stylesheet" href="~/assets/css/custom.css" />

}
@Html.Hidden("PageEdit", Convert.ToInt32(ViewData["Page.Edit"]))
@Html.Hidden("PageDelete", Convert.ToInt32(ViewData["Page.Delete"]))
@Html.Hidden("PageInsert", Convert.ToInt32(ViewData["Page.Insert"]))
@Html.Hidden("FormAction", Convert.ToInt32(ViewData["FormAction"]))

<!--Table Data-->
<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center">
            <i class="ri ri-restaurant-2-line me-2 text-primary" style="font-size: 1.5rem;"></i>
            <h4 class="card-title mb-0 fw-semibold text-primary">
                @ViewBag.Title
            </h4>
        </div>
    </div>
    <div class="card">
        <div class="card-header border-bottom">
            <div class="row g-2 align-items-end">
                <!-- Cabang -->
                <div class="col-sm-4">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownList(
                            "Cabang",
                            ViewData["BranchList"] as SelectList,
                            "All",
                            new { @class = "form-control form-control-sm select2" }
                        )
                        <label for="Cabang">Cabang</label>
                    </div>
                </div>

                <!-- Search -->
                <div class="col-sm-1 d-flex justify-content-start align-items-center">
                    <button type="button"
                            class="btn btn-primary d-flex align-items-center px-3 py-2"
                            onclick="getData()">
                        <i class="ri ri-search-line icon-18px"></i>
                    </button>
                </div>
                </div>
                </div>
        <div class="card-datatable">
            <table id="tableData" class="datatables-custom table table-responsive table-sm w-100">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>Recipe Code</th>
                        <th>Recipe Name</th>
                        <th>Outlet</th>
                        <th>Product Code</th>
                        <th>Product Name</th>
                        <th>Operator ID</th>
                        <th>Last Update</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>
<!--Table Data-->
<!--modal input-->
<div class="modal fade" id="ModalInsert" role="dialog" aria-labelledby="defferedAmmortizeLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content">
            <!-- Header -->
            <div class="modal-header bg-primary py-2 px-3 d-flex justify-content-between align-items-center">
                <h4 class="modal-title mb-0 fw-semibold text-white" id="defferedAmmortizeLabel">
                    Add Recipe
                </h4>
                <button type="button"
                        class="btn shadow-none p-0"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                    <i class="icon-base ri ri-close-large-line icon-md text-white"></i>
                </button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                <!-- NAVIGATION TAB -->
                <ul class="nav nav-tabs " id="variantTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab-info"
                                data-bs-toggle="tab" data-bs-target="#pane-info"
                                type="button" role="tab">
                            Recipe Info
                        </button>
                    </li>

                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-list"
                                data-bs-toggle="tab" data-bs-target="#pane-list"
                                type="button" role="tab">
                           Recipe Formula
                        </button>
                    </li>
                </ul>
                <hr />

                <!-- TAB CONTENT -->
                <div class="tab-content">

                    <!-- ======================= -->
                    <!--   TAB 1 : VARIANT INFO  -->
                    <!-- ======================= -->
                    <div class="tab-pane fade show active" id="pane-info" role="tabpanel">


                        <div class="row gy-2">
                            <div class="col-12">
                                <div class="form-group">

                                    <div class="row g-3">
                                        <!-- Recipe Code -->
                                        <div class="col-12 col-md-4">
                                            <div class="form-floating form-floating-outline mb-3">
                                                @Html.TextBoxFor(model => model.RecipeCode, new
                                                                                                {
                                                    @class = "form-control",
                                                                                                placeholder = "AUTO",
                                                                                                maxlength = 5,
                                                                                                @readonly = "readonly"
                                                                                                })
                                                <label for="RecipeCode">Recipe Code</label>
                                            </div>
                                        </div>

                                        <!-- Recipe Name -->
                                        <div class="col-12 col-md-4">
                                            <div class="form-floating form-floating-outline mb-3">
                                                @Html.TextBoxFor(model => model.RecipeName, new
                                                                                                {
                                                    @class = "form-control",
                                                                                                placeholder = "Input Text Here",
                                                                                                @maxlength = 50
                                                                                                })
                                                <label>Recipe Name</label>
                                            </div>
                                        </div>

                                        <!-- Outlet -->
                                        <div class="col-12 col-md-4">
                                            <div class="form-floating form-floating-outline mb-3">
                                                @Html.DropDownListFor(model => model.BranchCode,
                                                                                                ViewData["BranchList"] as SelectList,
                                                                                                new { @class = "form-control form-control-sm select2" })
                                                <label>Outlet</label>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Product: baris berikutnya -->
                                    <div class="row g-3">
                                        <div class="col-12 col-md-12">
                                            <div class="form-floating form-floating-outline mb-3">
                                                @Html.DropDownListFor(model => model.ProdCode,
                                                                                                ViewData["ProdCodeList"] as SelectList,
                                                                                                new { @class = "form-control form-control-sm select2" })
                                                <label>Product</label>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
       

                    </div>

                    <!-- ========================== -->
                    <!--   TAB 2 : LIST VARIAN     -->
                    <!-- ========================== -->
                    <div class="tab-pane fade" id="pane-list" role="tabpanel">

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0">List Varian Harga</h6>
                            <button type="button" class="btn btn-sm btn-primary" id="btnAddListRecipe">
                                + Tambah
                            </button>
                        </div>

                        <table class="table table-bordered text-center align-middle" id="tableVarianList">
                            <thead>
                                <tr>
                                    <th style="width:20px">#</th>
                                    <th style="width:140px">ProdCode</th>
                                    <th style="width:140px">Qty</th>
                                    <th style="width:30px">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- otomatis terisi dari javascript nanti -->
                            </tbody>
                        </table>
                    </div>
                </div> <!-- end tab content -->
            </div>

            <!-- Footer -->
            <div class="modal-footer px-3 border-0 justify-content-end">
                <button type="button" class="btn btn-secondary btn-sm" id="btnAddNew">
                    <i class="ri ri-reset-left-fill me-1 icon-18px"></i> Add New
                </button>
                <button type="button" class="btn btn-success btn-sm SaveInsert" id="btnSave">
                    <i class="ri ri-check-fill me-1 icon-18px"></i> Save
                </button>
                <button type="button" class="btn btn-danger btn-sm" data-bs-dismiss="modal">
                    <i class="ri ri-close-line me-1 icon-18px"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>
<!--modal input-->
<!-- Loading Page -->
<div id="loading" style="display:none; height:100%; width:100%">
    <div class="loading-wave" id="loading-content">
        <div class="loading-bar"></div>
        <div class="loading-bar"></div>
        <div class="loading-bar"></div>
        <div class="loading-bar"></div>
    </div>
    <div class="loading loading07">
        <span data-text="S">S</span>
        <span data-text="P">P</span>
        <span data-text="E">E</span>
        <span data-text="K">K</span>
        <span data-text="T">T</span>
        <span data-text="R">R</span>
        <span data-text="A">A</span>
    </div>
</div>
<!-- Loading Page -->

<div id="PartialSection">
</div>


@section Scripts {
    <script src="~/assets/vendor/libs/moment/moment.js"></script>
    <script src="~/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/assets/vendor/libs/select2/select2.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/popular.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/bootstrap5.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/auto-focus.js"></script>
    <script src="~/assets/vendor/libs/cleave-zen/cleave-zen.js"></script>
    <script src="~/assets/js/forms-selects.js"></script>
    <script src="~/assets/vendor/libs/tagify/tagify.js"></script>
    <script src="~/assets/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
    <script src="~/assets/vendor/libs/typeahead-js/typeahead.js"></script>
    <script src="~/assets/vendor/libs/bloodhound/bloodhound.js"></script>
    <script src="~/assets/vendor/libs/flatpickr/flatpickr.js"></script>
    <script type="text/javascript">
        const token = $('input[name="__RequestVerificationToken"]').val();
        const getDataUrl = '@Url.Action("GetData", "ProductRecipe", new { area = "Catalog" })';
            let hargaIndex = 1;

        var table = null;

        $(document).ready(function () {
            $('.select2').select2();
            table=getData();
            if ($('#PageInsert').val() == 0) {
                $('.AddNew').prop('disabled', true);
            }
        });


      

        function getData() {
            return $('#tableData').DataTable({
                bDestroy: true,
                processing: true,
                serverSide: true,
                "bAutoWidth": true,
                scrollX: true,
                ajax: {
                    url: getDataUrl,
                    type: 'POST',
                    dataType: "JSON",
                    data: {
                        Branch: $("#Cabang").val()
                    }
                },
                columns: [
                    { data: 'action', name: 'action', orderable: false },
                    { data: "RecipeCode", name: "RecipeCode" },
                    { "data": "RecipeName", "name": "RecipeName" },
                    { "data": "BranchCode", "name": "BranchCode" },
                    { "data": "ProdCode", "name": "ProdCode" },
                    { "data": "ProdName", "name": "ProdName" },
                    { "data": "OperatorID", "name": "OperatorID" },
                    {
                        "data": "LastUpdate", "name": "LastUpdate",
                        "render": function (data, type, row, meta) {
                            return moment(row.LastUpdate).format('DD/MMM/YYYY');
                        }
                    },
                ],
                columnDefs: [
                    {
                        targets: [0],
                        title: 'Actions',
                        searchable: false,
                        orderable: false,
                        render: (data, type, full, meta) => {
                            return `
                        <div class="d-flex align-items-center">
                            <a href="javascript:;"
                                class="btn btn-icon btn-text-danger rounded-pill delete-record"
                                data-code="${full.RecipeCode}">
                                <i class="icon-base ri ri-delete-bin-7-line icon-md text-danger"></i>
                            </a>
                            <a href="javascript:;"
                               class="btn btn-icon btn-text-warning rounded-pill edit-record"
                               data-code="${full.RecipeCode}">
                                <i class="icon-base ri ri-pencil-line icon-md text-warning"></i>
                            </a>


                        </div>
                    `;
                        }
                    },

                    {
                        "targets": [1]
                    },
                    {
                        "targets": [2]
                    },
                    {
                        "targets": [3]
                    },
                    {
                        "targets": [4]
                    },
                    {
                        "targets": [5]
                    },
                    {
                        "targets": [6]
                    },
                    {
                        "targets": [7]
                    },
                ],
                select: {
                    style: 'os',
                },
                order: [[2, 'desc']],
                layout: {
                    topStart: {
                        rowClass: 'row m-2 my-0 mt-0 justify-content-between',
                        features: [
                            {
                                pageLength: {
                                    menu: [[1, 10, 25, 50, 100, 1000, -1], [1, 10, 25, 50, 100, 1000, "All"]],
                                    text: 'Show _MENU_ entries'
                                }
                            },
                        ]
                    },
                    topEnd: {
                        features: [
                            {
                                buttons: [
                                    {
                                        text: `
                                            <i class="icon-base ri ri-add-line icon-sm me-0 d-inline-block"></i>
                                            <span class="d-none d-sm-inline-block">Add</span>
                                        `,
                                        className: 'btn add-new me-2 d-flex align-items-center',  // 🔥 warna + jarak kanan + center
                                        action: function (e, dt, node, config) {
                                            $("#RecipeCode").prop("disabled",false)
                                            $("#defferedAmmortizeLabel").text("Add Recipe")
                                              // ➜ Disable tab Varian Harga
                                            
                                            ClearModal();
                                            let modal = new bootstrap.Modal(document.getElementById('ModalInsert'));
                                            modal.show();
                                                 // ➜ Sembunyikan tab "Varian Harga"
                                                $("#tab-list").closest("li").hide();

                                                // ➜ Pastikan tetap berada di tab Info
                                                $("#tab-info").click();
                                             $("#FormAction").val(1)
                                        }
                                    }
                                ]
                            },


                            {
                                search: {
                                    placeholder: 'Search User',
                                    text: '_INPUT_'
                                }
                            },

                        ]
                    },
                    bottomStart: {
                        rowClass: 'row mx-3 justify-content-between',
                        features: ['info']
                    },
                    bottomEnd: 'paging'
                },
                language: {
                    paginate: {
                        next: '<i class="icon-base ri ri-arrow-right-s-line scaleX-n1-rtl icon-22px"></i>',
                        previous: '<i class="icon-base ri ri-arrow-left-s-line scaleX-n1-rtl icon-22px"></i>',
                        first: '<i class="icon-base ri ri-skip-back-mini-line scaleX-n1-rtl icon-22px"></i>',
                        last: '<i class="icon-base ri ri-skip-forward-mini-line scaleX-n1-rtl icon-22px"></i>'
                    }
                },


            });


        }

              
        $("#btnAddListRecipe").on("click", function () {

            let rowCount = $("#tableVarianList tbody tr").length;

            if (rowCount > 0) {
                let lastRow = $("#tableVarianList tbody tr").last();

                const ProdCode = lastRow.find("td:nth-child(2) select").val();
                const Qty = lastRow.find("td:nth-child(3) input").val()?.trim();

                if (!ProdCode || !Qty) {
                    SweetAlertError(
                        'Failed!',
                        "Product dan Qty harus diisi dulu!"
                    );
                    return;
                }
            }

            $("#tableVarianList tbody").append(`
                <tr>
                            <td class="text-center align-middle">${rowCount + 1}</td>

                    <td class="text-center align-middle">
                        <select class="form-select form-select-sm text-center select2">
                            <option value="">-- Pilih Product --</option>
                            ${$("#ProdCode option").map(function () {
                                if ($(this).val() === "") return "";
                                return `<option value="${$(this).val()}">${$(this).text()}</option>`;
                            }).get().join("")}
                        </select>
                    </td>

                    <td class="text-center align-middle">
                        <input type="text"
                               class="form-control form-control-sm text-center"
                               style="max-width: 80px; margin: auto;"
                               onkeyup="AddCommaDecimal(this)"
                               placeholder="Qty" />
                    </td>

                    <td class="text-center align-middle">
                        <button type="button"
                                class="btn btn-sm btn-danger btnDelRow p-1 px-2">
                            <i class="ri ri-delete-bin-line icon-18px"></i>
                        </button>
                    </td>
                </tr>
            `);

            hargaIndex++;

            $("#tableVarianList tbody tr:last .select2").select2({
                width: "100%",
                placeholder: "-- Pilih Product --",
                allowClear: true,
                minimumResultsForSearch: 0,
                dropdownParent: $("#pane-list")
            });

        });
     
        
        $(document).on("click", ".btnDelRow", function () {
            $(this).closest("tr").remove();
        });

        $('.datatables-custom').on('click', '.edit-record', function () {
            const code = $(this).data('code');
            $("#tab-list").closest("li").show();
            hargaIndex=1;
             $.ajax({
                type: 'GET',
                url: '@Url.Action("Edit", "ProductRecipe", new { Area = "Catalog" })',
                data: { RecipeCode: code },
                success: function (data) {
                    SweetAlertClose();
                    if (data) {
                        $("#RecipeName").val(data.RecipeName)
                        $("#RecipeCode").prop("disabled",true)
                        $("#RecipeCode").val(code)
                        $("#ProdCode").val(data.ProdCode)
                        $("#BranchCode").val(data.BranchCode)
                         $("#BranchCode").prop("disabled",true)

                        $("#tableVarianList tbody").empty();

                        if (data.RecipeDetail && data.RecipeDetail.length > 0) {
                            $("#tableVarianList tbody").empty();
                            data.RecipeDetail.forEach((item, index) => {

                                $("#tableVarianList tbody").append(`
                                    <tr>
                                        <td class="text-center align-middle">${index + 1}</td>

                                        <td class="text-center align-middle">
                                            <select class="form-select form-select-sm text-center select2">
                                                <option value="">-- Pilih Product --</option>
                                            </select>
                                        </td>

                                        <td class="text-center align-middle">
                                            <input type="text"
                                                   class="form-control form-control-sm text-center"
                                                   style="max-width: 80px; margin: auto;"
                                                   onkeyup="AddCommaDecimal(this)"
                                                   value="${item.Qty ?? ''}"
                                                   placeholder="Qty" />
                                        </td>

                                        <td class="text-center align-middle">
                                            <button type="button" class="btn btn-sm btn-danger btnDelRow p-1 px-2">
                                                <i class="ri ri-delete-bin-line icon-18px"></i>
                                            </button>
                                        </td>
                                    </tr>
                                `);

                                let dropdown = $("#tableVarianList tbody tr:last .select2");

                                // Salin pilihan dari dropdown Product utama
                                $("#ProdCode option").each(function () {
                                    if ($(this).val() !== "") {
                                        dropdown.append(
                                            $("<option>", {
                                                value: $(this).val(),
                                                text: $(this).text()
                                            })
                                        );
                                    }
                                });

                                // Inisialisasi Select2
                                dropdown.select2({
                                    width: "100%",
                                    placeholder: "-- Pilih Product --",
                                    allowClear: true,
                                    minimumResultsForSearch: 0
                                });

                                // Pilih product sesuai data detail
                                dropdown.val(item.ProdCode).trigger("change");
                                    
                            });

                        
                    }


                        $("#defferedAmmortizeLabel").text("Edit Recipe")
                        let modal = new bootstrap.Modal(document.getElementById('ModalInsert'));
                        modal.show();
                        $("#FormAction").val(2)
                    } else {
                        SweetAlertError('Not Found', 'Category data could not be found.');
                    }
                },
                error: function () {
                    SweetAlertError('Error', 'Failed to load Category data. Please try again.');
                }
            });

        });

        $('.datatables-custom').on('click', '.delete-record', function () {
            if ($('#PageDelete').val() == 1) {
                const code = $(this).data('code');
                SweetAlertConfirm(
                    'Delete Confirmation',
                    'Are you sure you want to delete this data, Recipe Code:' + code,
                    function () {
                        var a = document.getElementById('loading');
                        a.style.display = "block";
                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("Delete", "ProductRecipe", new { Area = "Catalog" })',
                            data: {
                                "DataModal":{
                                    "RecipeCode":code,
                                }
                            },
                            dataType: 'JSON',
                            success: function (respond) {
                                a.style.display = "none";
                                if(respond.success==1){
                                    table=getData();
                                    SweetAlertSuccess('Success!', respond.msg);
                                }
                                else if(respond.success==0){
                                    SweetAlertError('Failed!', respond.msg);
                                }
                                else{
                                    table=getData();
                                    SweetAlertSuccess('Success!', respond.msg);
                                }
                            },
                            error: function (respond, xhr, msg) {
                                a.style.display = "none";
                                SweetAlertError('Failed!', respond);
                            }
                        })
                    }
                );
            }
        });

        $("#btnAddNew").on('click', function () {
            ClearModal();
            $("#defferedAmmortizeLabel").text("Add Recipe");
            $("#VarianCode").prop("disabled", false);

            $("#FormAction").val(1);
        });

         
        $('#btnSave').on('click', function () {
            if ($('#PageInsert').val() == 1) {

                const code = $("#RecipeCode").val();
                const name = $("#RecipeName").val();
                const branch = $("#BranchCode").val();
                const prodcode = $("#ProdCode").val();

                if (
                    
                    name == null || name === "" ||
                    branch == null || branch === "" ||
                    prodcode == null || prodcode === ""
                ) {
                    SweetAlertError('Failed!', "All Field are Mandatory!");
                    return false;
                }

                // Ambil detail dari tabel varian
                var resDetail = GetRecipeDetail();


                SweetAlertConfirm(
                    'Confirmation',
                    'Are you sure you want to Save this data, Recipe Code: ' + code,
                    function () {

                        var a = document.getElementById('loading');
                        a.style.display = "block";

                        // Data utama
                        var ajaxData = {
                            "dataModal.RecipeCode": code,
                            "dataModal.RecipeName": name,
                            "dataModal.BranchCode": branch,
                            "dataModal.ProdCode": prodcode,
                            "FormAction": $("#FormAction").val()
                        };

                        // Data detail untuk model binder ASP.NET MVC
                        resDetail.forEach(function (item, index) {
                            ajaxData[`dataModal.RecipeDetail[${index}].RecipeCode`] = code;
                            ajaxData[`dataModal.RecipeDetail[${index}].seqNo`] = item.seqNo;
                            ajaxData[`dataModal.RecipeDetail[${index}].ProdCode`] = item.ProdCode;
                            ajaxData[`dataModal.RecipeDetail[${index}].Qty`] = item.Qty;
                        });


                        $.ajax({
                            type: "POST",
                            url: '@Url.Action("Create", "ProductRecipe", new { Area = "Catalog" })',
                            data: ajaxData,
                            dataType: "json",

                            success: function (respond) {
                                a.style.display = "none";
                                if (respond.success == 1) {
                                    table = getData();

                                    SweetAlertSuccess('Success!', respond.msg);

                                    $("#FormAction").val('2');
                                    $("#RecipeCode").prop("disabled", true);
                                    $("#RecipeCode").val(respond.sno)
                                    $("#defferedAmmortizeLabel").text("Edit Recipe");
                                    $("#tab-list").closest("li").show();
                                }
                                else if (respond.success == 0) {
                                    SweetAlertError('Failed!', respond.msg);
                                }
                                else {
                                    table = getData();

                                    SweetAlertSuccess('Success!', respond.msg);

                                    $("#FormAction").val('2');
                                    $("#RecipeCode").prop("disabled", true);
                                    $("#RecipeCode").val(respond.sno)
                                    $("#defferedAmmortizeLabel").text("Edit Recipe");
                                    $("#tab-list").closest("li").show();
                                }
                            },

                            error: function (xhr, status, error) {
                                a.style.display = "none";

                                console.error("AJAX Error:", error);
                                console.error("Response:", xhr.responseText);

                                SweetAlertError('Failed!', "Failed to save data.");
                            }
                        });
                    }
                );
            }
        });
       

        function ClearModal() {
            $("#ModalInsert")
                .find("input[type='text'], textarea")
                .val("");
            $("#RecipeCode").val("")
            $("#RecipeName").val("");
            $("#Branch").val(0).trigger('change');
            $("#ProdCode").val(0).trigger('change');

            $("#tableVarianList tbody").empty();
            hargaIndex=1;

        }

        function GetRecipeDetail() {
            let result = [];

            $("#tableVarianList tbody tr").each(function (index) {
                let row = $(this);

                let prodCode = row.find("td:nth-child(2) select").val();
                let qty = row.find("td:nth-child(3) input").val()?.trim();

                if (!prodCode || !qty) return;

                result.push({
                    seqNo: index + 1,
                    ProdCode: prodCode,
                    Qty: parseFloat(qty.replace(/,/g, ""))
                });
            });

            console.log("Recipe Detail:", result);

            return result;
        }



        $("#BranchCode").on("change", function () {
            var branchCode = $(this).val();

            $.ajax({
                url: '@Url.Action("GetProductList", "ProductRecipe")',
                type: "GET",
                dataType: "json",
                data: {
                    Branch: branchCode
                },
                success: function (response) {
                    var productDropdown = $("#ProdCode");

                    productDropdown.empty();
                    productDropdown.append(
                        $("<option>", {
                            value: "",
                            text: "-- Select Product --"
                        })
                    );

                    $.each(response, function (i, item) {
                        productDropdown.append(
                            $("<option>", {
                                value: item.Value,
                                text: item.Text
                            })
                        );
                    });

                    productDropdown.trigger("change");
                },
                error: function (xhr, status, error) {
                    console.error("Gagal mengambil product list:", error);
                }
            });
        });

    </script>
}
