        $('.datatables-custom').on('click', '.duplicate-record', function () {
            const code = $(this).data('code');
            const outlet = $(this).data('outlet');
            let modal = new bootstrap.Modal(document.getElementById('ModalDuplicate'));
            modal.show();
            ClearModal()
            $("#productCode").val(code)
            $("#OutletFrom").val(outlet).select2()
            $('#OutletTo').select2({
                dropdownParent: $('#ModalDuplicate')
            });
