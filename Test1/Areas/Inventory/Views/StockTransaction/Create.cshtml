@model SPOS.Inventory.Stock.StockTransactionH
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Stock Transaction";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-bs5/datatables.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-responsive-bs5/responsive.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/datatables-buttons-bs5/buttons.bootstrap5.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/select2/select2.css" />
    <link rel="stylesheet" href="~/assets/vendor/libs/flatpickr/flatpickr.css" />
    <link rel="stylesheet" href="~/assets/css/custom.css" />

}
@Html.Hidden("PageEdit", Convert.ToInt32(ViewData["Page.Edit"]))
@Html.Hidden("PageDelete", Convert.ToInt32(ViewData["Page.Delete"]))
@Html.Hidden("PageInsert", Convert.ToInt32(ViewData["Page.Insert"]))
@Html.Hidden("FormAction", Convert.ToInt32(ViewData["FormAction"]))




<div class="container-xxl flex-grow-1 container-p-y">

    <div class="card">

        <!-- Header -->
        <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-white">Add Stock Transaction</h5>
        </div>

        <!-- Body -->
        <div class="card-body">

            <div class="row g-3 mt-3">

                <!-- Trans No -->
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(model => model.TransNo, new
                                                {
                            @class = "form-control",
                                                placeholder = "AUTO",
                                                maxlength = 10,
                                                @readonly = "readonly"
                                                })
                        <label>Trans No</label>
                    </div>
                </div>

                <!-- Trans Code -->
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="form-floating form-floating-outline">
                        @Html.DropDownListFor(
                                                model => model.TransCode,
                                                new List<SelectListItem>
                                                {
                                                new SelectListItem
                                                {
                                                Value = "stkin",
                                                Text = "Stock In"
                                                },
                                                new SelectListItem
                                                {
                                                Value = "stkad",
                                                Text = "Stock Adjust"
                                                }
                                                },
                                                "-- Select Transaction --",
                                                new { @class = "form-control form-control-sm select2" }
                                                )
                        <label>Trans Code</label>
                    </div>
                </div>

                <!-- Trans Date -->
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="form-floating form-floating-outline">
                        <div class="form-floating form-floating-outline">
                            @Html.TextBoxFor(
                                                        model => model.TransDate,
                                                        Model == null
                                                        ? ""
                                                        : Model.TransDate.ToString(
                                                        "dd/MMM/yyyy",
                                                        System.Globalization.CultureInfo.InvariantCulture
                                                        ),
                                                        new
                                                        {
                                                            id = "TransDate",
                                                            @class = "form-control flatpickr-date",
                                                            type = "text",
                                                            placeholder = "dd/MMM/yyyy",
                                                            autocomplete = "off"
                                                        }
                                                        )
                            <label for="TransDate">Trans Date</label>
                        </div>
                    </div>
                </div>

                <!-- Process -->
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBox(
                            "Process",
                            Model == null ? "Open" :
                            Model.Process == 0 ? "Open" :
                            Model.Process == 1 ? "Processed" :
                            Model.Process == 2 ? "Cancel" : "-",
                            new
                            {
                                @class = "form-control",
                                placeholder = "Process",
                                @readonly = "readonly"
                            }
                            )
                        <label>Status</label>
                    </div>
                </div>

                <!-- Process Date -->
                @{
                    var processDate = Model?.ProcessDate;
                }

                <div class="col-12 col-md-6 col-lg-3">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBox(
                        "ProcessDate",
                        processDate.HasValue
                        ? processDate.Value.ToString(
                        "dd/MMM/yyyy",
                        System.Globalization.CultureInfo.InvariantCulture
                        )
                        : "",
                        new
                        {
                            @class = "form-control",
                            placeholder = "Process Date",
                            @readonly = "readonly"
                        }
                        )
                        <label for="ProcessDate">Process Date</label>
                    </div>
                </div>

                <!-- Remark -->
                <div class="col-12 col-md-6 col-lg-9">
                    <div class="form-floating form-floating-outline">
                        @Html.TextBoxFor(model => model.Remark, new
                                                {
                            @class = "form-control",
                                                placeholder = "Remark"
                                                })
                        <label>Remark</label>
                    </div>
                </div>

            </div>

            <hr class="my-4" />

            <!-- Detail Transaction -->
            <div class="row mt-4">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Transaction Details</h5>

                            <button type="button"
                                    class="btn btn-primary"
                                    onclick="addDetailRow()">
                                <i class="ti ti-plus me-1"></i> Add Data
                            </button>
                        </div>

                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered table-hover"
                                       id="detailTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th style="width: 80px;">Seq</th>
                                            <th style="min-width: 180px;">ProdCode</th>
                                            <th style="width: 150px;">Qty</th>
                                            <th>Remark</th>
                                            <th style="width: 100px;" class="text-center">
                                                Action
                                            </th>
                                        </tr>
                                    </thead>

                                    <tbody id="detailTableBody">
                                        <!-- Rows generated by JavaScript -->
                                    </tbody>
                                </table>
                            </div>

                            <div id="emptyDetailMessage"
                                 class="text-center text-muted py-3">
                                No detail data. Click Add Data to add a row.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <hr class="my-4" />
            <!-- Footer -->
            <div class="d-flex flex-wrap justify-content-end gap-2">

                <button type="button"
                        class="btn btn-secondary"
                        id="btnAddNew">
                    <i class="ri ri-reset-left-fill me-1"></i>
                    Add New
                </button>

                <button type="button"
                        class="btn btn-success SaveInsert"
                        id="btnSave_Deffered">
                    <i class="ri ri-check-fill me-1"></i>
                    Save
                </button>

                <a href="@Url.Action("Index", "TransactionList", new { area = "Employee" })"
                   class="btn btn-danger">
                    <i class="ri ri-arrow-left-line me-1"></i>
                    Back
                </a>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script src="~/assets/vendor/libs/moment/moment.js"></script>
    <script src="~/assets/vendor/libs/datatables-bs5/datatables-bootstrap5.js"></script>
    <script src="~/assets/vendor/libs/select2/select2.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/popular.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/bootstrap5.js"></script>
    <script src="~/assets/vendor/libs/@@form-validation/auto-focus.js"></script>
    <script src="~/assets/vendor/libs/cleave-zen/cleave-zen.js"></script>
    <script src="~/assets/js/forms-selects.js"></script>
    <script src="~/assets/vendor/libs/tagify/tagify.js"></script>
    <script src="~/assets/vendor/libs/bootstrap-select/bootstrap-select.js"></script>
    <script src="~/assets/vendor/libs/typeahead-js/typeahead.js"></script>
    <script src="~/assets/vendor/libs/bloodhound/bloodhound.js"></script>
    <script src="~/assets/vendor/libs/flatpickr/flatpickr.js"></script>
    <script type="text/javascript">
        const token = $('input[name="__RequestVerificationToken"]').val();
        const getDataUrl = '@Url.Action("GetData", "TransactionList", new { area = "Employee" })';

        var table = null;
        var nilaiTampung = "";
        $('.select2').select2();

        $(document).ready(function () {
              flatpickr("#TransDate,#ProcessDate", {
                dateFormat: "d/M/Y",
                disableMobile: true,
                static: true,
            });
        });






    </script>
}
