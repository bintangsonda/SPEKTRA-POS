                    $.ajax({
                    type: "GET",
                    url: '@Url.Action("ViewUpdate", "History", new { Area = "Maintenance" })',
                    data: {
                        'id': id
                    },
                    dataType: 'html',
                    success: function (result) {
                        $('#PartialSectionSecond').empty();
                        $("#PartialSectionSecond").html(result);
                        $("#modalTitle").html("History View");
                        $("#CreateEditForm").modal('show');

                    },
                        error: function (status) {
                            alert('');
                        }
                });
