</body>
<div id="PartialSection">

</div>
@section Scripts {
    <script src="~/Scripts/moment.min.js"></script>
    <script type="text/javascript" src="~/Content/DataTables/datatables.min.js"></script>
    <script type="text/javascript" src="~/Content/DataTables/DataTables-1.10.25/js/dataTables.bootstrap5.min.js"></script>
    <script type="text/javascript" src="~/Content/DataTables/Select-1.3.3/js/select.bootstrap5.js"></script>
    <script type="text/javascript" src="~/Content/Select2/js/select2.full.min.js"></script>
    <script type="text/javascript" src="~/Scripts/GeneralDataTable.js"></script>
    <script type="text/javascript">
        const token = $('input[name="__RequestVerificationToken"]').val();
         var table = null;
        $('.select2DDList').select2();

        $(document).ready(function () {

            getData();
        });

        function getData()
         {
             table = $('#tableData').DataTable
            ({
                "destroy": true,
                "scrollX": true,
                "bAutoWidth": true,
                //"scrollCollapse": true,
                //"fixedColumns": true,
                "columnDefs": [
                    {

                        "width": "20px",
                        "targets": [0]
                    },
                    {

                        "width": "100px",
                        "targets": [1]
                    },
                    {

                        "width": "70px",
                        "targets": [2]
                    },
                    {

                        "width": "80px",
                        "targets": [3]
                    },
                    {

                        "width": "120px",
                        "targets": [4]
                    },
                    {

                        "width": "50px",
                        "targets": [5]
                    },
                    {

                        "width": "150px",
                        "targets": [6]
                    },
                    {
                        "visible":false,
                        "width": "120px",
                        "targets": [7]
                    },
                    {

                        "width": "150px",
                        "targets": [8]
                    },
                    {

                        "width": "150px",
                        "targets": [9]
                    },
                    {

                        "width": "100px",
                        "targets": [10]
                    },
                    {

                        "width": "100px",
                        "targets": [11]
                    },
                    {

                        "width": "150px",
                        "targets": [12]
                    },
                    {

                        "width": "100px",
                        "targets": [13]
                    },
                    {

                        "width": "300px",
                        "targets": [14]
                    },



                ],
                "select": {
                    "style": 'single',
                    //"selector": 'td:first-child'
                },
                "language":
                {
                    "search": "",
                    "searchPlaceholder": "Search...",
                    "emptyTable": "No record found.",
                    "processing": "<div class='overlay custom-loader-background'><i class='fa fa-cog fa-spin custom-loader-color'></i></div>"
                },
                "processing": "true",
                "order": [[0, "desc"]],
                "serverSide": "true",
                "lengthMenu": [[1, 10, 20, 50, 100, 1000, -1], [1, 10, 20, 50, 100, 1000, "All"]],
                "pageLength": 10,
                "ajax":
                {
                    "url": '@Url.Action("GetData", "RequestApproval", new { Area = "Maintenance" })',
                    "type": "POST",
                    "dataType": "JSON",
                    "data": {
                        branch: $('#cboBranch').val(),
                        reqstatus: -1,
                        //Modif Jeremi 20 Mei 2024
                        appstatus: (new URLSearchParams(window.location.search).get('status')) || parseInt($('#cboApprove').val()),
                        reqstatus: (new URLSearchParams(window.location.search).get('reqstatus')) || null,
                        menuurl: (new URLSearchParams(window.location.search).get('menuurl')) || null,
                    }
                },
                "columns": [
                    //{
                    //    "className": 'details-control',
                    //    "data": null
                    //},
                    {
                        "data": "RequestID", "name": "RequestID",

                    },
                    {
                        "data": "RequestDate", "name": "RequestDate",
                        "render": function (data, type, row, meta) {
                            return moment(row.RequestDate).format('DD/MMM/YYYY HH:mm:ss');
                        }
                    },
                    { "data": "BranchCode", "name": "BranchCode" },
                    {
                        "data": "ApprovalStatus", "name": "ApprovalStatus",
                        "render": function (data, type, row, meta) {
                            switch (row.ApprovalStatus) {
                                case 0:
                                    return "<span style=\"font-size:100%;\" class=\"badge badge-primary\">Need Approve</span>";
                                    break;
                                case 2:
                                    return "<span style=\"font-size:100%;\" class=\"badge badge-danger\">Rejected</span>";
                                    break;
                                case 1:
                                    return "<span style=\"font-size:100%;\" class=\"badge badge-success\">Approved</span>";
                                    break;
                                default:
                                    return row.SOAStatus;
                            }
                        }
                    },
                    { "data": "RequestUserId", "name": "RequestUserId" },
                    { "data": "ActionName", "name": "ActionName" },
                    { "data": "MenuName", "name": "MenuName" },
                    { "data": "MenuUrl", "name": "MenuUrl" },
                    { "data": "KeyField1", "name": "KeyField1" },
                    { "data": "KeyField2", "name": "KeyField2" },
                    { "data": "KeyField3", "name": "KeyField3" },
                    { "data": "KeyField4", "name": "KeyField4" },
                    { "data": "ApprovalUser", "name": "ApprovalUser" },
                    {
                        "data": "ApprovalDate", "name": "ApprovalDate",
                        "render": function (data, type, row, meta) {
                            return moment(row.ApprovalDate).format('DD/MMM/YYYY HH:mm:ss');
                        }
                    },

                    {
                        "data": "UserComment", "name": "UserComment",
                        "render": function (data, type, row, meta) {
                            switch (data) {
                                case "1":
                                    return "Kesalahan Data";
                                    break;
                                case "2":
                                    return "Pengkinian Data";
                                    break;
                                default:
                                    return data;
                                    break;
                            }
                        }
                    },


                ],
            });
        }

        function Approve() {
            var table = $('#tableData').DataTable();
            var selRow = table.rows('.selected').data();
            if (selRow[0] == undefined) {
                alert("No Data Selected!")
                return false;
            }
            var conf = confirm("are you sure want to approve this data ?")
            if (conf) {

                 if (selRow[0].ApprovalStatus == 1) {
                     alert('Data has been Approved, please choose other data!');
                     return false;
                 }
                 else if (selRow[0].ApprovalStatus == 2) {
                     alert('Data has been Rejected, please choose other data!');
                     return false;
                 }
                var reqid = selRow[0].RequestID;
                var reqUrl = selRow[0].MenuUrl;
                var a = document.getElementById('loading');
                a.style.display = "block";
                     $.ajax({
                         type: "POST",
                         url: '@Url.Action("UpdateStatusApproval", "RequestApproval", new { Area = "Maintenance" })',
                         data: {
                             'requestID': parseInt(reqid),
                             'status': 1,
                             'req': 0,
                         },
                         dataType: 'json',
                         success: function (result) {
                             a.style.display = "none";
                             alert(result.Message);
                             getData();
                         },
                         error: function (status) {
                             alert(status);
                         }
                     });
            }

        }

        function Reject() {
            var table = $('#tableData').DataTable();
            var selRow = table.rows('.selected').data();
            if (selRow[0] == undefined) {
                alert("No Data Selected!")
                return false;
            }
            var conf = confirm("are you sure want to Reject this data ?")
            if (conf) {
                var table = $('#tableData').DataTable();
                var selRow = table.rows('.selected').data();
                if (selRow[0].ApprovalStatus == 1) {
                    alert('Data has been Approved, please choose other data!');
                    return false;
                }
                else if (selRow[0].ApprovalStatus == 2) {
                    alert('Data has been Rejected, please choose other data!');
                    return false;
                }
                var reqid = selRow[0].RequestID;
                var reqUrl = selRow[0].MenuUrl;
                var a = document.getElementById('loading');
                a.style.display = "block";
                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("UpdateStatusApproval", "RequestApproval", new { Area = "Maintenance" })',
                        data: {
                            'requestID': parseInt(reqid),
                            'status': 2,
                            'req': 1,
                        },
                        dataType: 'json',
                        success: function (result) {
                            a.style.display = "none";
                            alert(result.Message);
                            getData();
                        },
                        error: function (status) {
                            $('#loadingModal').modal('hide');
                            alert('');
                        }
                    });
            }

        }

        function ViewDatas() {
            var table = $('#tableData').DataTable();
            var selRow = table.rows('.selected').data();
            if (selRow[0] == undefined) {
                alert("No Data Selected!")
                return false;
            }
            switch (selRow[0].MenuName) {
                case "Asset Collateral":
                    window.open('@Url.Action("Edit", "AssetCollateral", new { Area = "LeaseTrans" })' + "?assetNo=" + selRow[0].KeyField1);
                    break;
                case "Asset Contract":
                    window.open('@Url.Action("Edit", "AssetContract", new { Area = "LeaseTrans" })' + "?assCodeEdit=" + selRow[0].KeyField1 + "&branchCode=" + selRow[0].KeyField2 + "&custCode=" + selRow[0].KeyField3);
                    break;
                case "Fixed Asset List":
                    window.open('@Url.Action("Edit", "FAAsset", new { Area = "FixedAsset" })' + "?assetNo=" + selRow[0].KeyField1 + "&branchCode=" + selRow[0].KeyField2);
                    break;
                case "Contract":
                    window.open('@Url.Action("EditFromDisburse", "LeaseContract", new { Area = "LeaseTrans" })' + "?k=" + selRow[0].KeyField1);
                    break;
                case "Customer":
                    if (selRow[0].KeyField3 == "Customer Company") {
                        window.open('@Url.Action("EditCreateCompany", "Customer", new { Area = "LeaseTable" })' + "?LesseeNo=" + selRow[0].KeyField1 + "&Branchs=" + selRow[0].KeyField2);
                    }
                    else {
                        window.open('@Url.Action("EditCreatePersonal", "Customer", new { Area = "LeaseTable" })' + "?LesseeNo=" + selRow[0].KeyField1 + "&Branchs=" + selRow[0].KeyField2);
                    }
                    break;
            }
        }

        //Add by Jeremi 2 Agustus 2024
        function ViewChanges() {
            var table = $('#tableData').DataTable();
            var selRow = table.rows('.selected').data();
            if (selRow[0] == undefined) {
                alert("No Data Selected!")
                return false;
            }
        }

        //Add Jeremi 24 Mei 2024
        $(document).ready(function () {
            updateURL();

            // Function to update the URL without the status and type parameters
            function updateURL() {
                var newUrl = removeURLParameters(window.location.href, ['status', 'reqstatus', 'ApprovalStatus', 'menuurl']);
                // Redirect to the new URL
                window.history.replaceState({}, document.title, newUrl);
            }

            // Function to remove parameters from the URL
            function removeURLParameters(url, parameters) {
                var urlParts = url.split('?');
                if (urlParts.length >= 2) {
                    var queryParams = new URLSearchParams(urlParts[1]);

                    // Loop through parameters and remove them
                    parameters.forEach(function (parameter) {
                        queryParams.delete(parameter);
                    });

                    // Construct new URL without specified parameters
                    if (queryParams.toString() !== '') {
                        return urlParts[0] + '?' + queryParams.toString();
                    } else {
                        return urlParts[0];
                    }
                }
                return url;
            }
        });
    </script>
}
