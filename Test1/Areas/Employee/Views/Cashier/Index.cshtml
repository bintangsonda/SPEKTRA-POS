                                <span>QRIS</span>
                            </label>

                            <label class="type-option">
                                <input type="radio" name="PayMethod" value="Trans">
                                <span>Transfer</span>
                            </label>

                            <label class="type-option">
                                <input type="radio" name="PayMethod" value="Other">
                                <span>Other</span>
                            </label>
                        </div>
                   </div>
                </div>

                <!-- Payment Type -->
                <div class="mb-4">
                    <p class="fw-bold mb-2">Payment Type</p>

                   @* CASH =======================================>*@
                   <div id="CashMethod" >
                       <div class="d-flex flex-wrap gap-5">
                            <label class="type-option">
                                <input type="radio" name="PayType" value="UangPas" checked>
                                <span>Uang Pas</span>
                            </label>

                            <label class="type-option">
                                <input type="radio" name="PayType" value="50000">
                                <span>Rp. 50,000</span>
                            </label>

                            <label class="type-option">
                                <input type="radio" name="PayType" value="25000">
                                <span>Rp. 25,000</span>
                            </label>

                            <label class="type-option">
                                <input type="radio" name="PayType" value="100000">
                                <span>Rp. 100,000</span>
                            </label>

                            <label class="type-option">
                                <input type="radio" name="PayType" value="Lainnya">
                                <span>Other</span>
                            </label>
                       </div>
                   </div>                   
                    @* END CASH ==================================>*@

                    @* SELAIN CASH ===============================>*@
                     <div id="OtherMethod" style="display:none;">
                        <div class="form-floating form-floating-outline mb-3 mt-5">
                            @Html.DropDownList("OtherMethoddropDown",ViewData["OtherMethod"] as SelectList,new { @class = "form-control form-control-sm select2",@id = "OtherMethodSelect" })
                            <label class="PayMethodLabel">Type</label>
                        </div>
                    </div>

                    @* END Selain CASH ===========================>*@

                </div>

                <div class="mb-4">
                    <p class="fw-bold mb-2">Total Payment</p>
                    <input type="text" class="mt-2 form-control GrandTotalPayment" maxlength="15" onkeyup="InputNumber(this); FormatGrandTotal(this);" readonly   />

                </div>
                <!-- Button -->
                <div class="text-center">
                    <button type="button" class="btn btn-success btn-sm w-50 text-center" onclick="ProcessPayment()">
                        <i class="ri ri-refund-2-line me-1 icon-18px"></i>
                        Process
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ModalMobile" role="dialog" aria-labelledby="defferedAmmortizeLabel" aria-hidden="true">
