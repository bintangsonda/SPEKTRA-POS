                language: {
                    paginate: {
                        next: '<i class="icon-base ri ri-arrow-right-s-line scaleX-n1-rtl icon-22px"></i>',
                        previous: '<i class="icon-base ri ri-arrow-left-s-line scaleX-n1-rtl icon-22px"></i>',
                        first: '<i class="icon-base ri ri-skip-back-mini-line scaleX-n1-rtl icon-22px"></i>',
                        last: '<i class="icon-base ri ri-skip-forward-mini-line scaleX-n1-rtl icon-22px"></i>'
                    }
                },
                
                
            });
        }

        $("#btnSave").click(function () {
            //Add By Renaldi 18 October 2025
            var $form = $('#formCreateEdit');
            if (!$form.valid()) {
                e.preventDefault();
                return false;
            }
            //End Add

            const formAction = $("#FormAction").val();
            const confirmText = formAction == 1
                ? "Are you sure you want to save this data?"
                : "Are you sure you want to edit User ID: " + $("#txtUserID").val() + "?";

            SweetAlertConfirm("Confirmation", confirmText, function () {
                const url = formAction == 1
                    ? '@Url.Action("Create", "User", new { Area = "Maintenance" })'
                    : '@Url.Action("Edit", "User", new { Area = "Maintenance" })';

                if (formAction != 1) $('#txtUserID').prop('disabled', false);

                SweetAlertLoading("Processing your request...");

                $.ajax({
                    type: "POST",
                    url: url,
                    processData: false,
                    data: $("#formCreateEdit").serialize(),
                    success: function () {
                        SweetAlertClose();
                        SweetAlertSuccess("Success", formAction == 1 ? "Data has been saved." : "Data has been updated.");
                        getData();
                        $('.btn-close[data-bs-dismiss="offcanvas"]').trigger('click');
                    },
                    error: function () {
                        SweetAlertClose();
                        SweetAlertError("Error", "Something went wrong while saving data.");
                    }
                });
            });
        });

        $('.datatables-users').on('click', '.delete-record', function () {
            const id = $(this).data('id'); // ambil id dari data-id di tombol

            SweetAlertConfirm(
                'Delete Confirmation',
                'Are you sure you want to delete this user?',
                function () {
                    // ✅ Eksekusi AJAX hanya kalau user klik "Yes"
                    SweetAlertLoading('Deleting user...');

                    $.ajax({
                        type: 'POST',
                        url: '@Url.Action("Delete", "User", new { Area = "Maintenance" })',
                        data: { userCodeList: id },
                        success: function (respond) {
                            SweetAlertClose(); // tutup loading

                            if (respond === "User data has been delete successfull") {
                                SweetAlertSuccess('Deleted!', 'User has been deleted successfully.');
                                getData(); // refresh tabel
                            } else {
                                SweetAlertError('Failed!', 'Unable to delete user.');
                            }
                        },
                        error: function () {
                            SweetAlertClose();
                            SweetAlertError('Error!', 'Something went wrong while deleting user.');
                        }
                    });
                }
            );
        });

        $('.datatables-users').on('click', '.edit-record', function () {
            $("#FormAction").val("2");
            const id = $(this).data('id'); // Ambil UserID dari data-id tombol edit

            // 🔹 Reset form dulu sebelum diisi (biar bersih)
            $('#formCreateEdit')[0].reset();
            $('.select2').val(null).trigger('change');
            $('form#formCreateEdit .text-danger').text('');

            // 🔹 Tampilkan loading SweetAlert
            SweetAlertLoading('Loading user data...');

            // 🔹 Ambil data dari server
            $.ajax({
                type: 'GET',
                url: '@Url.Action("Edit", "User", new { Area = "Maintenance" })',
                data: { userid: id },
                success: function (data) {
                    SweetAlertClose(); // tutup loading

                    if (data) {
                        // 🔹 Isi semua field form berdasarkan data dari server
                        $('#txtUserID').val(data.UserID).prop('disabled', true);
                        $('#txtUserName').val(data.UserName);
                        $('#txtPassword').closest('.form-floating').hide();
                        $('#txtConfirmPassword').closest('.form-floating').hide();
                        $('#txtEmailAddress').val(data.EmailAddress);
                        $('#cboBranch').val(data.Branch.BranchCode).trigger('change');
                        $('#cboUserGroup').val(data.UserGroup.GroupCode).trigger('change');
                        $('#cboStatus').val(data.Status).trigger('change');
                        $('#FormAction').val('2');

                        // 🔹 Tampilkan offcanvas form edit
                        const offcanvas = new bootstrap.Offcanvas('#offcanvasAddUser');
                        offcanvas.show();
                    } else {
                        SweetAlertError('Not Found', 'User data could not be found.');
                    }
                },
                error: function () {
                    SweetAlertClose();
                    SweetAlertError('Error', 'Failed to load user data. Please try again.');
                }
            });
        });

        $('#btnAddNewUser').on('click', function () {
            // 🔹 Reset form sebelum buka offcanvas
            $('#formCreateEdit')[0].reset();
            $("#FormAction").val("1");
            $('#txtUserID').prop('disabled', false);
            $('#txtPassword').closest('.form-floating').show();
            $('#txtConfirmPassword').closest('.form-floating').show();

            // 🔹 Reset select2 biar kosong juga
            $('.select2').val(null).trigger('change');

            // 🔹 Reset validasi (kalau pakai jQuery Validate)
            $('form#formCreateEdit').validate().resetForm();

            // 🔹 (Opsional) Hilangkan error text
            $('form#formCreateEdit .text-danger').text('');

            // 🔹 (Opsional) Fokus ke field pertama
            $('#formCreateEdit input:first').focus();

            // 🔹 Buka offcanvas secara manual (jika tidak pakai data-bs-toggle di tombol)
            const offcanvasEl = document.getElementById('offcanvasAddUser');
            const bsOffcanvas = new bootstrap.Offcanvas(offcanvasEl);
            bsOffcanvas.show();
        })

        $("#cboBranchss").on("change", function () {
            getData();
        });

        function ViewLog(data) {

            if (data == "") {
                alert("Data did not have log!");
                return false;
            }
            else {

                $.ajax({
                    type: "GET",
                    url: '@Url.Action("Log", "AuditTrail", new { Area = "Maintenance" })',
                    data: {
                        MenuName: "MntUser",
                        key: data,
                    },
                    dataType: 'html',
                    success: function (result) {
                        $('#PartialSection').empty();
                        $("#PartialSection").html(result);
                        $("#modalTitle").html("Audit View");
                        $("#CreateEditForm").modal('show');

                    },
                    error: function (status) {
                        alert('');
                    }
                });
            }
        }
        
    </script>
}